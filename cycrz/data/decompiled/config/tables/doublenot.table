; Settings

min_bet=1
max_bet=0
confirm_threshold=1000:false
jokers=2
max_rides=0
color_payout=2
suit_payout=4

[suits]

; Required header — removing or renaming this will break the file.

hearts:red
diamonds:red
clubs:black
spades:black

; Sounds

bank_sound=double_or_nothing/bank.ogg
deal_sound=double_or_nothing/deal.ogg
draw_sound=double_or_nothing/draw(1,2).ogg
color_win_sound=double_or_nothing/color_win.ogg
suit_win_sound=double_or_nothing/suit_win.ogg
wrong_sound=double_or_nothing/lose.ogg
joker_sound=double_or_nothing/joker.ogg

; Messages

start_message=Your bet of %bet% %item% is on the table. Call a color or a suit.
win_message=The %card%, a %color% card. You called it, and your pot is now %pot% %item%. Call again or bank your earnings.
lose_message=The %card%, a %color% card. Your call was wrong, and you lost the pot of %pot% %item%.
joker_message=A joker! The house wins, and you lost the pot of %pot% %item%.
bank_message=You banked %pot% %item% after %calls%.
limit_message=The %card%, a %color% card. You reached the limit of %calls%, so your pot of %pot% %item% was banked for you.
