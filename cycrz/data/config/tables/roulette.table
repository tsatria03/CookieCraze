; Settings

min_bet=1
max_bet=0
confirm_threshold=1000:false
pocket_count=37
spin_base_ticks=50
spin_random_range=50
spin_base_delay=20
spin_growth=2

; Sounds

spin_sound=roulette/spin.ogg
land_sound=roulette/land.ogg
bet_sound=roulette/bet.ogg
win_sound=roulette/win.ogg
lose_sound=roulette/lose.ogg
break_sound=roulette/break.ogg

; Messages

single_win_message=The wheel landed on %number%, %color%. Your %winners% bet won %winnings% %item%.
single_lose_message=The wheel landed on %number%, %color%. Your bet did not hit, and you lost %amount% %item%.
multi_win_message=The wheel landed on %number%, %color%. Your winning bet types were %winners%, for a net gain of %amount% %item%.
multi_lose_message=The wheel landed on %number%, %color%. Your winning bet types were %winners%, but with %loss_count% losing bets it was a net loss of %amount% %item%.
multi_alllose_message=The wheel landed on %number%, %color%. None of your %loss_count% bets hit, and you lost %amount% %item%.
break_message=The wheel landed on %number%, %color%. Your winning and losing bets canceled out, so you broke even.

