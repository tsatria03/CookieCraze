[settings]

; Required header — removing or renaming this will break the file.

max_active=5
require_all=2
reroll_target=coins
reroll_base_cost=20
reroll_multiplier=1.01
reroll_warning=3
reroll_sound=questroll.ogg
reroll_message=Quest rerolled! Good luck with your new objective!

[quests]

; Required header — removing or renaming this will break the file.

; Required

reach_rank_endless:Reach rank %threshold%:rank:5:false:true:false:1:1.25:true:1:Reach rank %threshold% to complete this quest. Each time you finish it and prestige, it returns at a higher rank.

; Random pool

; Cookies baked
bake_cookies_endless:Bake %threshold% cookies:cookies_baked:100:false:false:false:1:1.25:true:1:Bake %threshold% cookies in total. Each time you finish it and prestige, it returns at a higher goal.

; Coins earned

earn_coins_endless:Earn %threshold%:coins_earned:500:false:false:false:1:1.25:true:1:Earn a total of %threshold%. Each time you finish it and prestige, it returns at a higher goal.

; Coins spent

spend_coins_endless:Spend %threshold%:coins_spent:500:false:false:false:1:1.25:true:1:Spend a total of %threshold%. Each time you finish it and prestige, it returns at a higher goal.

; Upgrades purchased

buy_singles_endless:Purchase %threshold% single upgrades:singles_purchased:5:false:false:false:1:1.25:true:1:Purchase %threshold% single upgrades from the singles shop. Each time you finish it and prestige, it returns at a higher goal.

