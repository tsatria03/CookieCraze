{
pool.play_stationary("sounds/store/error.ogg", false);
dlgmessage_return("This shop is locked. Please reach rank " + string(boostUnlockRank) + " to access it.");
shopmenu();
}
else
{
boost_buy_menu();
shopmenu();
}
}
if(stm=="slm")
{
sell_cookies_menu();
}
if(stm=="back")
{
pool.destroy_sound(alertslot);
pool.destroy_sound(storslot);
storambpool.destroy_sound(storambslot);
stormuspool.destroy_sound(stortrackslot);
speak("You're now exiting the cookie store.");
dlgplay("sounds/store/door_close.ogg");
ambpool.destroy_sound(ambslot);
muspool.destroy_sound(mustrackslot);
ambslot=ambpool.play_stationary_extended("sounds/ambience/"+ambtype+".ogg", true,0,0,ambvolume,ambpitch,false);
mustrackslot=muspool.play_stationary_extended("sounds/ambience/"+mustype+".ogg", true,0,0,musvolume,muspitch,false);
form.reset();
clickergame();
}
}
void lottery_buy_menu()
{
    lottery_ticket_category[] visibleCats;
    for (uint i = 0; i < loadedTicketCategories.length(); i++)
    {
        lottery_ticket_category@ cat = loadedTicketCategories[i];
        if (cat.hidden && rank < cat.min_rank) continue;
        bool hasTickets = false;
        for (uint j = 0; j < loadedTickets.length(); j++)
        {
            if (loadedTickets[j].category_id != cat.id) continue;
            if (loadedTickets[j].hidden && rank < loadedTickets[j].min_rank) continue;
            hasTickets = true;
            break;
        }
        if (!hasTickets) continue;
        visibleCats.insert_last(cat);
    }
    if (visibleCats.length() == 0)
    {
        dlg_buffer("No ticket categories are available yet.");
        return;
    }
    string lottery_last_cat_id = "";
    string lottery_last_ticket_id = "";
    while (true)
    {
        setupmenu(false);
        for (uint i = 0; i < visibleCats.length(); i++)
        {
            bool locked = (rank < visibleCats[i].min_rank);
            if (locked)
            {
                if (visibleCats[i].hidden || !show_locked_shops) continue;
                string label = visibleCats[i].name + ". Unlocked at rank " + string(visibleCats[i].min_rank) + ".";
                if (visibleCats[i].description != "") label += " Description: " + visibleCats[i].description;
                m.add_item(label, "locked" + string(i));
            }
            else
            {
                int totalTickets = 0;
                int affordableTickets = 0;
                for (uint j = 0; j < loadedTickets.length(); j++)
                {
                    if (loadedTickets[j].category_id != visibleCats[i].id) continue;
                    if (loadedTickets[j].hidden && rank < loadedTickets[j].min_rank) continue;
                    totalTickets++;
                    if (rank < loadedTickets[j].min_rank) continue;
                    if (lotteryMaxTickets > 0 && loadedTickets[j].owned >= lotteryMaxTickets) continue;
                    double cost = get_ticket_current_cost(loadedTickets[j]);
                    if (coins >= cost) affordableTickets++;
                }
                string itemWord = (totalTickets == 1) ? "ticket" : "tickets";
                string label = visibleCats[i].name + ". Contains " + string(affordableTickets) + " out of " + string(totalTickets) + " purchasable " + itemWord + ".";
                if (visibleCats[i].description != "") label += " Description: " + visibleCats[i].description;
                m.add_item(label, "cat" + string(i));
            }
        }
        m.add_item("Back", "back");
        m.intro_text = "Tickets menu. Please choose a category to browse.";
        int start = 0;
        if (lottery_last_cat_id != "")
        {
            int found = m.find_item_by_id(lottery_last_cat_id);
            if (found != -1) start = found;
        }
        int res = m.run(start, true);
        if (res == -1) return;
        string sel = m.get_item_id(res);
        if (sel == "back") return;
        lottery_last_cat_id = sel;
        if (sel.substr(0, 6) == "locked")
        {
            int idx = string_to_int(sel.substr(6));
            pool.play_stationary("sounds/store/error.ogg", false);
            dlgmessage_return("This category is locked. You need to reach rank " + string(visibleCats[idx].min_rank) + " to access it.");
            continue;
        }
        int catIndex = string_to_int(sel.substr(3));
        lottery_ticket_category@ cat = visibleCats[catIndex];
        int[] catTicketIndices;
        for (uint i = 0; i < loadedTickets.length(); i++)
        {
            if (loadedTickets[i].category_id != cat.id) continue;
            if (loadedTickets[i].hidden && rank < loadedTickets[i].min_rank) continue;
            catTicketIndices.insert_last(int(i));
        }
        while (true)
        {
            setupmenu(false);
            for (uint i = 0; i < catTicketIndices.length(); i++)
            {
                lottery_ticket_item@ t = loadedTickets[catTicketIndices[i]];
                bool locked = (rank < t.min_rank);
                if (locked && !show_locked_shops) continue;
                double cost = get_ticket_current_cost(@t);
                string label = t.name + ", costs " + convert_to_currency(cost) + ".";
                if (locked)
                {
                    label += " Unlocked at rank " + string(t.min_rank) + ".";
                }
                else if (lotteryMaxTickets > 0 && t.owned >= lotteryMaxTickets)
                {
                    label += " Inventory full.";
                }
                else
                {
                    double canBuy = get_ticket_max_buyable(@t);
                    label += " You can buy " + format_number(canBuy) + ".";
                }
                if (t.description != "") label += " Description: " + t.description;
                m.add_item(label, "ticket" + string(i));
            }
            m.add_item("Back", "back2");
            m.intro_text = cat.name + ".";
            int tstart = 0;
            if (lottery_last_ticket_id != "")
            {
                int found = m.find_item_by_id(lottery_last_ticket_id);
                if (found != -1) tstart = found;
            }
            int tres = m.run(tstart, true);
            if (tres == -1) break;
            string tsel = m.get_item_id(tres);
            lottery_last_ticket_id = tsel;
            if (tsel == "back2") break;
            int ticketCatIdx = string_to_int(tsel.substr(6));
            int ticketIdx = catTicketIndices[ticketCatIdx];
            if (ticketIdx == -1) continue;
            lottery_ticket_item@ ticket = loadedTickets[ticketIdx];
            if (rank < ticket.min_rank)
            {
                pool.play_stationary("sounds/store/error.ogg", false);
                dlgmessage_return("This ticket is locked. You need to reach rank " + string(ticket.min_rank) + " to buy it.");
                continue;
            }
            if (lotteryMaxTickets > 0 && ticket.owned >= lotteryMaxTickets)
            {
                pool.play_stationary("sounds/store/error.ogg", false);
                dlgmessage_return("Your inventory is full. You can hold a maximum of " + format_number(lotteryMaxTickets) + ". Scratch some first!");
                continue;
            }
            double cost = get_ticket_current_cost(@ticket);
            double maxCanBuy = get_ticket_max_buyable(@ticket);
            vd.set_disallowed_chars("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ !@#$%^&*()[]{};:'\"\\|,.<>?/+-=`~_", false, "This character is not allowed.");
            string qInput = vd.input_box("", "How many " + ticket.name + "s would you like to buy? Press enter to buy the maximum amount.", string(maxCanBuy > 0 ? maxCanBuy : 1));
            double qty = string_to_number(qInput);
            if (qty <= 0)
            {
                pool.play_stationary("sounds/store/error.ogg", false);
                dlgmessage_return("Please enter a valid number to buy.");
                continue;
            }
            double totalCost = get_ticket_bulk_cost(@ticket, qty);
            if (coins < totalCost)
            {
                pool.play_stationary("sounds/store/error.ogg", false);
                dlgmessage_return("Error! You can't afford " + format_number(qty) + " " + ticket.name + (qty != 1 ? "s" : "") + "!");
                continue;
            }
            if (lotteryMaxTickets > 0 && ticket.owned + qty > double(lotteryMaxTickets))
            {
                pool.play_stationary("sounds/store/error.ogg", false);
                dlgmessage_return("You can only hold " + count_text(lotteryMaxTickets, "ticket", "tickets") + " of this type. You currently have " + format_number(ticket.owned) + ".");
                continue;
            }
            coins -= totalCost;
            coins = floor(coins);
            stat_coins_spent += totalCost;
            loadedTickets[ticketIdx].owned += qty;
            stat_lottery_tickets_bought += qty;
            pool.play_stationary("sounds/store/buy" + random(1, 4) + ".ogg", false);
            pool.play_stationary("sounds/store/order.ogg", false);
            string plural = (qty == 1) ? "" : "s";
            string ownedPlural = (loadedTickets[ticketIdx].owned == 1) ? "" : "s";
            dlgmessage_return("You bought " + format_number(qty) + " " + ticket.name + plural + " for " + convert_to_currency(totalCost) + ". You now have " + format_number(loadedTickets[ticketIdx].owned) + " " + ticket.name + ownedPlural + " in your inventory.");
        }
    }
}

/* The cookie store's boosts shop, modelled on the tickets shop: categories, then the boosts in one, then how many.
Each category is paid for in its own currency, and every copy you hold raises the next one's price. */
void boost_buy_menu()
{
    boost_category[] visibleCats;
    for (uint i = 0; i < loadedBoostCategories.length(); i++)
    {
        boost_category@ cat = loadedBoostCategories[i];
        if (cat.hidden && rank < cat.min_rank) continue;
        bool hasBoosts = false;
        for (uint j = 0; j < loadedBoosts.length(); j++)
        {
            if (loadedBoosts[j].category_id != cat.id) continue;
            if (loadedBoosts[j].hidden && rank < loadedBoosts[j].min_rank) continue;
            hasBoosts = true;
            break;
        }
        if (hasBoosts) visibleCats.insert_last(cat);
    }
    if (visibleCats.length() == 0)
    {
        dlg_buffer("No boost categories are available yet.");
        return;
    }
    string last_cat_id = "";
    string last_boost_id = "";
    while (true)
    {
        setupmenu(false);
        for (uint i = 0; i < visibleCats.length(); i++)
        {
            if (rank < visibleCats[i].min_rank)
            {
                if (visibleCats[i].hidden || !show_locked_shops) continue;
                string label = visibleCats[i].name + ". Unlocked at rank " + string(visibleCats[i].min_rank) + ".";
                if (visibleCats[i].description != "") label += " Description: " + visibleCats[i].description;
                m.add_item(label, "locked" + string(i));
                continue;
            }
            int total = 0;
            int affordable = 0;
            for (uint j = 0; j < loadedBoosts.length(); j++)
            {
                if (loadedBoosts[j].category_id != visibleCats[i].id) continue;
                if (loadedBoosts[j].hidden && rank < loadedBoosts[j].min_rank) continue;
                total++;
                if (rank < loadedBoosts[j].min_rank) continue;
                if (get_boost_max_buyable(loadedBoosts[j]) >= 1) affordable++;
            }
            string label = visibleCats[i].name + ". Contains " + string(affordable) + " out of " + string(total) + " purchasable " + (total == 1 ? "boost" : "boosts") + ".";
            if (visibleCats[i].description != "") label += " Description: " + visibleCats[i].description;
            m.add_item(label, "cat" + string(i));
        }
        m.add_item("Back", "back");
        m.intro_text = "Boosts menu. Please choose a category to browse.";
        int start = 0;
        if (last_cat_id != "")
        {
            int found = m.find_item_by_id(last_cat_id);
            if (found != -1) start = found;
        }
        int res = m.run(start, true);
        if (res == -1) return;
        string sel = m.get_item_id(res);
        if (sel == "back") return;
        last_cat_id = sel;
        if (sel.substr(0, 6) == "locked")
        {
            int lidx = string_to_int(sel.substr(6));
            pool.play_stationary("sounds/store/error.ogg", false);
            dlgmessage_return("This category is locked. You need to reach rank " + string(visibleCats[lidx].min_rank) + " to access it.");
            continue;
        }
        boost_category@ cat = visibleCats[string_to_int(sel.substr(3))];
        int[] catBoosts;
        for (uint i = 0; i < loadedBoosts.length(); i++)
        {
            if (loadedBoosts[i].category_id != cat.id) continue;
            if (loadedBoosts[i].hidden && rank < loadedBoosts[i].min_rank) continue;
            catBoosts.insert_last(int(i));
        }
        while (true)
        {
            setupmenu(false);
            for (uint i = 0; i < catBoosts.length(); i++)
            {
                boost_item@ b = loadedBoosts[catBoosts[i]];
                bool locked = (rank < b.min_rank);
                if (locked && !show_locked_shops) continue;
                string label = b.name + ", costs " + boost_price_text(b, get_boost_current_cost(b)) + ".";
                if (locked)
                    label += " Unlocked at rank " + string(b.min_rank) + ".";
                else if (boostMaxHold > 0 && b.owned >= boostMaxHold)
                    label += " Inventory full.";
                else
                    label += " You can buy " + format_number(get_boost_max_buyable(b)) + ".";
                label += " Description: " + boost_description(b);
                m.add_item(label, "boost" + string(i));
            }
            m.add_item("Back", "back2");
            m.intro_text = cat.name + ".";
            int bstart = 0;
            if (last_boost_id != "")
            {
                int found = m.find_item_by_id(last_boost_id);
                if (found != -1) bstart = found;
            }
            int bres = m.run(bstart, true);
            if (bres == -1) break;
            string bsel = m.get_item_id(bres);
            last_boost_id = bsel;
            if (bsel == "back2") break;
            int boostIdx = catBoosts[string_to_int(bsel.substr(5))];
            boost_item@ boost = loadedBoosts[boostIdx];
            if (rank < boost.min_rank)
            {
                pool.play_stationary("sounds/store/error.ogg", false);
                dlgmessage_return("This boost is locked. You need to reach rank " + string(boost.min_rank) + " to buy it.");
                continue;
            }
            if (boostMaxHold > 0 && boost.owned >= boostMaxHold)
            {
                pool.play_stationary("sounds/store/error.ogg", false);
                dlgmessage_return("Your inventory is full. You can hold a maximum of " + format_number(boostMaxHold) + " of each boost. Use some first!");
                continue;
            }
            double maxCanBuy = get_boost_max_buyable(boost);
            vd.set_disallowed_chars("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ !@#$%^&*()[]{};:'\"\\|,.<>?/+-=`~_", false, "This character is not allowed.");
            string qInput = vd.input_box("", "How many " + boost.name + " boosts would you like to buy? Press enter to buy the maximum amount.", string(maxCanBuy > 0 ? maxCanBuy : 1));
            double qty = floor(string_to_number(qInput));
            if (qty <= 0)
            {
                pool.play_stationary("sounds/store/error.ogg", false);
                dlgmessage_return("Please enter a valid number to buy.");
                continue;
            }
            if (boostMaxHold > 0 && boost.owned + qty > double(boostMaxHold))
            {
                pool.play_stationary("sounds/store/error.ogg", false);
                dlgmessage_return("You can only hold " + format_number(boostMaxHold) + " of each boost. You currently have " + format_number(boost.owned) + ".");
                continue;
            }
            double totalCost = get_boost_bulk_cost(boost, qty);
            if (boost_balance(boost) < totalCost)
            {
                pool.play_stationary("sounds/store/error.ogg", false);
                dlgmessage_return("Error! You can't afford " + format_number(qty) + " " + boost.name + (qty == 1 ? " boost" : " boosts") + "!");
                continue;
            }
            if (boost_costs_money(boost))
            {
                coins = floor(safe_cap(coins - totalCost));
                stat_coins_spent += totalCost;
            }
            else
                cookies = floor(safe_cap(cookies - totalCost));
            loadedBoosts[boostIdx].owned += qty;
            stat_boosts_bought += qty;
            pool.play_stationary("sounds/store/buy" + random(1, 4) + ".ogg", false);
            pool.play_stationary("sounds/store/order.ogg", false);
            double nowOwned = loadedBoosts[boostIdx].owned;
            dlgmessage_return("You bought " + format_number(qty) + " " + boost.name + (qty == 1 ? " boost" : " boosts") + " for " + boost_price_text(boost, totalCost) + ". You now have " + format_number(nowOwned) + " " + boost.name + (nowOwned == 1 ? " boost" : " boosts") + " in your inventory.");
        }
    }
}

double prestige_endless_count(string item_id)
{
    double c = 0;
    if (prestigeEndlessCounts.exists(item_id))
        prestigeEndlessCounts.get(item_id, c);
    return c;
}
// Endless (infinite) items are never owned-out; one-time items are owned once bought.
bool prestige_item_owned(prestige_store_item@ item)
{
    if (item.infinite) return false;
    for (uint k = 0; k < prestigePurchased.length(); k++)
        if (prestigePurchased[k] == item.item_id) return true;
    return false;
}
// Unlocked by prestige level, and (for endless) only after every standard upgrade is bought.
bool prestige_item_unlocked(prestige_store_item@ item, bool standardCleared)
{
    if (prestigeLevel < item.min_level) return false;
    if (item.infinite && !standardCleared) return false;
    return true;
}
bool prestige_menu_is_endless(prestige_store_item[]@ items, string menuName)
{
    for (uint i = 0; i < items.length(); i++)
        if (items[i].menu == menuName && items[i].infinite) return true;
    return false;
}
// Point cost (rounded up to a whole point) to buy `qty` copies of an endless item starting at `fromCount`.
double prestige_endless_cost(prestige_store_item@ item, double fromCount, double qty)
{
    double raw = calc_total_upgrade_cost(fromCount, qty, item.cost, item.cost_multiplier);
    double whole = floor(raw);
    if (raw > whole) whole += 1;
    return whole;
}
/* Where a prestige store menu opens: on the item you chose last time, the way the cookie store's shops do. A standard
upgrade leaves the list once bought, and a category once it is empty, so when the remembered item is gone the menu opens
at the place it had instead, on whatever took its place, never past the last item before back. */
int prestige_menu_start(string lastId, int lastPos)
{
    if (lastId == "") return 0;
    int found = m.find_item_by_id(lastId);
    if (found != -1) return found;
    int lastItem = int(m.items.length()) - 2;
    if (lastItem < 0) return 0;
    if (lastPos > lastItem) return lastItem;
    return (lastPos < 0) ? 0 : lastPos;
}

void prestige_store_menu()
{
    prestige_store_item[] items;
    prestige_menu_def[] menus;
    parse_prestige_store("stores/prestige.store", items, menus);
    if (items.length() == 0)
    {
        dlgmessage_return("Error! Could not load the prestige store items.");
        questsmenu();
        return;
    }
    bool standardCleared = standard_prestige_cleared();
    bool anyLeft = false;
    for (uint i = 0; i < items.length(); i++)
    {
        if (!prestige_item_unlocked(items[i], standardCleared)) continue;
        if (!prestige_item_owned(items[i])) { anyLeft = true; break; }
    }
    if (!anyLeft)
    {
        dlgmessage_return("You have purchased every available upgrade in the store. Keep prestiging to unlock more.");
        questsmenu();
        return;
    }
    setupmenu2();
    for (uint i = 0; i < menus.length(); i++)
    {
        bool menuEndless = prestige_menu_is_endless(items, menus[i].name);
        bool menuLocked = (menus[i].min_level > 0 && prestigeLevel < menus[i].min_level) || (menuEndless && !standardCleared);
        if (menuLocked)
        {
            if (menus[i].hidden || !show_locked_shops) continue;
            string reason;
            if (prestigeLevel < menus[i].min_level)
                reason = "Unlocked at prestige level " + string(menus[i].min_level) + ".";
            else
                reason = "Unlocked once you have purchased every standard upgrade.";
            string label = menus[i].name + ". " + reason;
            if (menus[i].description != "")
                label += " Description: " + menus[i].description;
            m.add_item(label, "locked" + string(i));
        }
        else
        {
            int totalItems = 0;
            int affordableItems = 0;
            for (uint j = 0; j < items.length(); j++)
            {
                if (items[j].menu != menus[i].name) continue;
                if (items[j].hidden && !prestige_item_unlocked(items[j], standardCleared)) continue;
                if (prestige_item_owned(items[j])) continue;
                totalItems++;
                if (!prestige_item_unlocked(items[j], standardCleared)) continue;
                double nextCost = items[j].infinite ? prestige_endless_cost(items[j], prestige_endless_count(items[j].item_id), 1) : double(items[j].cost);
                if (double(prestige_points) >= nextCost)
                    affordableItems++;
            }
            // A category with nothing left to buy, such as a fully bought standard one, is left out of the list.
            if (totalItems == 0) continue;
            string itemWord = (totalItems == 1) ? "item" : "items";
            string label = menus[i].name + ". Contains " + string(affordableItems) + " out of " + string(totalItems) + " purchasable " + itemWord + ".";
            if (menus[i].description != "")
                label += " Description: " + menus[i].description;
            m.add_item(label, "cat" + string(i));
        }
    }
    m.add_item("back", "back");
    m.intro_text = "Prestige store. Please choose a category to browse.";
    int mres = m.run(prestige_menu_start(prestige_last_cat_id, prestige_last_cat_pos), true);
    string sel = m.get_item_id(mres);
    if (mres != -1) { prestige_last_cat_id = sel; prestige_last_cat_pos = mres - 1; }
    if (mres == -1 || sel == "back")
    {
        prestige_last_cat_id = "";
        prestige_last_cat_pos = 0;
        questsmenu();
        return;
    }
    if (sel.substr(0, 6) == "locked")
    {
        int idx = string_to_int(sel.substr(6));
        pool.play_stationary("sounds/store/error.ogg", false);
        string reason;
        if (prestigeLevel < menus[idx].min_level)
            reason = "You need to reach prestige level " + string(menus[idx].min_level) + " to access it.";
        else
            reason = "You need to purchase every standard upgrade first.";
        dlgmessage_return("This category is locked. " + reason);
        prestige_store_menu();
        return;
    }
    int catIndex = string_to_int(sel.substr(3));
    string chosenMenu = menus[catIndex].name;
    prestige_store_category_menu(items, chosenMenu);
}
void prestige_store_category_menu(prestige_store_item[]@ items, string chosenMenu)
{
    bool standardCleared = standard_prestige_cleared();
    bool anyAvailable = false;
    for (uint i = 0; i < items.length(); i++)
    {
        if (items[i].menu != chosenMenu) continue;
        if (!prestige_item_owned(items[i])) { anyAvailable = true; break; }
    }
    if (!anyAvailable)
    {
        pool.play_stationary("sounds/store/error.ogg", false);
        dlgmessage_return("You have purchased all available upgrades in this category.");
        prestige_store_menu();
        return;
    }
    setupmenu2();
    for (uint i = 0; i < items.length(); i++)
    {
        if (items[i].menu != chosenMenu) continue;
        if (prestige_item_owned(items[i])) continue;
        if (!prestige_item_unlocked(items[i], standardCleared))
        {
            if (items[i].hidden || !show_locked_shops) continue;
            string reason;
            if (prestigeLevel < items[i].min_level)
                reason = "Unlocked at prestige level " + string(items[i].min_level) + ".";
            else
                reason = "Unlocked once you have purchased every standard upgrade.";
            m.add_item(prestige_item_name(items[i].item_id) + ". " + reason + " Description: " + items[i].description, "locked" + string(i));
            continue;
        }
        if (items[i].infinite)
        {
            double owned = prestige_endless_count(items[i].item_id);
            double nextCost = prestige_endless_cost(items[i], owned, 1);
            double maxbuy = calc_max_buyable(double(prestige_points), owned, items[i].cost, items[i].cost_multiplier);
            string pointWord = (nextCost == 1) ? "point" : "points";
            m.add_item(prestige_item_name(items[i].item_id) + ", costs " + format_number(nextCost) + " prestige " + pointWord + ". You can buy " + format_number(maxbuy) + ". Description: " + items[i].description, "item" + string(i));
        }
        else
        {
            string pointWord = (items[i].cost == 1) ? "point" : "points";
            m.add_item(prestige_item_name(items[i].item_id) + ", costs " + string(items[i].cost) + " prestige " + pointWord + ". Description: " + items[i].description, "item" + string(i));
        }
    }
    m.add_item("back", "back");
    m.intro_text = chosenMenu + ".";
    int mres = m.run(prestige_menu_start(prestige_last_item_id, prestige_last_item_pos), true);
    string sel = m.get_item_id(mres);
    if (mres != -1) { prestige_last_item_id = sel; prestige_last_item_pos = mres - 1; }
    if (mres == -1 || sel == "back")
    {
        prestige_last_item_id = "";
        prestige_last_item_pos = 0;
        prestige_store_menu();
        return;
    }
    for (uint i = 0; i < items.length(); i++)
    {
        if (sel == "locked" + string(i))
        {
            pool.play_stationary("sounds/store/error.ogg", false);
            string reason;
            if (prestigeLevel < items[i].min_level)
                reason = "You need to reach prestige level " + string(items[i].min_level) + " to purchase it.";
            else
                reason = "You need to purchase every standard upgrade first.";
            dlgmessage_return("This item is locked. " + reason);
            prestige_store_category_menu(items, chosenMenu);
            return;
        }
        if (sel != "item" + string(i)) continue;
        if (items[i].infinite)
        {
            double owned = prestige_endless_count(items[i].item_id);
            double maxAffordable = calc_max_buyable(double(prestige_points), owned, items[i].cost, items[i].cost_multiplier);
            if (maxAffordable >= 1 && prestige_endless_cost(items[i], owned, maxAffordable) > double(prestige_points))
                maxAffordable -= 1;
            if (maxAffordable < 1)
            {
                pool.play_stationary("sounds/store/error.ogg", false);
                double one = prestige_endless_cost(items[i], owned, 1);
                string oneWord = (one == 1) ? "point" : "points";
                dlgmessage_return("Error! You can't afford another " + prestige_item_name(items[i].item_id) + ". The next one costs " + format_number(one) + " prestige " + oneWord + ".");
                prestige_store_category_menu(items, chosenMenu);
                return;
            }
            vd.set_disallowed_chars("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ !@#$%^&*()[]{};:'\"\\|,.<>?/+-=`~_", false, "This character is not allowed.");
            string qInput = vd.input_box("", "How many would you like to buy? Press enter to buy the maximum amount.", string(round(maxAffordable, 0)));
            if (qInput == "")
            {
                prestige_store_category_menu(items, chosenMenu);
                return;
            }
            double qty = floor(string_to_number(qInput));
            if (qty < 1)
            {
                pool.play_stationary("sounds/store/error.ogg", false);
                dlgmessage_return("Error! Please enter a valid number to buy!");
                prestige_store_category_menu(items, chosenMenu);
                return;
            }
            if (qty > maxAffordable) qty = maxAffordable;
            double totalCost = prestige_endless_cost(items[i], owned, qty);
            while (qty > 1 && totalCost > double(prestige_points))
            {
                qty -= 1;
                totalCost = prestige_endless_cost(items[i], owned, qty);
            }
            prestige_points -= totalCost;
            prestigeEndlessCounts.set(items[i].item_id, owned + qty);
            apply_all_prestige_store_upgrades();
            pool.play_stationary("sounds/store/buy" + random(1, 4) + ".ogg", false);
            pool.play_stationary("sounds/store/order.ogg", false);
            double newNext = prestige_endless_cost(items[i], owned + qty, 1);
            string boughtWord = (totalCost == 1) ? "point" : "points";
            string nextWord = (newNext == 1) ? "point" : "points";
            dlgmessage_return("Purchase successful! You bought " + format_number(qty) + " " + prestige_item_name(items[i].item_id) + " for " + format_number(totalCost) + " prestige " + boughtWord + ". Next upgrade will cost " + format_number(newNext) + " prestige " + nextWord + ".");
            prestige_store_category_menu(items, chosenMenu);
            return;
        }
        if (prestige_points < items[i].cost)
        {
            pool.play_stationary("sounds/store/error.ogg", false);
            double shortage = items[i].cost - prestige_points;
            string shortWord = (shortage == 1) ? "point" : "points";
            dlgmessage_return("Error! You can't afford this upgrade. You need " + format_number(shortage) + " more prestige " + shortWord + ".");
            prestige_store_category_menu(items, chosenMenu);
            return;
        }
        prestige_points -= items[i].cost;
        prestigePurchased.insert_last(items[i].item_id);
        apply_prestige_store_upgrade(items[i].item_id);
        pool.play_stationary("sounds/store/buy" + random(1, 4) + ".ogg", false);
        pool.play_stationary("sounds/store/order.ogg", false);
        string pointWord = (items[i].cost == 1) ? "point" : "points";
        dlgmessage_return("Purchase successful! You bought " + prestige_item_name(items[i].item_id) + " for " + string(items[i].cost) + " prestige " + pointWord + ".");
        prestige_store_category_menu(items, chosenMenu);
        return;
    }
}
void buymenu()
{
    setupmenu2();
    m.add_item("bundles", "bundles");
    m.add_item("singles", "singles");
    m.add_item("back", "back");
    m.intro_text = "Upgrades menu. What would you like to browse?";
    int buy_start = 0;
    if (buymenu_last_id != "")
    {
        int found = m.find_item_by_id(buymenu_last_id);
        if (found != -1) buy_start = found;
    }
    int mres = m.run(buy_start, true);
    string sel = m.get_item_id(mres);
    if (mres == -1 || sel == "back")
    {
        buymenu_last_id = "";
        shopmenu();
        return;
    }
    buymenu_last_id = sel;
    if (sel == "singles")
        bakermenu();
    else if (sel == "bundles")
        bundlemenu();
}
void bakermenu()
{
    store_item[] items;
    store_menu[] menus;
    parse_store("stores/singles.store", items, menus);
    if (items.length() == 0)
    {
        dlgmessage_return("Error! Could not load the baking shop items.");
        shopmenu();
        return;
    }
    setupmenu2();
    for (uint i = 0; i < menus.length(); i++)
    {
        if (menus[i].min_rank > 0 && rank < menus[i].min_rank)
        {
            if (menus[i].hidden || !show_locked_shops) continue;
            string label = menus[i].name + ". Unlocked at rank " + string(menus[i].min_rank) + ".";
            if (menus[i].description != "")
                label += " Description: " + menus[i].description;
            m.add_item(label, "locked" + string(i));
        }
        else
        {
            int totalItems = 0;
            int affordableItems = 0;
            double menuBalance = (menus[i].currency == "cookies") ? cookies : coins;
            for (uint j = 0; j < items.length(); j++)
            {
                if (items[j].menu != menus[i].name) continue;
                totalItems++;
                if (items[j].min_rank > 0 && rank < items[j].min_rank) continue;
                double level = (items[j].target == 2) ? manulcookie_purchases : (items[j].target == 3) ? cookiespeed_purchases : autocookie_purchases;
                double cost = buy_item(level, discounted_base(items[j].base_cost, boost_cost_factor("singles_discount") * boost_cost_factor("store_discount"), level, items[j].cost_multiplier), items[j].cost_multiplier);
                if (menuBalance >= cost)
                    affordableItems++;
            }
            string itemWord = (totalItems == 1) ? "item" : "items";
            string label = menus[i].name + ". Uses " + (menus[i].currency == "cookies" ? "baked cookies" : "money") + ". Contains " + string(affordableItems) + " out of " + string(totalItems) + " purchasable " + itemWord + ".";
            if (menus[i].description != "")
                label += " Description: " + menus[i].description;
            m.add_item(label, "cat" + string(i));
        }
    }
    m.add_item("back", "back");
    m.intro_text = "Singles menu. Please choose a category to browse.";
    int start_pos = 0;
    if (baker_last_cat_id != "")
    {
        int found = m.find_item_by_id(baker_last_cat_id);
        if (found != -1)
            start_pos = found;
    }
    int mres = m.run(start_pos, true);
    string sel = m.get_item_id(mres);
    if (mres != -1)
        baker_last_cat_id = sel;
    if (mres == -1 || sel == "back")
    {
        baker_last_cat_id = "";
        shopmenu();
        return;
    }
    if (sel.substr(0, 6) == "locked")
    {
        int idx = string_to_int(sel.substr(6));
        pool.play_stationary("sounds/store/error.ogg", false);
        dlgmessage_return("This category is locked. You need to reach rank " + string(menus[idx].min_rank) + " to access it.");
        bakermenu();
        return;
    }
    int catIndex = string_to_int(sel.substr(3));
    string chosenMenu = menus[catIndex].name;
    string chosenCurrency = menus[catIndex].currency;
    bakercategorymenu(items, chosenMenu, chosenCurrency);
}
double max_useful_speed_copies(store_item@ it)
{
    /* How many copies of a speed upgrade still shave time before cookiespeed reaches COOKIESPEED_MAX. Returns 0 once maxed. */
    double room = COOKIESPEED_MAX - cookiespeed;
    if (room <= 0) return 0;
    double per = it.use_percent ? (cookiespeed * (it.amount / 100.0)) : it.amount;
    if (per <= 0) return 0;
    return ceil(room / per);
}
double cap_speed_maxbuy(store_item@ it, double maxbuy)
{
    /* Speed upgrades can't be bought past what fits under COOKIESPEED_MAX; other targets are unaffected. */
    if (it.target != 3) return maxbuy;
    double useful = max_useful_speed_copies(it);
    return (maxbuy < useful) ? maxbuy : useful;
}
void bakercategorymenu(store_item[]@ items, string chosenMenu, string chosenCurrency)
{
    while (true)
    {
    double balance = (chosenCurrency == "cookies") ? cookies : coins;
    setupmenu2();
    for (uint i = 0; i < items.length(); i++)
    {
        if (items[i].menu != chosenMenu) continue;
        if (items[i].min_rank > 0 && rank < items[i].min_rank)
        {
            if (items[i].hidden || !show_locked_shops) continue;
            m.add_item(store_item_name(items[i].item_type) + ". Unlocked at rank " + string(items[i].min_rank) + ". Description: " + items[i].description, "locked" + string(i));
            continue;
        }
        double level = (items[i].target == 2) ? manulcookie_purchases : (items[i].target == 3) ? cookiespeed_purchases : autocookie_purchases;
        double cost = buy_item(level, discounted_base(items[i].base_cost, boost_cost_factor("singles_discount") * boost_cost_factor("store_discount"), level, items[i].cost_multiplier), items[i].cost_multiplier);
        double maxbuy = cap_speed_maxbuy(items[i], calc_max_buyable(balance, level, discounted_base(items[i].base_cost, boost_cost_factor("singles_discount") * boost_cost_factor("store_discount"), level, items[i].cost_multiplier), items[i].cost_multiplier));
        string costStr = (chosenCurrency == "cookies") ? count_text(cost, "baked cookie", "baked cookies") : convert_to_currency(cost);
        m.add_item(store_item_name(items[i].item_type) + ", costs " + costStr + ". You can buy " + format_number(maxbuy) + ". Description: " + items[i].description, "item" + string(i));
    }
    bool anyAffordable = false;
    for (uint i = 0; i < items.length(); i++)
    {
        if (items[i].menu != chosenMenu) continue;
        if (items[i].min_rank > 0 && rank < items[i].min_rank) continue;
        double level = (items[i].target == 2) ? manulcookie_purchases : (items[i].target == 3) ? cookiespeed_purchases : autocookie_purchases;
        double maxbuy = cap_speed_maxbuy(items[i], calc_max_buyable(balance, level, discounted_base(items[i].base_cost, boost_cost_factor("singles_discount") * boost_cost_factor("store_discount"), level, items[i].cost_multiplier), items[i].cost_multiplier));
        if (maxbuy >= 1) { anyAffordable = true; break; }
    }
    if (anyAffordable)
        m.add_item("Buy all affordable items", "buyall");
    m.add_item("back", "back");
    m.intro_text = chosenMenu + ".";
    int start_pos = 0;
    if (baker_last_item_id != "")
    {
        int found = m.find_item_by_id(baker_last_item_id);
        if (found != -1)
            start_pos = found;
    }
    int mres = m.run(start_pos, true);
    string sel = m.get_item_id(mres);
    if (mres != -1)
        baker_last_item_id = sel;
    if (mres == -1 || sel == "back")
    {
        baker_last_item_id = "";
        bakermenu();
        return;
    }
    if (sel == "buyall")
    {
        double overallMax = 0;
        for (uint i = 0; i < items.length(); i++)
        {
            if (items[i].menu != chosenMenu) continue;
            if (items[i].min_rank > 0 && rank < items[i].min_rank) continue;
            double level = (items[i].target == 2) ? manulcookie_purchases : (items[i].target == 3) ? cookiespeed_purchases : autocookie_purchases;
            double maxbuy = cap_speed_maxbuy(items[i], calc_max_buyable(balance, level, discounted_base(items[i].base_cost, boost_cost_factor("singles_discount") * boost_cost_factor("store_discount"), level, items[i].cost_multiplier), items[i].cost_multiplier));
            if (maxbuy > overallMax) overallMax = maxbuy;
        }
        vd.set_disallowed_chars("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ !@#$%^&*()[]{};:'\"\\|,.<>?/+-=`~_", false, "This character is not allowed.");
        string bulkInput = vd.input_box("", "How many of each item would you like to buy? Press enter to buy the maximum amount.", string(round(overallMax, 0)));
        double bulkQuantity = string_to_number(bulkInput);
        if (bulkQuantity <= 0)
        {
            pool.destroy_sound(alertslot);
            pool.play_stationary("sounds/store/error.ogg", false);
            dlgmessage_return("Error! Please enter a valid number to buy!");
            continue;
        }
        double totalSpent = 0;
        double autoGained = 0, manulGained = 0, speedGained = 0;
        double autoPercentGained = 0, manulPercentGained = 0;
        for (uint i = 0; i < items.length(); i++)
        {
            if (items[i].menu != chosenMenu) continue;
            if (items[i].min_rank > 0 && rank < items[i].min_rank) continue;
            double level = (items[i].target == 2) ? manulcookie_purchases : (items[i].target == 3) ? cookiespeed_purchases : autocookie_purchases;
            double maxbuy = cap_speed_maxbuy(items[i], calc_max_buyable(balance, level, discounted_base(items[i].base_cost, boost_cost_factor("singles_discount") * boost_cost_factor("store_discount"), level, items[i].cost_multiplier), items[i].cost_multiplier));
            if (maxbuy < 1) continue;
            double quantity = (bulkQuantity < maxbuy) ? bulkQuantity : maxbuy;
            double totalCost = calc_total_upgrade_cost(level, quantity, discounted_base(items[i].base_cost, boost_cost_factor("singles_discount") * boost_cost_factor("store_discount"), level, items[i].cost_multiplier), items[i].cost_multiplier);
            if (chosenCurrency == "cookies") { cookies -= totalCost; } else { coins -= totalCost; stat_coins_spent += totalCost; }
            totalSpent = safe_cap(totalSpent + totalCost);
            if (items[i].target == 1)
            {
                if (items[i].use_percent)
                {
                    double gained = safe_cap((autocookie * (items[i].amount / 100.0)) * quantity);
                    autocookie += gained;
                    autoPercentGained = safe_cap(autoPercentGained + items[i].amount * quantity);
                }
                else
                {
                    autocookie += quantity * items[i].amount;
                    autoGained = safe_cap(autoGained + quantity * items[i].amount);
                }
                autocookie_purchases += quantity;
            }
            else if (items[i].target == 2)
            {
                if (items[i].use_percent)
                {
                    double gained = safe_cap((manulcookie * (items[i].amount / 100.0)) * quantity);
                    manulcookie += gained;
                    manulPercentGained = safe_cap(manulPercentGained + items[i].amount * quantity);
                }
                else
                {
                    manulcookie += quantity * items[i].amount;
                    manulGained = safe_cap(manulGained + quantity * items[i].amount);
                }
                manulcookie_purchases += quantity;
            }
            else if (items[i].target == 3)
            {
                if (items[i].use_percent)
                {
                    double applied = gain_cookiespeed(safe_cap((cookiespeed * (items[i].amount / 100.0)) * quantity));
                    speedGained = safe_cap(speedGained + applied);
                }
                else
                {
                    double applied = gain_cookiespeed(quantity * items[i].amount);
                    speedGained = safe_cap(speedGained + applied);
                }
                cookiespeed_purchases += quantity;
            }
        }
        if (totalSpent > 0)
        {
            string log = "";
            string[] logParts;
            if (autoGained > 0) logParts.insert_last(format_number(autoGained) + " auto " + (autoGained == 1 ? "cookie" : "cookies"));
            if (autoPercentGained > 0) logParts.insert_last(format_number(autoPercentGained) + "% auto cookies");
            if (manulGained > 0) logParts.insert_last(format_number(manulGained) + " manual " + (manulGained == 1 ? "cookie" : "cookies"));
            if (manulPercentGained > 0) logParts.insert_last(format_number(manulPercentGained) + "% manual cookies");
            if (speedGained > 0) logParts.insert_last(format_number(speedGained) + " ms of baking speed");
            log = join_spoken_list(logParts);
            if (log == "") log = "nothing new because your baking speed is already at its maximum";
            pool.play_stationary("sounds/store/buy" + random(1, 4) + ".ogg", false);
            pool.play_stationary("sounds/store/order.ogg", false);
            stat_singles_purchased++;
            string spentStr = (chosenCurrency == "cookies") ? count_text(totalSpent, "baked cookie", "baked cookies") : convert_to_currency(totalSpent);
            dlgmessage_return("Bulk purchase complete! You gained " + log + " for a total of " + spentStr + ".");
        }
        else
            speak("Nothing affordable to buy.");
        continue;
    }
    for (uint i = 0; i < items.length(); i++)
    {
        if (sel == "locked" + string(i))
        {
            pool.play_stationary("sounds/store/error.ogg", false);
            dlgmessage_return("This item is locked. You need to reach rank " + string(items[i].min_rank) + " to purchase it.");
            break;
        }
        if (sel != "item" + string(i)) continue;
        double level = (items[i].target == 2) ? manulcookie_purchases : (items[i].target == 3) ? cookiespeed_purchases : autocookie_purchases;
        double maxbuy = cap_speed_maxbuy(items[i], calc_max_buyable(balance, level, discounted_base(items[i].base_cost, boost_cost_factor("singles_discount") * boost_cost_factor("store_discount"), level, items[i].cost_multiplier), items[i].cost_multiplier));
        if (items[i].target == 3 && max_useful_speed_copies(items[i]) <= 0)
        {
            pool.play_stationary("sounds/store/error.ogg", false);
            dlgmessage_return("Your baking speed is already at its maximum.");
            break;
        }
        vd.set_disallowed_chars("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ !@#$%^&*()[]{};:'\"\\|,.<>?/+-=`~_", false, "This character is not allowed.");
        string promptName = string_replace(items[i].item_type, "_", " ", true);
        string promptPlural;
        if (promptName.length() > 0 && promptName.substr(promptName.length() - 1) == "y")
            promptPlural = promptName.substr(0, promptName.length() - 1) + "ies";
        else if (promptName.length() > 0 && promptName.substr(promptName.length() - 1) == "s")
            promptPlural = promptName;
        else
            promptPlural = promptName + "s";
        string input = vd.input_box("", "How many " + promptPlural + " would you like to buy? Press enter to buy the maximum amount.", string(round(maxbuy, 0)));
        double quantity = string_to_number(input);
        if (quantity <= 0)
        {
            pool.destroy_sound(alertslot);
            pool.play_stationary("sounds/store/error.ogg", false);
            dlgmessage_return("Error! Please enter a valid number to buy!");
            break;
        }
        if (items[i].target == 3)
        {
            double speedCap = max_useful_speed_copies(items[i]);
            if (quantity > speedCap) quantity = speedCap;
        }
        double totalCost = calc_total_upgrade_cost(level, quantity, discounted_base(items[i].base_cost, boost_cost_factor("singles_discount") * boost_cost_factor("store_discount"), level, items[i].cost_multiplier), items[i].cost_multiplier);
        if (balance >= totalCost)
        {
            if (chosenCurrency == "cookies") { cookies -= totalCost; } else { coins -= totalCost; stat_coins_spent += totalCost; }
            if (items[i].target == 1)
            {
                if (items[i].use_percent)
                    autocookie += (autocookie * (items[i].amount / 100.0)) * quantity;
                else
                    autocookie += quantity * items[i].amount;
                autocookie_purchases += quantity;
            }
            else if (items[i].target == 2)
            {
                if (items[i].use_percent)
                    manulcookie += (manulcookie * (items[i].amount / 100.0)) * quantity;
                else
                    manulcookie += quantity * items[i].amount;
                manulcookie_purchases += quantity;
            }
            else if (items[i].target == 3)
            {
                if (items[i].use_percent)
                    gain_cookiespeed(safe_cap((cookiespeed * (items[i].amount / 100.0)) * quantity));
                else
                    gain_cookiespeed(quantity * items[i].amount);
                cookiespeed_purchases += quantity;
            }
            double nextCost = buy_item(level + quantity, discounted_base(items[i].base_cost, boost_cost_factor("singles_discount") * boost_cost_factor("store_discount"), level, items[i].cost_multiplier), items[i].cost_multiplier);
            pool.play_stationary("sounds/store/buy" + random(1, 4) + ".ogg", false);
            pool.play_stationary("sounds/store/order.ogg", false);
            string itemName = string_replace(items[i].item_type, "_", " ", true);
            string itemWord;
            if (quantity == 1)
                itemWord = itemName;
            else if (itemName.length() > 0 && itemName.substr(itemName.length() - 1) == "y")
                itemWord = itemName.substr(0, itemName.length() - 1) + "ies";
            else
                itemWord = itemName + "s";
            stat_singles_purchased++;
            string costStr = (chosenCurrency == "cookies") ? count_text(totalCost, "baked cookie", "baked cookies") : convert_to_currency(totalCost);
            string nextStr = (chosenCurrency == "cookies") ? count_text(nextCost, "baked cookie", "baked cookies") : convert_to_currency(nextCost);
            dlgmessage_return("Purchase successful! You bought " + format_number(quantity) + " " + itemWord + " for " + costStr + ". Next upgrade will cost " + nextStr + ".");
        }
        else
        {
            pool.play_stationary("sounds/store/error.ogg", false);
            string errName = string_replace(items[i].item_type, "_", " ", true);
            string errWord;
            if (quantity == 1)
                errWord = errName;
            else if (errName.length() > 0 && errName.substr(errName.length() - 1) == "y")
                errWord = errName.substr(0, errName.length() - 1) + "ies";
            else if (errName.length() > 0 && errName.substr(errName.length() - 1) == "s")
                errWord = errName;
            else
                errWord = errName + "s";
            dlgmessage_return("Error! You can't afford " + format_number(quantity) + " " + errWord + "!");
        }
        break;
    }
    }
}
/* A bundle's speed entry only counts the copies that still fit under COOKIESPEED_MAX, the same limit the
singles shop uses, so a bundle's price, purchase, and speed purchase count never include speed you cannot use.
Other targets are unaffected. */
double bundle_entry_qty(store_item@ it, double qty)
{
    if (it.target != 3) return qty;
    double useful = max_useful_speed_copies(it);
    return (qty < useful) ? qty : useful;
}
/* How many copies of a bundle are still worth buying. Unlimited when it holds anything besides speed; a
speed only bundle stops once its speed no longer fits under COOKIESPEED_MAX, and returns 0 at the cap. */
double bundle_copy_limit(bundle_item@ bundle, store_item[]@ storeItems)
{
    double limit = 0;
    bool anyMatched = false;
    for (uint j = 0; j < bundle.entries.length(); j++)
    {
        for (uint k = 0; k < storeItems.length(); k++)
        {
            if (storeItems[k].item_type == bundle.entries[j].item_type)
            {
                anyMatched = true;
                if (storeItems[k].target != 3) return 1e308;
                double q = bundle.entries[j].quantity;
                if (q > 0)
                {
                    double c = ceil(max_useful_speed_copies(storeItems[k]) / q);
                    if (c > limit) limit = c;
                }
                break;
            }
        }
    }
    if (!anyMatched) return 1e308;
    return limit;
}
double calc_bundle_total_qty(bundle_item@ bundle, store_item[]@ storeItems, double copies)
{
    double total = 0;
    for (uint j = 0; j < bundle.entries.length(); j++)
    {
        for (uint k = 0; k < storeItems.length(); k++)
        {
            if (storeItems[k].item_type == bundle.entries[j].item_type)
            {
                double level = (storeItems[k].target == 2) ? manulcookie_purchases : (storeItems[k].target == 3) ? cookiespeed_purchases : autocookie_purchases;
                total = safe_cap(total + calc_total_upgrade_cost(level, bundle_entry_qty(storeItems[k], bundle.entries[j].quantity * copies), discounted_base(storeItems[k].base_cost, boost_cost_factor("bundles_discount") * boost_cost_factor("store_discount"), level, storeItems[k].cost_multiplier), storeItems[k].cost_multiplier));
                break;
            }
        }
    }
    return total;
}
double calc_bundle_total(bundle_item@ bundle, store_item[]@ storeItems)
{
    return calc_bundle_total_qty(bundle, storeItems, 1);
}
// Largest number of copies of a single bundle affordable for the given balance, accounting for the
// rising cost of its contents. Uses a bounded doubling then binary search over calc_bundle_total_qty
// (no per-copy loop), so it stays instant even when the true answer is astronomically large.
double max_affordable_bundle_copies(bundle_item@ bundle, store_item[]@ storeItems, double balance)
{
    double copyLimit = bundle_copy_limit(bundle, storeItems);
    if (copyLimit < 1) return 0;
    if (calc_bundle_total_qty(bundle, storeItems, 1) > balance) return 0;
    double found = max_affordable_bundle_copies_uncapped(bundle, storeItems, balance);
    return (found < copyLimit) ? found : copyLimit;
}
double max_affordable_bundle_copies_uncapped(bundle_item@ bundle, store_item[]@ storeItems, double balance)
{
    double hi = 1;
    while (hi < 1e307 && calc_bundle_total_qty(bundle, storeItems, hi * 2) <= balance)
        hi *= 2;
    if (hi >= 1e307) return 1e308;
    double low = hi, high = hi * 2;
    while (low < high)
    {
        double mid = floor((low + high + 1) / 2);
        if (calc_bundle_total_qty(bundle, storeItems, mid) <= balance)
            low = mid;
        else
            high = mid - 1;
    }
    return low;
}
// Cost of buying "copies" of every affordable bundle in a category, at current levels.
double calc_bundles_pass_cost(bundle_item[]@ bundles, string chosenMenu, store_item[]@ storeItems, double copies)
{
    double total = 0;
    for (uint i = 0; i < bundles.length(); i++)
    {
        if (bundles[i].menu != chosenMenu) continue;
        if (bundles[i].min_rank > 0 && rank < bundles[i].min_rank) continue;
        if (bundle_copy_limit(bundles[i], storeItems) < 1) continue;
        total = safe_cap(total + calc_bundle_total_qty(bundles[i], storeItems, copies));
    }
    return total;
}
// Scaling-aware default for "buy one of every affordable bundle": the largest N such that buying N of
// every affordable bundle fits the balance. Same bounded search approach as max_affordable_bundle_copies.
double max_affordable_bundle_passes(bundle_item[]@ bundles, string chosenMenu, store_item[]@ storeItems, double balance)
{
    if (calc_bundles_pass_cost(bundles, chosenMenu, storeItems, 1) > balance) return 0;
    double hi = 1;
    while (hi < 1e307 && calc_bundles_pass_cost(bundles, chosenMenu, storeItems, hi * 2) <= balance)
        hi *= 2;
    if (hi >= 1e307) return 1e308;
    double low = hi, high = hi * 2;
    while (low < high)
    {
        double mid = floor((low + high + 1) / 2);
        if (calc_bundles_pass_cost(bundles, chosenMenu, storeItems, mid) <= balance)
            low = mid;
        else
            high = mid - 1;
    }
    return low;
}
void bundlemenu()
{
    bundle_item[] bundles;
    bundle_menu[] menus;
    store_item[] storeItems;
    store_menu[] storeMenus;
    parse_bundles("stores/bundles.store", bundles, menus);
    parse_store("stores/singles.store", storeItems, storeMenus);
    setupmenu2();
    for (uint i = 0; i < menus.length(); i++)
    {
        if (menus[i].min_rank > 0 && rank < menus[i].min_rank)
        {
            if (menus[i].hidden || !show_locked_shops) continue;
            string label = menus[i].name + ". Unlocked at rank " + string(menus[i].min_rank) + ".";
            if (menus[i].description != "")
                label += " Description: " + menus[i].description;
            m.add_item(label, "locked" + string(i));
        }
        else
        {
            int totalBundles = 0;
            int affordableBundles = 0;
            for (uint j = 0; j < bundles.length(); j++)
            {
                if (bundles[j].menu != menus[i].name) continue;
                totalBundles++;
                if (bundles[j].min_rank > 0 && rank < bundles[j].min_rank) continue;
                if (bundle_copy_limit(bundles[j], storeItems) < 1) continue;
                double totalCost = calc_bundle_total(bundles[j], storeItems);
                double bundleMenuBalance = (menus[i].currency == "cookies") ? cookies : coins;
                if (bundleMenuBalance >= totalCost)
                    affordableBundles++;
            }
            string bundleWord = (totalBundles == 1) ? "bundle" : "bundles";
            string label = menus[i].name + ". Uses " + (menus[i].currency == "cookies" ? "baked cookies" : "money") + ". Contains " + string(affordableBundles) + " out of " + string(totalBundles) + " purchasable " + bundleWord + ".";
            if (menus[i].description != "")
                label += " Description: " + menus[i].description;
            m.add_item(label, "cat" + string(i));
        }
    }
    m.add_item("back", "back");
    m.intro_text = "Bundles menu. Please choose a category to browse.";
    int start_pos = 0;
    if (bundle_last_cat_id != "")
    {
        int found = m.find_item_by_id(bundle_last_cat_id);
        if (found != -1)
            start_pos = found;
    }
    int mres = m.run(start_pos, true);
    string sel = m.get_item_id(mres);
    if (mres != -1)
        bundle_last_cat_id = sel;
    if (mres == -1 || sel == "back")
    {
        bundle_last_cat_id = "";
        buymenu();
        return;
    }
    if (sel.substr(0, 6) == "locked")
    {
        int idx = string_to_int(sel.substr(6));
        pool.play_stationary("sounds/store/error.ogg", false);
        dlgmessage_return("This category is locked. You need to reach rank " + string(menus[idx].min_rank) + " to access it.");
        bundlemenu();
        return;
    }
    int catIndex = string_to_int(sel.substr(3));
    bundlecategorymenu(bundles, menus[catIndex].name, menus[catIndex].currency, storeItems);
}
void bundlecategorymenu(bundle_item[]@ bundles, string chosenMenu, string chosenCurrency, store_item[]@ storeItems)
{
    while (true)
    {
    double balance = (chosenCurrency == "cookies") ? cookies : coins;
    setupmenu2();
    for (uint i = 0; i < bundles.length(); i++)
    {
        if (bundles[i].menu != chosenMenu) continue;
        if (bundles[i].min_rank > 0 && rank < bundles[i].min_rank)
        {
            if (bundles[i].hidden || !show_locked_shops) continue;
            m.add_item(bundles[i].name + ". Unlocked at rank " + string(bundles[i].min_rank) + ". Description: " + bundles[i].description, "locked" + string(i));
            continue;
        }
        if (bundle_copy_limit(bundles[i], storeItems) < 1)
        {
            m.add_item(bundles[i].name + ". Your baking speed is already at its maximum. Description: " + bundles[i].description, "maxed" + string(i));
            continue;
        }
        double totalCost = calc_bundle_total(bundles[i], storeItems);
        double canAfford = max_affordable_bundle_copies(bundles[i], storeItems, balance);
        string costStr = (chosenCurrency == "cookies") ? count_text(totalCost, "baked cookie", "baked cookies") : convert_to_currency(totalCost);
        m.add_item(bundles[i].name + ". Costs " + costStr + ". You can buy " + format_number(canAfford) + ". Description: " + bundles[i].description, "bundle" + string(i));
    }
    bool anyBundleAffordable = false;
    for (uint i = 0; i < bundles.length(); i++)
    {
        if (bundles[i].menu != chosenMenu) continue;
        if (bundles[i].min_rank > 0 && rank < bundles[i].min_rank) continue;
        if (bundle_copy_limit(bundles[i], storeItems) < 1) continue;
        double totalCost = calc_bundle_total(bundles[i], storeItems);
        if (balance >= totalCost) { anyBundleAffordable = true; break; }
    }
    if (anyBundleAffordable)
        m.add_item("Buy one of every affordable bundle", "buyallbundles");
    m.add_item("back", "back");
    m.intro_text = chosenMenu + ".";
    int start_pos = 0;
    if (bundle_last_item_id != "")
    {
        int found = m.find_item_by_id(bundle_last_item_id);
        if (found != -1)
            start_pos = found;
    }
    int mres = m.run(start_pos, true);
    string sel = m.get_item_id(mres);
    if (mres != -1)
        bundle_last_item_id = sel;
    if (mres == -1 || sel == "back")
    {
        bundle_last_item_id = "";
        bundlemenu();
        return;
    }
    if (sel == "buyallbundles")
    {
        double passDefault = max_affordable_bundle_passes(bundles, chosenMenu, storeItems, balance);
        if (passDefault < 1) passDefault = 1;
        vd.set_disallowed_chars("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ !@#$%^&*()[]{};:'\"\\|,.<>?/+-=`~_", false, "This character is not allowed.");
        string qInput = vd.input_box("", "How many of each affordable bundle would you like to buy? Press enter to buy the maximum amount.", string(round(passDefault, 0)));
        if (qInput == "") { continue; }
        double passes = string_to_number(qInput);
        if (passes < 1) { pool.play_stationary("sounds/store/error.ogg", false); dlgmessage_return("Please enter a number greater than zero."); continue; }
        double totalSpent = 0;
        double autoGained = 0, manulGained = 0, speedGained = 0;
        string[] boughtNames;
        for (uint i = 0; i < bundles.length(); i++)
        {
            if (bundles[i].menu != chosenMenu) continue;
            if (bundles[i].min_rank > 0 && rank < bundles[i].min_rank) continue;
            double passBalance = (chosenCurrency == "cookies") ? cookies : coins;
            double copies = max_affordable_bundle_copies(bundles[i], storeItems, passBalance);
            if (copies > passes) copies = passes;
            if (copies < 1) continue;
            double cost = calc_bundle_total_qty(bundles[i], storeItems, copies);
            if (chosenCurrency == "cookies") { cookies -= cost; } else { coins -= cost; stat_coins_spent += cost; }
            totalSpent = safe_cap(totalSpent + cost);
            boughtNames.insert_last(bundles[i].name);
            for (uint j = 0; j < bundles[i].entries.length(); j++)
            {
                for (uint k = 0; k < storeItems.length(); k++)
                {
                    if (storeItems[k].item_type == bundles[i].entries[j].item_type)
                    {
                        double amount = bundle_entry_qty(storeItems[k], bundles[i].entries[j].quantity * copies);
                        if (storeItems[k].target == 1) { autocookie += amount * storeItems[k].amount; autocookie_purchases += amount; autoGained = safe_cap(autoGained + amount * storeItems[k].amount); }
                        else if (storeItems[k].target == 2) { manulcookie += amount * storeItems[k].amount; manulcookie_purchases += amount; manulGained = safe_cap(manulGained + amount * storeItems[k].amount); }
                        else if (storeItems[k].target == 3) { double applied = gain_cookiespeed(amount * storeItems[k].amount); cookiespeed_purchases += amount; speedGained = safe_cap(speedGained + applied); }
                        break;
                    }
                }
            }
            stat_bundles_purchased += copies;
        }
        if (totalSpent > 0)
        {
            string gainLog = "";
            string[] gainParts;
            if (autoGained > 0) gainParts.insert_last(format_number(autoGained) + " auto " + (autoGained == 1 ? "cookie" : "cookies"));
            if (manulGained > 0) gainParts.insert_last(format_number(manulGained) + " manual " + (manulGained == 1 ? "cookie" : "cookies"));
            if (speedGained > 0) gainParts.insert_last(format_number(speedGained) + " ms of baking speed");
            gainLog = join_spoken_list(gainParts);
            if (gainLog == "") gainLog = "nothing new because your baking speed is already at its maximum";
            string boughtLog = join_spoken_list(boughtNames);
            pool.play_stationary("sounds/store/buy" + random(1, 4) + ".ogg", false);
            pool.play_stationary("sounds/store/order.ogg", false);
            string spentStr = (chosenCurrency == "cookies") ? count_text(totalSpent, "baked cookie", "baked cookies") : convert_to_currency(totalSpent);
            dlgmessage_return("Bulk purchase complete! You bought up to " + format_number(passes) + " of each: " + boughtLog + ". You gained " + gainLog + " for a total of " + spentStr + ".");
        }
        else
            speak("Nothing affordable to buy.");
        continue;
    }
    if (sel.substr(0, 6) == "locked")
    {
        int idx = string_to_int(sel.substr(6));
        pool.play_stationary("sounds/store/error.ogg", false);
        dlgmessage_return("This bundle is locked. You need to reach rank " + string(bundles[idx].min_rank) + " to purchase it.");
        continue;
    }
    if (sel.substr(0, 5) == "maxed")
    {
        pool.play_stationary("sounds/store/error.ogg", false);
        dlgmessage_return("Your baking speed is already at its maximum.");
        continue;
    }
    if (sel.substr(0, 6) == "bundle")
    {
        int idx = string_to_int(sel.substr(6));
        vd.set_disallowed_chars("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ !@#$%^&*()[]{};:'\"\\|,.<>?/+-=`~_", false, "This character is not allowed.");
        double maxBundles = max_affordable_bundle_copies(bundles[idx], storeItems, balance);
        string input = vd.input_box("", "How many " + bundles[idx].name + " would you like to buy? Press enter to buy the maximum amount.", string(maxBundles));
        double qty = string_to_number(input);
        if (qty <= 0)
        {
            pool.destroy_sound(alertslot);
            pool.play_stationary("sounds/store/error.ogg", false);
            dlgmessage_return("Error! Please enter a valid number to buy!");
            continue;
        }
        // A speed only bundle can't be bought past the copies whose speed still fits under the maximum.
        double copyLimit = bundle_copy_limit(bundles[idx], storeItems);
        if (qty > copyLimit) qty = copyLimit;
        double grandTotal = calc_bundle_total_qty(bundles[idx], storeItems, qty);
        if (balance < grandTotal)
        {
            pool.play_stationary("sounds/store/error.ogg", false);
            dlgmessage_return("Error! You can't afford " + format_number(qty) + " " + bundles[idx].name + (qty != 1 ? "s" : "") + "!");
            continue;
        }
        if (chosenCurrency == "cookies") { cookies -= grandTotal; } else { coins -= grandTotal; stat_coins_spent += grandTotal; }
        string gainLog = "";
        double autoGained = 0, manulGained = 0, speedGained = 0;
        for (uint j = 0; j < bundles[idx].entries.length(); j++)
        {
            for (uint k = 0; k < storeItems.length(); k++)
            {
                if (storeItems[k].item_type == bundles[idx].entries[j].item_type)
                {
                    double amount = bundle_entry_qty(storeItems[k], bundles[idx].entries[j].quantity * qty);
                    if (storeItems[k].target == 1)
                    {
                        autocookie += amount * storeItems[k].amount;
                        autocookie_purchases += amount;
                        autoGained = safe_cap(autoGained + amount * storeItems[k].amount);
                    }
                    else if (storeItems[k].target == 2)
                    {
                        manulcookie += amount * storeItems[k].amount;
                        manulcookie_purchases += amount;
                        manulGained = safe_cap(manulGained + amount * storeItems[k].amount);
                    }
                    else if (storeItems[k].target == 3)
                    {
                        double applied = gain_cookiespeed(amount * storeItems[k].amount);
                        cookiespeed_purchases += amount;
                        speedGained = safe_cap(speedGained + applied);
                    }
                    break;
                }
            }
        }
        string[] gainParts;
        if (autoGained > 0) gainParts.insert_last(format_number(autoGained) + " auto " + (autoGained == 1 ? "cookie" : "cookies"));
        if (manulGained > 0) gainParts.insert_last(format_number(manulGained) + " manual " + (manulGained == 1 ? "cookie" : "cookies"));
        if (speedGained > 0) gainParts.insert_last(format_number(speedGained) + " ms of baking speed");
        gainLog = join_spoken_list(gainParts);
        if (gainLog == "") gainLog = "nothing new because your baking speed is already at its maximum";
        // Same capped price the menu shows, so the next price never includes speed past the maximum.
        double nextBundleCost = calc_bundle_total(bundles[idx], storeItems);
        stat_bundles_purchased += qty;
        pool.play_stationary("sounds/store/buy" + random(1, 4) + ".ogg", false);
        pool.play_stationary("sounds/store/order.ogg", false);
        string grandStr = (chosenCurrency == "cookies") ? count_text(grandTotal, "baked cookie", "baked cookies") : convert_to_currency(grandTotal);
        string nextBundleStr = (chosenCurrency == "cookies") ? count_text(nextBundleCost, "baked cookie", "baked cookies") : convert_to_currency(nextBundleCost);
        dlgmessage_return("Purchase successful! You bought " + format_number(qty) + " " + bundles[idx].name + (qty != 1 ? "s" : "") + " for " + grandStr + ". You gained " + gainLog + ". Next bundle will cost " + nextBundleStr + ".");
        continue;
    }
    }
}

// What selling count cookies pays right now: the sell price with any sell price boosts, then the prestige money multiplier.
double sell_payout(double count)
{
    double total = safe_cap(count * boosted_sell_price());
    if (prestige_coin_multiplier > 0) total = safe_cap(total * (1.0 + prestige_coin_multiplier / 100.0));
    return total;
}

/* The cookie store's sell menu, laid out like the add a slot menus: packs of cookies, each with what it really pays,
and sell all at the end. Choosing one sells straight away and comes back to the same line. */
void sell_cookies_menu()
{
    double[] packs = {1.0, 5.0, 10.0, 25.0, 50.0, 100.0, 250.0, 500.0, 1000.0, 2500.0, 5000.0, 10000.0};
    double owned = floor(cookies);
    setupmenu(false);
    for (uint i = 0; i < packs.length(); i++)
        m.add_item("Sell " + count_text(packs[i], "cookie", "cookies") + " for " + convert_to_currency(sell_payout(packs[i])), "sell" + string(i));
    m.add_item("Sell all " + count_text(owned, "cookie", "cookies") + " for " + convert_to_currency(sell_payout(owned)), "sellall");
    m.add_item("Back", "back");
    m.intro_text = "Sell cookies menu.";
    int start_pos = 0;
    if (sell_last_id != "")
    {
        int found = m.find_item_by_id(sell_last_id);
        if (found != -1) start_pos = found;
    }
    int mres = m.run(start_pos, true);
    string sel = m.get_item_id(mres);
    if (mres != -1) sell_last_id = sel;
    if (mres == -1 || sel == "back")
    {
        sell_last_id = "";
        shopmenu();
        return;
    }
    double count = (sel == "sellall") ? owned : packs[string_to_int(sel.substr(4))];
    if (count < 1 || count > owned)
    {
        pool.destroy_sound(alertslot);
        pool.play_stationary("sounds/store/fail.ogg", false);
        dlgmessage_return(owned < 1 ? "Error! You have no cookies to sell!" : "Error! You don't have enough cookies to sell that many!");
        sell_cookies_menu();
        return;
    }
    double earned = sell_payout(count);
    cookies -= count;
    coins += earned;
    stat_coins_earned += earned;
    play_coin_sound(earned);
    // Spoken rather than shown in a dialog, so selling again is one press away, like adding slots.
    speak("Successfully sold " + count_text(count, "cookie", "cookies") + " for " + convert_to_currency(earned) + "!");
    sell_cookies_menu();
}

void add_auto_slots()
{
    setupmenu(false);
    m.add_item("Add " + format_number(1) + " auto slot for "   + convert_to_currency(calc_slot_cost(1)),   "add_slot");
    m.add_item("Add " + format_number(5) + " auto slots for "   + convert_to_currency(calc_slot_cost(5)),   "add_slot2");
