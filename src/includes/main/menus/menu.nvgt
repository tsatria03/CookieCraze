void loadgamemenu()
{
setupmenu();
for (uint i = 1; i <= 20; i++) 
{
        string saveFile = APPDATA_DIR + "saves/game" + string(i) + ".crz";
        double rank = get_save_rank(saveFile);
        if (rank == -1)
        {
            m.add_item("Slot " + string(i) + ". Empty.", "sl" + string(i));
        }
        else
        {
            m.add_item("Slot " + string(i) + ". Highest rank: " + string(format_number(rank)), "sl" + string(i));
        }
    }
m.add_item("Back", "back");
m.intro_text = "Select the save slot to load the game from.";
int mres = m.run();
string slotem = m.get_item_id(mres);
if(mres==-1)
{
speak("canceled");
gamemenu();
}
if (slotem == "back")
{
speak("canceled");
gamemenu();
}
int slotNumber = string_to_int(slotem.substr(2));
set_save_slot(slotNumber);
if (file_exists(currentSaveSlot))
{
speak("Loading slot " + string(slotNumber));
m.fade_music();
if(introsfx==true) pool.play_stationary("sounds/misc/welcome" + random(1, 3) + ".ogg", false);        
ambpool.destroy_sound(ambslot);
muspool.destroy_sound(mustrackslot);
ambslot=ambpool.play_stationary_extended("sounds/ambience/"+ambtype+".ogg", true,0,0,ambvolume,ambpitch,false);
mustrackslot=muspool.play_stationary_extended("sounds/ambience/"+mustype+".ogg", true,0,0,musvolume,muspitch,false);
ingame=true;
readdata();
start_session_stats();
clickergame();
}
else
{
m.fade_music();
alertslot=pool.play_stationary("sounds/dlg/error.ogg",false);
dlg("Error! The data associated with this save slot does not exist!");
pool.destroy_sound(alertslot);
ingame=false;
gamemenu();
}
}
void newgamemenu()
{
setupmenu();
for (uint i = 1; i <= 20; i++) 
{
        string saveFile = APPDATA_DIR + "saves/game" + string(i) + ".crz";
        double rank = get_save_rank(saveFile);
        if (rank == -1)
        {
            m.add_item("Slot " + string(i) + ". Empty.", "sl" + string(i));
        }
        else
        {
            m.add_item("Slot " + string(i) + ". Highest rank: " + string(format_number(rank)), "sl" + string(i));
        }
    }
m.add_item("Back", "back");
m.intro_text = "Select the save slot to start the game from.";
int mres = m.run();
string slotem2 = m.get_item_id(mres);
if(mres==-1)
{
speak("canceled");
gamemenu();
}
if (slotem2 == "back")
{
speak("canceled");
gamemenu();
}
int slotNumber = string_to_int(slotem2.substr(2));
set_save_slot(slotNumber);
if (file_exists(currentSaveSlot))
{
// The menu music keeps playing on this prompt, as it did before, so the fade below still has music to fade.
if (!yes_no("Are you sure you want to start over from the beginning? This will erase all progress on the selected save slot.", false, true))
{
ingame=false;
newgamemenu();
}
else
{
speak("Loading slot " + string(slotNumber));
m.fade_music();
if(introsfx==true) pool.play_stationary("sounds/misc/welcome" + random(1, 3) + ".ogg", false);        
ambpool.destroy_sound(ambslot);
muspool.destroy_sound(mustrackslot);
ambslot=ambpool.play_stationary_extended("sounds/ambience/"+ambtype+".ogg", true,0,0,ambvolume,ambpitch,false);
mustrackslot=muspool.play_stationary_extended("sounds/ambience/"+mustype+".ogg", true,0,0,musvolume,muspitch,false);
ingame=true;
resetgame();
// Save the fresh game straight away, so the slot really is erased as the prompt says, and Control L or the load menu finds this game instead of the old one.
writedata();
start_session_stats();
clickergame();
}
}
else
{
speak("Loading slot " + string(slotNumber));
m.fade_music();
if(introsfx==true) pool.play_stationary("sounds/misc/welcome" + random(1, 3) + ".ogg", false);
ambpool.destroy_sound(ambslot);
muspool.destroy_sound(mustrackslot);
ambslot=ambpool.play_stationary_extended("sounds/ambience/"+ambtype+".ogg", true,0,0,ambvolume,ambpitch,false);
mustrackslot=muspool.play_stationary_extended("sounds/ambience/"+mustype+".ogg", true,0,0,musvolume,muspitch,false);
ingame=true;
resetgame();
// Save the fresh game straight away, so the slot really is erased as the prompt says, and Control L or the load menu finds this game instead of the old one.
writedata();
start_session_stats();
clickergame();
}
}
