/* Settings snapshots. preffsmenu takes one as a settings submenu opens, and Cancel or Escape in that
submenu restores it, so nothing changed there sticks without pressing Save. The submenus re-enter
themselves after a name change or a cancelled reset, so they can't take the snapshot themselves. */
double setsnap_automationMultiplier, setsnap_slotMultiplier, setsnap_manualSlotMultiplier;
double setsnap_cookiemod, setsnap_cookieExpMod, setsnap_cookieSellPrice;
int setsnap_evchanse, setsnap_evchanse2, setsnap_numberFormatMode;
bool setsnap_introsfx, setsnap_logosfx, setsnap_exitsfx, setsnap_bakesfx, setsnap_savesfx, setsnap_speak_menu_position;
bool setsnap_slotDistribution, setsnap_manualSlotDistribution, setsnap_show_locked_shops;
bool setsnap_playervents, setsnap_playervents2;
double setsnap_ambvolume, setsnap_musvolume, setsnap_storambvolume, setsnap_stormusvolume;
string setsnap_ambtype, setsnap_mustype;
int setsnap_ambienceIndex, setsnap_musicIndex;
int setsnap_playergender;
string setsnap_playername, setsnap_playername2;
void snapshot_game_settings()
{
setsnap_automationMultiplier = automationMultiplier;
setsnap_slotMultiplier = slotMultiplier;
setsnap_manualSlotMultiplier = manualSlotMultiplier;
setsnap_cookiemod = cookiemod;
setsnap_cookieExpMod = cookieExpMod;
setsnap_cookieSellPrice = cookieSellPrice;
setsnap_evchanse = evchanse;
setsnap_evchanse2 = evchanse2;
setsnap_numberFormatMode = numberFormatMode;
setsnap_introsfx = introsfx;
setsnap_logosfx = logosfx;
setsnap_exitsfx = exitsfx;
setsnap_bakesfx = bakesfx;
setsnap_savesfx = savesfx;
setsnap_speak_menu_position = speak_menu_position;
setsnap_slotDistribution = slotDistribution;
setsnap_manualSlotDistribution = manualSlotDistribution;
setsnap_show_locked_shops = show_locked_shops;
setsnap_playervents = playervents;
setsnap_playervents2 = playervents2;
}
void restore_game_settings()
{
automationMultiplier = setsnap_automationMultiplier;
slotMultiplier = setsnap_slotMultiplier;
manualSlotMultiplier = setsnap_manualSlotMultiplier;
cookiemod = setsnap_cookiemod;
cookieExpMod = setsnap_cookieExpMod;
cookieSellPrice = setsnap_cookieSellPrice;
evchanse = setsnap_evchanse;
evchanse2 = setsnap_evchanse2;
numberFormatMode = setsnap_numberFormatMode;
introsfx = setsnap_introsfx;
logosfx = setsnap_logosfx;
exitsfx = setsnap_exitsfx;
bakesfx = setsnap_bakesfx;
savesfx = setsnap_savesfx;
speak_menu_position = setsnap_speak_menu_position;
slotDistribution = setsnap_slotDistribution;
manualSlotDistribution = setsnap_manualSlotDistribution;
show_locked_shops = setsnap_show_locked_shops;
playervents = setsnap_playervents;
playervents2 = setsnap_playervents2;
}
void snapshot_sound_settings()
{
setsnap_ambvolume = ambvolume;
setsnap_musvolume = musvolume;
setsnap_storambvolume = storambvolume;
setsnap_stormusvolume = stormusvolume;
setsnap_ambtype = ambtype;
setsnap_mustype = mustype;
setsnap_ambienceIndex = ambienceIndex;
setsnap_musicIndex = musicIndex;
}
void restore_sound_settings()
{
bool ambChanged = (ambtype != setsnap_ambtype);
bool musChanged = (mustype != setsnap_mustype);
ambvolume = setsnap_ambvolume;
musvolume = setsnap_musvolume;
storambvolume = setsnap_storambvolume;
stormusvolume = setsnap_stormusvolume;
ambtype = setsnap_ambtype;
mustype = setsnap_mustype;
ambienceIndex = setsnap_ambienceIndex;
musicIndex = setsnap_musicIndex;
ambpool.update_sound_start_values(ambslot, 0, ambvolume, ambpitch);
muspool.update_sound_start_values(mustrackslot, 0, musvolume, muspitch);
storambpool.update_sound_start_values(storambslot, 0, storambvolume, storambpitch);
stormuspool.update_sound_start_values(stortrackslot, 0, stormusvolume, stormuspitch);
if (ingame && ambChanged)
{
ambpool.destroy_sound(ambslot);
ambslot = ambpool.play_stationary_extended("sounds/ambience/" + ambtype + ".ogg", true, 0, 0, ambvolume, ambpitch, false);
}
if (ingame && musChanged)
{
muspool.destroy_sound(mustrackslot);
mustrackslot = muspool.play_stationary_extended("sounds/ambience/" + mustype + ".ogg", true, 0, 0, musvolume, muspitch, false);
}
}
void snapshot_user_settings()
{
setsnap_playergender = playergender;
setsnap_playername = playername;
setsnap_playername2 = playername2;
}
void restore_user_settings()
{
playergender = setsnap_playergender;
playername = setsnap_playername;
playername2 = setsnap_playername2;
}
void preffsmenu()
{
form.reset();
    form.create_window("preferences", false);
    int audsets = form.create_button("&audio settings");
int gamsets = form.create_button("&game settings");
int usersets = form .create_button("&user settings");
form.focus(audsets);
    while (true)
    {
        form.monitor();
        wait(5);
        if (form.is_pressed(gamsets))
        {
snapshot_game_settings();
gamsetsmenu();
}
        if (form.is_pressed(audsets))
        {
snapshot_sound_settings();
soundsetsmenu();
}
        if (form.is_pressed(usersets))
        {
snapshot_user_settings();
usersetsmenu();
}
        if (key_pressed(KEY_ESCAPE))
        {
if(ingame==true)
{
form.reset();
clickergame();
}
else if(ingame==false)
{
mainmenu();
}
    }
}
}
void gamsetsmenu()
{
    form.reset();
    form.create_window("Game Settings", false);
int logoSFX = form.create_checkbox("Enable playing the logo sound upon launching the game.", logosfx);
int introSFX = form.create_checkbox("Enable playing the intro sound upon starting the game.", introsfx);
int exitSFX = form.create_checkbox("Enable playing the exit sound upon exiting the game.", exitsfx);
int menuPositionToggle = form.create_checkbox("Enable speaking the position of each item in menus.", speak_menu_position);
int saveSFX = form.create_checkbox("Enable save sound effects when reloading and saving the game.", savesfx);
int bakeSFX = form.create_checkbox("Enable auto bake sound effects when baking cookies.", bakesfx);
int playvents = form.create_checkbox("Enable player events during auto baking.", playervents);
int playvents2 = form.create_checkbox("Enable player events during manual baking.", playervents2);
int bakeSplitToggle = form.create_checkbox("Enable evenly distributing cookie production across automated slots.", slotDistribution);
int manualBakeSplitToggle = form.create_checkbox("Enable evenly distributing cookie production across manual slots.", manualSlotDistribution);
int showLockedToggle = form.create_checkbox("Enable showing locked items and menus in the shop list.", show_locked_shops);
int automationMultiplierSlider = form.create_slider("Automation slot Cost Multiplier.", round((automationMultiplier - 1.0) * 100, 0), 1, 100, "X", 1);
int slotMultiplierSlider = form.create_slider("Auto slot production Cost Multiplier.", round((slotMultiplier - 1.0) * 100, 0), 1, 100, "X", 1);
int manualSlotMultiplierSlider = form.create_slider("Manual slot production Cost Multiplier.", round((manualSlotMultiplier - 1.0) * 100, 0), 1, 100, "X", 1);
int cookieRankModifierSlider = form.create_slider("Cookie Rank Modifier.", cookiemod, 1, 100, "x", 1);
int cookieExpModSlider = form.create_slider("Cookie Experience Modifier.", cookieExpMod, 1, 100, "x", 1);
int autoChanceSlider = form.create_slider("Auto-Baking Event chance.", 100 - evchanse, 0, 100, "percent", 1);
int manualChanceSlider = form.create_slider("Manual-Baking Event chance.", 100 - evchanse2, 0, 100, "percent", 1);
int sellPriceSlider = form.create_slider("Cookie sell price.", cookieSellPrice, 1, 100, "cents", 1);
int numberFormatList = form.create_list("Number format", 4);
form.add_list_item(numberFormatList, "Raw. Example, 5,230.");
form.add_list_item(numberFormatList, "Suffix short. Example, 5.23 K.");
form.add_list_item(numberFormatList, "Suffix long. Example, 5.23 million.");
form.add_list_item(numberFormatList, "Scientific. Example, 5.23 e plus 3.");
form.set_list_position(numberFormatList, numberFormatMode);
int restsets = form.create_button("&reset settings");
int savesets = form.create_button("&save settings", true);
int cansets = form.create_button("&cancel");
form.focus(logoSFX);
    while (true)
    {
        wait(5);
        form.monitor();
automationMultiplier = 1.0 + (form.get_slider(automationMultiplierSlider) * 0.01);
slotMultiplier = 1.0 + (form.get_slider(slotMultiplierSlider) * 0.01);
manualSlotMultiplier = 1.0 + (form.get_slider(manualSlotMultiplierSlider) * 0.01);
cookiemod = form.get_slider(cookieRankModifierSlider);
cookieExpMod = form.get_slider(cookieExpModSlider);
evchanse = 100 - form.get_slider(autoChanceSlider);
evchanse2 = 100 - form.get_slider(manualChanceSlider);
cookieSellPrice = form.get_slider(sellPriceSlider);
numberFormatMode = form.get_list_position(numberFormatList);
introsfx = form.is_checked(introSFX);
logosfx = form.is_checked(logoSFX);
exitsfx = form.is_checked(exitSFX);
bakesfx = form.is_checked(bakeSFX);
savesfx = form.is_checked(saveSFX);
speak_menu_position = form.is_checked(menuPositionToggle);
slotDistribution = form.is_checked(bakeSplitToggle);
manualSlotDistribution = form.is_checked(manualBakeSplitToggle);
show_locked_shops = form.is_checked(showLockedToggle);
        playervents = form.is_checked(playvents);
        playervents2 = form.is_checked(playvents2);
        if (form.is_pressed(restsets))
        {
setupmenu(false);
m.add_item("Yes", "yes");
m.add_item("No", "no");
m.intro_text = "Are you sure you want to reset your game settings to their defaults? This action cannot be undone.";
int resmres = m.run();
string rescfm = m.get_item_id(resmres);
if (resmres == -1 || rescfm == "no")
{
speak("canceled");
gamsetsmenu();
}
if (rescfm == "yes")
{
reset_game_settings();
dlgmessage_return("Game settings reset.");
if (ingame) { form.reset(); clickergame(); }
else mainmenu();
}
        }
        if (form.is_pressed(savesets))
        {
writepreffs();
            dlgmessage_return("Settings saved.");
/* Only touch the save slot while a game is loaded; from the main menu it would write
leftover, unsaved progress into the last slot used. In game, readdata recomputes the rank
requirement from a changed cookie rank modifier. */
if (ingame)
{
writedata();
readdata();
}
            preffsmenu();
        }
if (key_pressed(KEY_ESCAPE) || form.is_pressed(cansets))
        {
restore_game_settings();
speak("canceled");
preffsmenu();
}
}
}
void soundsetsmenu()
{
form.reset();
    form.create_window("audio settings", false);
int amblist, musslist;
if(ingame==true) amblist = form.create_list("ambience sound:", 4);
if(ingame==true) musslist = form.create_list("music track:", 20);
    string[] ambOptions;
    for (uint i = 1; i <= 4; i++)
    {
        string ambName = "Room " + i;
        string ambID = "room" + i;
        ambOptions.insert_last(ambID);
        form.add_list_item(amblist, ambName, ambID);
    }
    string[] musOptions;
    for (uint i = 1; i <= 20; i++)
    {
        string musName = "Music " + i;
        string musID = "music" + i;
        musOptions.insert_last(musID);
        form.add_list_item(musslist, musName, musID);
    }
if(ingame==true) form.set_list_position(amblist, ambienceIndex);
if(ingame==true) form.set_list_position(musslist, musicIndex);
int gameAmbienceVolumeSlider = form.create_slider("game ambience volume, ", (ambvolume + 50) * 2, 0, 100, "percent", 1);
int gameMusicVolumeSlider = form.create_slider("game music volume, ", (musvolume + 50) * 2, 0, 100, "percent", 1);
int storeAmbienceVolumeSlider = form.create_slider("store ambience volume, ", (storambvolume + 50) * 2, 0, 100, "percent", 1);
int storeMusicVolumeSlider = form.create_slider("store music volume, ", (stormusvolume + 50) * 2, 0, 100, "percent", 1);
int restsets = form.create_button("&reset settings");
int savesets = form.create_button("&save settings", true);
int cansets = form.create_button("&cancel");
form.focus(amblist);
    while (true)
    {
        wait(5);
        form.monitor();
ambvolume = (form.get_slider(gameAmbienceVolumeSlider) / 2) - 50;
musvolume = (form.get_slider(gameMusicVolumeSlider) / 2) - 50;
storambvolume = (form.get_slider(storeAmbienceVolumeSlider) / 2) - 50;
stormusvolume = (form.get_slider(storeMusicVolumeSlider) / 2) - 50;
        ambpool.update_sound_start_values(ambslot, 0, ambvolume, ambpitch);
        muspool.update_sound_start_values(mustrackslot, 0, musvolume, muspitch);
storambpool.update_sound_start_values(storambslot, 0, storambvolume, storambpitch);
stormuspool.update_sound_start_values(stortrackslot, 0, stormusvolume, stormuspitch);
if(ingame==true) ambienceIndex = form.get_list_position(amblist);
        if (ambienceIndex != -1 && ambOptions[ambienceIndex] != ambtype)
        {
            ambtype = ambOptions[ambienceIndex];
            ambpool.destroy_sound(ambslot);
            ambslot = ambpool.play_stationary_extended("sounds/ambience/"+ambtype + ".ogg", true, 0, 0, ambvolume, ambpitch, false);
        }
if(ingame==true) musicIndex = form.get_list_position(musslist);
        if (musicIndex != -1 && musOptions[musicIndex] != mustype)
        {
            mustype = musOptions[musicIndex];
            muspool.destroy_sound(mustrackslot);
            mustrackslot = muspool.play_stationary_extended("sounds/ambience/"+mustype + ".ogg", true, 0, 0, musvolume, muspitch, false);
        }
        if (form.is_pressed(restsets))
        {
setupmenu(false);
m.add_item("Yes", "yes");
m.add_item("No", "no");
m.intro_text = "Are you sure you want to reset your sound settings to their defaults? This action cannot be undone.";
int resmres = m.run();
string rescfm = m.get_item_id(resmres);
if (resmres == -1 || rescfm == "no")
{
speak("canceled");
soundsetsmenu();
}
if (rescfm == "yes")
{
reset_sound_settings();
if (ingame)
{
ambpool.destroy_sound(ambslot);
ambslot = ambpool.play_stationary_extended("sounds/ambience/" + ambtype + ".ogg", true, 0, 0, ambvolume, ambpitch, false);
muspool.destroy_sound(mustrackslot);
mustrackslot = muspool.play_stationary_extended("sounds/ambience/" + mustype + ".ogg", true, 0, 0, musvolume, muspitch, false);
}
dlgmessage_return("Sound settings reset.");
if (ingame) { form.reset(); clickergame(); }
else mainmenu();
}
        }
        if (form.is_pressed(savesets))
        {
writepreffs2();
dlgmessage_return("Settings saved.");
preffsmenu();
}
        if (key_pressed(KEY_ESCAPE) || form.is_pressed(cansets))
        {
restore_sound_settings();
speak("canceled");
preffsmenu();
}
    }
}
void usersetsmenu()
{
    string gendertext;
    if (playergender == 0)
{
        gendertext = "Male";
    }
else if (playergender == 1)
{
        gendertext = "Female";
    }
else if (playergender == 2)
{
        gendertext = "Non-binary";
    }
else
{
        gendertext = "Unknown";
    }
    form.reset();
    form.create_window("User Settings", false);
    int charname = form.create_button("Change the character's &first name. Currently set to "+playername+".");
    int charname2 = form.create_button("Change the character's &last name. Currently set to "+playername2+".");
    int chargender = form.create_list("Change the character's &gender. Currently set to " + gendertext + ".", 3);
    form.add_list_item(chargender, "Male");
    form.add_list_item(chargender, "Female");
    form.add_list_item(chargender, "Non-binary");
    if (playergender >= 0 && playergender <= 2)
{
        form.set_list_position(chargender, playergender);
    }
int restsets = form.create_button("&reset settings");
int savesets = form.create_button("&save settings", true);
int cansets = form.create_button("&cancel");
form.focus(charname);
    while (true)
    {
        form.monitor();
        wait(5);
playergender = form.get_list_position(chargender);
        if (form.is_pressed(charname))
        {
vd.set_disallowed_chars(" !@#$%^&*()[]{};:'\"\\|,.<>?/+-=`~_", false, "This character is not allowed.");
string fn=vd.input_box("","Enter the first name of this character.");
if(fn.is_empty())
{
alertslot=pool.play_stationary("sounds/dlg/error.ogg",false);
dlg("Error! Your character's first name is invalid!");
pool.destroy_sound(alertslot);
            form.reset();
            usersetsmenu();
}
else
{
playername=fn;
            dlgmessage_return("Success! Your character's first name has now been changed to "+playername+".");
            form.reset();
            usersetsmenu();
}
}
        if (form.is_pressed(charname2))
        {
vd.set_disallowed_chars(" !@#$%^&*()[]{};:'\"\\|,.<>?/+-=`~_", false, "This character is not allowed.");
string fn2=vd.input_box("","Enter the last name of this character.");
if(fn2.is_empty())
{
alertslot=pool.play_stationary("sounds/dlg/error.ogg",false);
dlg("Error! Your character's last name is invalid!");
pool.destroy_sound(alertslot);
            form.reset();
            usersetsmenu();
}
else
{
playername2=fn2;
            dlgmessage_return("Success! Your character's last name has now been changed to "+playername2+".");
            form.reset();
            usersetsmenu();
}
}
        if (form.is_pressed(restsets))
        {
setupmenu(false);
m.add_item("Yes", "yes");
m.add_item("No", "no");
m.intro_text = "Are you sure you want to reset your user settings? This will restart the game and take you back to profile setup. This action cannot be undone.";
int resmres = m.run();
string rescfm = m.get_item_id(resmres);
if (resmres == -1 || rescfm == "no")
{
speak("canceled");
usersetsmenu();
}
if (rescfm == "yes")
{
if (file_exists(APPDATA_DIR + "preffs/usersets.crz")) file_delete(APPDATA_DIR + "preffs/usersets.crz");
speak("restarting");
wait(500);
restart("cycrz.exe");
}
        }
        if (form.is_pressed(savesets))
        {
            writepreffs3();
            dlgmessage_return("Settings saved.");
preffsmenu();
        }
        if (key_pressed(KEY_ESCAPE) || form.is_pressed(cansets))
        {
restore_user_settings();
speak("canceled");
preffsmenu();
}
    }
}
