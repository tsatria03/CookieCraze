void flipgame()
{
    string[] flipperTypeIds = { "cookie", "penny" };
    string[] flipperTypeNames = { "Cookie", "Penny" };

    form.reset();
    form.create_window("cookie flipper", false);
    int typeList = form.create_list("Choose &what to flip:", flipperTypeIds.length(), false, false);
    for (uint i = 0; i < flipperTypeNames.length(); i++)
        form.add_list_item(typeList, flipperTypeNames[i], flipperTypeIds[i], -1, false);
    int cookEventList = form.create_list("Choose the &cookie events to use:", loadedFlipperEvents.length(), true, false);
    for (uint i = 0; i < loadedFlipperEvents.length(); i++)
    {
        form.add_list_item(cookEventList, loadedFlipperEvents[i].event_name, loadedFlipperEvents[i].event_name, -1, true);
    }
    int flip = form.create_button("&Flip a " + flipperTypeNames[0], true);
    int historyBox = form.create_input_box("Flipper &History", "", read_only:true, multiline:true);
    int lastTypeIdx = 0;
    string historyText = "";
    if (flipperHistory.length() == 0)
        historyText = "No flips recorded yet.";
    else
    {
        for (uint hi = 0; hi < flipperHistory.length(); hi++)
        {
            string hline = "Flip " + string(hi + 1) + ": " + flipperHistory[hi].side + " - " + flipperHistory[hi].event_name + " (" + flipperHistory[hi].outcome + ")";
            historyText += hline + "\r\n";
        }
    }
    form.set_text(historyBox, historyText);
    form.focus(typeList);
    while (true)
    {
        wait(5);
        form.monitor();
if(autocookie<=0)
{
bakemode=0;
autocookie=0;
}
if(coins<=0)
{
coins=0;
}
if(cookies<=0)
{
cookies=0;
}
if(cookiespeed<=0)
{
cookiespeed=0;
}
if(manulcookie<=0)
{
manulcookie=0;
}
if(clicktime<=50)
{
clicktime=50;
}
if(clicktime>=1000)
{
clicktime=1000;
}
flipgame_input();
        int curTypeIdx = form.get_list_position(typeList);
        if (curTypeIdx < 0) curTypeIdx = 0;
        if (curTypeIdx != lastTypeIdx)
        {
            lastTypeIdx = curTypeIdx;
            bool[] savedChecks;
            for (uint i = 0; i < loadedFlipperEvents.length(); i++)
                savedChecks.insert_last(form.is_list_item_checked(cookEventList, i));
            string savedHistText = form.get_text(historyBox);
            string eventLabel = "Choose the &" + flipperTypeNames[curTypeIdx] + " events to use:";
            form.delete_control(historyBox);
            form.delete_control(flip);
            form.delete_control(cookEventList);
            cookEventList = form.create_list(eventLabel, loadedFlipperEvents.length(), true, false);
            for (uint i = 0; i < loadedFlipperEvents.length(); i++)
                form.add_list_item(cookEventList, loadedFlipperEvents[i].event_name, loadedFlipperEvents[i].event_name, -1, savedChecks[i]);
            flip = form.create_button("&Flip a " + flipperTypeNames[curTypeIdx], true);
            historyBox = form.create_input_box("Flipper &History", savedHistText, read_only:true, multiline:true);
            form.focus_silently(typeList);
        }
        if (key_pressed(KEY_ESCAPE))
        {
pool.destroy_sound(gameslot);
            mingamsmenu();
        }
check_rank();
check_achievements(loadedAchievements, achievementsUnlocked);
if (form.is_pressed(flip))
{
        int selectedTypeIdx = form.get_list_position(typeList);
        if (selectedTypeIdx < 0) selectedTypeIdx = 0;
    {
        event_item[] chocsEvents;
        event_item[] bisksEvents;
        for (uint i = 0; i < loadedFlipperEvents.length(); i++)
        {
            if (form.is_list_item_checked(cookEventList, i))
            {
                if (loadedFlipperEvents[i].polarity == 1)
                    chocsEvents.insert_last(loadedFlipperEvents[i]);
                else
                    bisksEvents.insert_last(loadedFlipperEvents[i]);
            }
        }
        if (chocsEvents.length() == 0 || bisksEvents.length() == 0)
        {
            dlg_buffer("You must select at least one positive and one negative event before flipping!");
            form.reset();
            flipgame();
        }
        string flipperType = flipperTypeIds[selectedTypeIdx];
        string flipItemName = flipperTypeNames[selectedTypeIdx];
        string flipSoundPath = "sounds/minigames/cookie_flipper/" + flipperType + "/flip.ogg";
        string landSoundPath = "sounds/minigames/cookie_flipper/" + flipperType + "/land.ogg";
        bool hasLandSound = (flipperType == "penny");
        string[] cooksides;
        if (flipperType == "penny") { cooksides = { "heads", "tails" }; }
        else { cooksides = { "chocolate", "bisket" }; }
        string side = cooksides[random(0, cooksides.length() - 1)];
        stat_flipper_flips++;
        if (flipperType == "penny") stat_penny_flips++;
        else stat_cookie_flips++;
        pool.destroy_sound(eventslot);
        pool.play_stationary(flipSoundPath, false);
        if (flipmode)
            mini_wait_async(random(500, 1000), "flipper");
        else
            dlg_buffer("Flipping. Press enter or space to reveal.");
        if (hasLandSound)
            pool.play_stationary(landSoundPath, false);
        dlg_buffer("You flip a " + flipItemName + ". It lands on " + side);
        event_item@ chosenEvent = null;
        if (side == cooksides[0] && chocsEvents.length() > 0)
        {
            @chosenEvent = chocsEvents[random(0, chocsEvents.length() - 1)];
            trigger_cook_event(chosenEvent);
            form.focus_silently(flip);
        }
        else if (side == cooksides[1] && bisksEvents.length() > 0)
        {
            @chosenEvent = bisksEvents[random(0, bisksEvents.length() - 1)];
            trigger_cook_event(chosenEvent);
            form.focus_silently(flip);
        }
        if (chosenEvent !is null)
        {
            flipper_flip_entry entry;
            entry.side = side;
            entry.event_name = chosenEvent.event_name;
            entry.outcome = (chosenEvent.polarity == 1 ? "positive" : "negative");
            flipperHistory.insert_last(entry);
            if (int(flipperHistory.length()) > flipperHistoryMax)
                flipperHistory.remove_at(0);
            string newHistText = "";
            for (uint hi = 0; hi < flipperHistory.length(); hi++)
            {
                string hline = "Flip " + string(hi + 1) + ": " + flipperHistory[hi].side + " - " + flipperHistory[hi].event_name + " (" + flipperHistory[hi].outcome + ")";
                newHistText += hline + "\r\n";
            }
            form.set_text(historyBox, newHistText);
        }
    }
}
}
}

void flipgame_input() { minigame_input("flipper"); }

void slotsgame()
{
    form.reset();
    form.create_window("Slot Machine", false);
    int betChoice = form.create_list("Choose an &item to bet:", 5);
    form.add_list_item(betChoice, "Cookies");
    form.add_list_item(betChoice, "Currency");
    form.add_list_item(betChoice, "Auto Cookies");
    form.add_list_item(betChoice, "Auto Cookie Speeds");
    form.add_list_item(betChoice, "Manual Cookies");
string[] symbols = slotSymbols;
if (orderedSyms == false)
{
    for (uint i = symbols.length() - 1; i > 0; i--)
    {
        uint j = random(0, i);
        string tmp = symbols[i];
        symbols[i] = symbols[j];
        symbols[j] = tmp;
    }
}
    int symbolChoices = form.create_list("Choose the s&ymbols to use:", symbols.length(), true, false);
    bool[] symbolToggles(symbols.length(), true);
    for (uint i = 0; i < symbols.length(); i++)
{
        form.add_list_item(symbolChoices, symbols[i], symbols[i], -1, symbolToggles[i]);
    }
int betInput = form.create_input_box("Enter your b&et amount:", "", "", 0, false, false, false);
    int spinButton = form.create_button("Spin the &reels", true);
form.focus(betChoice);
form.set_disallowed_chars(betInput, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ !@#$%^&*()[]{};:'\"\\|,<>?/+-=`~_", false, "This character is not allowed.");
string[] reelResults(slotReels, "");
    int selectedBet = 0;
    double betAmount = 0;
    while (true)
    {
        wait(5);
        form.monitor();
if(autocookie<=0)
{
bakemode=0;
autocookie=0;
}
if(coins<=0)
{
coins=0;
}
if(cookies<=0)
{
cookies=0;
}
if(cookiespeed<=0)
{
cookiespeed=0;
}
if(manulcookie<=0)
{
manulcookie=0;
}
if(clicktime<=50)
{
clicktime=50;
}
if(clicktime>=1000)
{
clicktime=1000;
}
if(form.get_current_focus()!=betInput)
{
slots_game_input();
}
        if (key_pressed(KEY_ESCAPE))
        {
pool.destroy_sound(gameslot);
            mingamsmenu();
        }
check_rank();
check_achievements(loadedAchievements, achievementsUnlocked);
        if (form.is_pressed(spinButton))
        {
            selectedBet = form.get_list_position(betChoice);
string betStr = form.get_text(betInput);
betAmount = floor(selectedBet == 1 ? string_to_number(betStr) * 100.0 : string_to_number(betStr));
    if (betAmount <= 0)
    {
        dlg_buffer("Invalid bet amount. Please enter a valid number!");
        form.focus(spinButton);
        continue;
    }
            if (betAmount < slotMinBet)
            {
                dlg_buffer("Error! The minimum bet is " + (selectedBet == 1 ? convert_to_currency(slotMinBet) : format_number(slotMinBet)) + ".");
                form.focus(spinButton);
                continue;
            }
            if (slotMaxBet > 0 && betAmount > slotMaxBet)
            {
                dlg_buffer("Your bet has been capped at the maximum of " + (selectedBet == 1 ? convert_to_currency(slotMaxBet) : format_number(slotMaxBet)) + ".");
                betAmount = slotMaxBet;
            }
            if (selectedBet == 0) betAmount = min(betAmount, floor(cookies));
            else if (selectedBet == 1) betAmount = min(betAmount, floor(coins));
            else if (selectedBet == 2) betAmount = min(betAmount, floor(autocookie));
            else if (selectedBet == 3) betAmount = min(betAmount, floor(cookiespeed));
            else if (selectedBet == 4) betAmount = min(betAmount, floor(manulcookie));
            if (betAmount <= 0)
            {
                dlg_buffer("You don't have enough of that item to bet!");
                form.focus(spinButton);
                continue;
            }
            string[] activeSymbols;
            for (uint i = 0; i < symbols.length(); i++)
{
                if (form.is_list_item_checked(symbolChoices, i))
{ 
                    activeSymbols.insert_last(symbols[i]); 
                }
            }
            if (activeSymbols.length()<10)
{
                dlg_buffer("You must select at least 10 symbols in order to spin!");
                form.focus(spinButton);
                continue;
            }
if (slotConfirmThreshold > 0)
{
    double statTotal = (selectedBet == 0 ? floor(cookies) : (selectedBet == 1 ? floor(coins) : (selectedBet == 2 ? floor(autocookie) : (selectedBet == 3 ? floor(cookiespeed) : floor(manulcookie)))));
    double effectiveThreshold = slotConfirmUsePercent ? (statTotal * (slotConfirmThreshold / 100.0)) : slotConfirmThreshold;
    if (betAmount >= effectiveThreshold)
    {
        string betItemName2 = (selectedBet == 0 ? "cookies" : (selectedBet == 1 ? "currency" : (selectedBet == 2 ? "auto cookies" : (selectedBet == 3 ? "auto cookie speeds" : "manual cookies"))));
        setupmenu(false);
        m.add_item("Yes", "yes");
        m.add_item("No", "no");
        m.intro_text = "Are you sure you want to bet " + (selectedBet == 1 ? convert_to_currency(betAmount) : format_number(betAmount) + " " + betItemName2) + "?";
        int cres = m.run(0, true);
        string csel = m.get_item_id(cres);
        if (cres == -1 || csel == "no")
        {
            form.focus(spinButton);
            continue;
        }
    }
}
pool.destroy_sound(machineslot);
pool.play_stationary("sounds/minigames/slot_machine/bet1.ogg", false);
if(selectedBet==0) speak_buffer("You placed a bet of " + format_number(betAmount) + " cookies.");
if(selectedBet==1) speak_buffer("You placed a bet of " + convert_to_currency(betAmount) + ".");
if(selectedBet==2) speak_buffer("You placed a bet of " + format_number(betAmount) + " auto cookies.");
if(selectedBet==3) speak_buffer("You placed a bet of " + format_number(betAmount) + " auto cookie speeds.");
if(selectedBet==4) speak_buffer("You placed a bet of " + format_number(betAmount) + " manual cookies.");
mini_wait_async(1000, "slots");
pool.play_stationary("sounds/minigames/slot_machine/bet2.ogg", false);
mini_wait_async(random(600, 800), "slots");
pool.play_stationary("sounds/minigames/slot_machine/bet3.ogg", false);
mini_wait_async(1000, "slots");
stat_slot_spins++;
pool.play_stationary("sounds/minigames/slot_machine/lever.ogg", false);
machineslot=pool.play_stationary("sounds/minigames/slot_machine/spin.ogg", true);
if(slotmode==true) speak_buffer("spinning...");
if(slotmode==false) dlg_buffer("spinning. Press enter or space to stop each reel.");
if(slotmode==true) wait(random(1000,2000));
            string[] stopSounds = {"slot_machine/stop1.ogg", "slot_machine/stop2.ogg", "slot_machine/stop3.ogg"};
            string[] reelNames = {"first", "second", "third", "fourth", "fifth", "sixth", "seventh", "eighth", "ninth", "tenth"};
            for (int i = 0; i < slotReels; i++)
            {
                reelResults[i] = activeSymbols[random(0, activeSymbols.length() - 1)];
                if (slotmode == true) mini_wait_async(random(1000, 2000), "slots");
                if (i == 0) pool.destroy_sound(machineslot);
                pool.play_stationary("sounds/minigames/" + stopSounds[i % stopSounds.length()], false);
                if (slotmode == true) speak_buffer(reelResults[i]);
                else dlg_buffer("The " + (i < int(reelNames.length()) ? reelNames[i] : string(i + 1)) + " reel shows " + reelResults[i]);
            }
int[] symbolCount(symbols.length());
string[] reels = reelResults;
for (uint i = 0; i < reels.length(); i++)
{
    for (uint j = 0; j < symbols.length(); j++)
    {
        if (reels[i] == symbols[j])
        {
            symbolCount[j]++;
        }
    }
}
int maxMatch = 0;
for (uint i = 0; i < symbolCount.length(); i++)
{
    if (symbolCount[i] > maxMatch)
    {
        maxMatch = symbolCount[i];
    }
}
payout_item@ payout = null;
for (uint i = 0; i < slotPayouts.length(); i++)
{
    if (slotPayouts[i].matches == maxMatch || (maxMatch < 2 && slotPayouts[i].matches == 0))
    {
        @payout = slotPayouts[i];
        break;
    }
}
if (payout !is null)
{
    if (slotmode == true) mini_wait_async(random(1000, 2000), "slots");
    pool.destroy_sound(machineslot);
    if (payout.sound != "" && payout.sound != "none")
        pool.play_stationary("sounds/minigames/" + payout.sound, false);
    dlg_buffer(payout.message);
    form.focus(spinButton);
    double change = safe_cap(betAmount * payout.multiplier);
    if (payout.multiplier == 0)
    {
        stat_slot_losses++;
        if (selectedBet == 0) { cookies -= betAmount; if (cookies < 0) cookies = 0; }
        else if (selectedBet == 1) { coins -= betAmount; if (coins < 0) coins = 0; }
        else if (selectedBet == 2) { autocookie -= betAmount; if (autocookie < 0) autocookie = 0; }
        else if (selectedBet == 3) { cookiespeed -= betAmount; clicktime += betAmount; if (cookiespeed < 0) cookiespeed = 0; }
        else if (selectedBet == 4) { manulcookie -= betAmount; if (manulcookie < 0) manulcookie = 0; }
    }
    else
    {
        stat_slot_wins++;
        if (selectedBet == 0) cookies += change;
        else if (selectedBet == 1) coins += change;
        else if (selectedBet == 2) autocookie += change;
        else if (selectedBet == 3) { cookiespeed += change; clicktime -= change; }
        else if (selectedBet == 4) manulcookie += change;
    }
    cookies = floor(safe_cap(cookies));
    coins = floor(safe_cap(coins));
    autocookie = floor(safe_cap(autocookie));
    cookiespeed = floor(safe_cap(cookiespeed));
    manulcookie = floor(safe_cap(manulcookie));
}
        }
}
    }

void slots_game_input() { minigame_input("slots"); }

void jackgame()
{
    form.reset();
    form.create_window("Blackjack", false);
    int betChoice = form.create_list("Choose an &item to bet:", 5);
    form.add_list_item(betChoice, "Cookies");
    form.add_list_item(betChoice, "Currency");
    form.add_list_item(betChoice, "Auto Cookies");
    form.add_list_item(betChoice, "Auto Cookie Speeds");
    form.add_list_item(betChoice, "Manual Cookies");
    int betInput = form.create_input_box("Enter your &bet amount:", "", "", 0, false, false, false);
    int dealButton = form.create_button("&Deal", true);
    int hitButton = form.create_button("&Hit");
    int standButton = form.create_button("&Stand");
    form.set_disallowed_chars(betInput, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ !@#$%^&*()[]{};:'\"\\|,<>?/+-=`~_", false, "This character is not allowed.");
    form.focus(betChoice);
    int p_points = 0, d_points = 0;
    int p_aces = 0, d_aces = 0;
    int selectedBet = 0;
    double betAmount = 0;
    string betItemName = "";
    bool in_round = false;
    while (true)
    {
        wait(5);
        form.monitor();
        if(autocookie<=0) { bakemode=0; autocookie=0; }
        if(coins<=0) coins=0;
        if(cookies<=0) cookies=0;
        if(cookiespeed<=0) cookiespeed=0;
        if(manulcookie<=0) manulcookie=0;
        if(clicktime<=50) clicktime=50;
        if(clicktime>=1000) clicktime=1000;
        if (form.get_current_focus() != betInput)
            jack_game_input();
        if (key_pressed(KEY_ESCAPE))
        {
            pool.destroy_sound(gameslot);
            mingamsmenu();
        }
check_rank();
check_achievements(loadedAchievements, achievementsUnlocked);
        if (key_pressed(KEY_B))
            speak_buffer("Your current bet is " + (selectedBet == 1 ? convert_to_currency(betAmount) : format_number(betAmount) + (betItemName != "" ? " " + betItemName : "")) + ".");
        if (form.is_pressed(dealButton))
        {
            if (in_round)
            {
                dlg_buffer("You are already in a round. Hit or stand to continue.");
                continue;
            }
            selectedBet = form.get_list_position(betChoice);
            string betStr = form.get_text(betInput);
            double betNum = floor(selectedBet == 1 ? string_to_number(betStr) * 100.0 : string_to_number(betStr));
            if (betNum <= 0)
            {
                pool.play_stationary("sounds/misc/gamefail.ogg", false);
                dlg_buffer("Error! Please enter a valid bet amount.");
                continue;
            }
            if (betNum < jacksConfig.min_bet)
            {
                pool.play_stationary("sounds/misc/gamefail.ogg", false);
                dlg_buffer("Error! The minimum bet is " + (selectedBet == 1 ? convert_to_currency(jacksConfig.min_bet) : format_number(jacksConfig.min_bet)) + ".");
                continue;
            }
            if (jacksConfig.max_bet > 0 && betNum > jacksConfig.max_bet)
            {
                pool.play_stationary("sounds/misc/gamefail.ogg", false);
                dlg_buffer("Your bet has been capped at the maximum of " + (selectedBet == 1 ? convert_to_currency(jacksConfig.max_bet) : format_number(jacksConfig.max_bet)) + ".");
                betNum = jacksConfig.max_bet;
            }
            if (selectedBet == 0) betNum = min(betNum, floor(cookies));
            else if (selectedBet == 1) betNum = min(betNum, floor(coins));
            else if (selectedBet == 2) betNum = min(betNum, floor(autocookie));
            else if (selectedBet == 3) betNum = min(betNum, floor(cookiespeed));
            else if (selectedBet == 4) betNum = min(betNum, floor(manulcookie));
            if (betNum <= 0)
            {
                pool.play_stationary("sounds/misc/gamefail.ogg", false);
                dlg_buffer("Error! You don't have enough of that item to bet!");
                continue;
            }
            if (jacksConfig.confirm_threshold > 0)
            {
                double statTotal2 = (selectedBet == 0 ? floor(cookies) : (selectedBet == 1 ? floor(coins) : (selectedBet == 2 ? floor(autocookie) : (selectedBet == 3 ? floor(cookiespeed) : floor(manulcookie)))));
                double effectiveThreshold2 = jacksConfig.confirm_use_percent ? (statTotal2 * (jacksConfig.confirm_threshold / 100.0)) : jacksConfig.confirm_threshold;
                if (betNum >= effectiveThreshold2)
                {
                    string betItemName2 = (selectedBet == 0 ? "cookies" : (selectedBet == 1 ? "currency" : (selectedBet == 2 ? "auto cookies" : (selectedBet == 3 ? "auto cookie speeds" : "manual cookies"))));
                    setupmenu(false);
                    m.add_item("Yes", "yes");
                    m.add_item("No", "no");
                    m.intro_text = "Are you sure you want to bet " + (selectedBet == 1 ? convert_to_currency(betNum) : format_number(betNum) + " " + betItemName2) + "?";
                    int cres = m.run(0, true);
                    string csel = m.get_item_id(cres);
                    if (cres == -1 || csel == "no")
                        continue;
                }
            }
            betAmount = betNum;
            if (selectedBet == 0) { cookies -= betAmount; cookies = floor(safe_cap(cookies)); }
            else if (selectedBet == 1) { coins -= betAmount; coins = floor(safe_cap(coins)); }
            else if (selectedBet == 2) { autocookie -= betAmount; autocookie = floor(safe_cap(autocookie)); }
            else if (selectedBet == 3) { cookiespeed -= betAmount; clicktime += betAmount; cookiespeed = floor(safe_cap(cookiespeed)); }
            else if (selectedBet == 4) { manulcookie -= betAmount; manulcookie = floor(safe_cap(manulcookie)); }
            betItemName = (selectedBet == 0 ? "cookies" : (selectedBet == 1 ? "currency" : (selectedBet == 2 ? "auto cookies" : (selectedBet == 3 ? "auto cookie speeds" : "manual cookies"))));
            p_points = 0; d_points = 0;
            p_aces = 0; d_aces = 0;
            in_round = true;
            stat_jack_hands++;
            string betDisplay = (selectedBet == 1) ? convert_to_currency(betAmount) : (format_number(betAmount) + " " + betItemName);
            if (jackmode) speak_buffer("You bet " + betDisplay + ". Dealing.");
            else dlg_buffer("You bet " + betDisplay + ". Dealing. Press enter or space after each card.");
            if (jackmode) mini_wait_async(random(1000, 2000), "blackjack");
            jack_deal_card(true, p_points, p_aces, d_points, d_aces);
            if (jackmode) mini_wait_async(random(1000, 2000), "blackjack");
            jack_deal_card(false, p_points, p_aces, d_points, d_aces);
            if (jackmode) mini_wait_async(random(1000, 2000), "blackjack");
            jack_deal_card(true, p_points, p_aces, d_points, d_aces);
            if (p_points == 21)
            {
                double winnings = floor(safe_cap(betAmount * jacksConfig.natural_multiplier));
                if (selectedBet == 0) { cookies += betAmount + winnings; cookies = floor(safe_cap(cookies)); }
                else if (selectedBet == 1) { coins += betAmount + winnings; coins = floor(safe_cap(coins)); }
                else if (selectedBet == 2) { autocookie += betAmount + winnings; autocookie = floor(safe_cap(autocookie)); }
                else if (selectedBet == 3) { cookiespeed += betAmount + winnings; clicktime -= betAmount + winnings; cookiespeed = floor(safe_cap(cookiespeed)); }
                else if (selectedBet == 4) { manulcookie += betAmount + winnings; manulcookie = floor(safe_cap(manulcookie)); }
                stat_jack_wins++;
                pool.play_stationary("sounds/minigames/" + resolve_sound(jacksConfig.win_sound), false);
                string msg = jacksConfig.natural_message;
                string betStr = (selectedBet == 1) ? convert_to_currency(betAmount) : format_number(betAmount);
                string winStr = (selectedBet == 1) ? convert_to_currency(winnings) : format_number(winnings);
                int ph = msg.find("%win%");
                while (ph != -1) { msg = msg.substr(0, ph) + winStr + msg.substr(ph + 5); ph = msg.find("%win%"); }
                ph = msg.find("%bet%");
                while (ph != -1) { msg = msg.substr(0, ph) + betStr + msg.substr(ph + 5); ph = msg.find("%bet%"); }
                string itemStr = (selectedBet == 1) ? "" : betItemName;
                ph = msg.find("%item%");
                while (ph != -1) { int start = (itemStr == "" && ph > 0 && msg.substr(ph - 1, 1) == " ") ? ph - 1 : ph; msg = msg.substr(0, start) + itemStr + msg.substr(ph + 6); ph = msg.find("%item%"); }
                dlg_buffer(msg);
                in_round = false;
                betAmount = 0;
                form.focus(dealButton);
            }
        }
        if (form.is_pressed(hitButton))
        {
            if (!in_round)
            {
                dlg_buffer("Please place a bet and deal first.");
                continue;
            }
            jack_deal_card(true, p_points, p_aces, d_points, d_aces);
            if (p_points > 21)
            {
                stat_jack_losses++;
                pool.play_stationary("sounds/minigames/" + resolve_sound(jacksConfig.lose_sound), false);
                string msg = jacksConfig.bust_message;
                int ph = msg.find("%score%");
                while (ph != -1) { msg = msg.substr(0, ph) + string(p_points) + msg.substr(ph + 7); ph = msg.find("%score%"); }
                dlg_buffer(msg);
                in_round = false;
                betAmount = 0;
                p_points = 0; d_points = 0;
                p_aces = 0; d_aces = 0;
                form.focus(dealButton);
            }
            else if (p_points == 21)
            {
                double winnings = floor(safe_cap(betAmount * jacksConfig.win_multiplier));
                if (selectedBet == 0) { cookies += betAmount + winnings; cookies = floor(safe_cap(cookies)); }
                else if (selectedBet == 1) { coins += betAmount + winnings; coins = floor(safe_cap(coins)); }
                else if (selectedBet == 2) { autocookie += betAmount + winnings; autocookie = floor(safe_cap(autocookie)); }
                else if (selectedBet == 3) { cookiespeed += betAmount + winnings; clicktime -= betAmount + winnings; cookiespeed = floor(safe_cap(cookiespeed)); }
                else if (selectedBet == 4) { manulcookie += betAmount + winnings; manulcookie = floor(safe_cap(manulcookie)); }
                stat_jack_wins++;
                pool.play_stationary("sounds/minigames/" + resolve_sound(jacksConfig.win_sound), false);
                dlg_buffer("Twenty-one! You win " + ((selectedBet == 1) ? convert_to_currency(winnings) : (format_number(winnings) + " " + betItemName)) + "!");
                in_round = false;
                betAmount = 0;
                p_points = 0; d_points = 0;
                p_aces = 0; d_aces = 0;
                form.focus(dealButton);
            }
        }
        if (form.is_pressed(standButton))
        {
            if (!in_round)
            {
                dlg_buffer("Please place a bet and deal first.");
                continue;
            }
            if (jackmode) speak_buffer("You stand with " + p_points + ". Dealer's turn.");
            else dlg_buffer("You stand with " + p_points + ". Dealer's turn. Press enter or space after each card.");
            if (jackmode) mini_wait_async(random(1000, 2000), "blackjack");
            while (d_points < jacksConfig.dealer_stand)
            {
                jack_deal_card(false, p_points, p_aces, d_points, d_aces);
                if (jackmode) mini_wait_async(random(1000, 2000), "blackjack");
            }
            int outcome = 0;
            if (d_points > 21) outcome = 1;
            else if (p_points > d_points) outcome = 1;
            else if (p_points < d_points) outcome = -1;
            if (outcome == 1)
            {
                stat_jack_wins++;
                double winnings = floor(safe_cap(betAmount * jacksConfig.win_multiplier));
                if (selectedBet == 0) { cookies += betAmount + winnings; cookies = floor(safe_cap(cookies)); }
                else if (selectedBet == 1) { coins += betAmount + winnings; coins = floor(safe_cap(coins)); }
                else if (selectedBet == 2) { autocookie += betAmount + winnings; autocookie = floor(safe_cap(autocookie)); }
                else if (selectedBet == 3) { cookiespeed += betAmount + winnings; clicktime -= betAmount + winnings; cookiespeed = floor(safe_cap(cookiespeed)); }
                else if (selectedBet == 4) { manulcookie += betAmount + winnings; manulcookie = floor(safe_cap(manulcookie)); }
                pool.play_stationary("sounds/minigames/" + resolve_sound(jacksConfig.win_sound), false);
                string msg = (d_points > 21 ? jacksConfig.dealer_bust_message : jacksConfig.win_message);
                string winStr2 = (selectedBet == 1) ? convert_to_currency(winnings) : format_number(winnings);
                int ph = msg.find("%score%");
                while (ph != -1) { msg = msg.substr(0, ph) + string(p_points) + msg.substr(ph + 7); ph = msg.find("%score%"); }
                ph = msg.find("%dealer%");
                while (ph != -1) { msg = msg.substr(0, ph) + string(d_points) + msg.substr(ph + 8); ph = msg.find("%dealer%"); }
                ph = msg.find("%win%");
                while (ph != -1) { msg = msg.substr(0, ph) + winStr2 + msg.substr(ph + 5); ph = msg.find("%win%"); }
                string itemStr2 = (selectedBet == 1) ? "" : betItemName;
                ph = msg.find("%item%");
                while (ph != -1) { int start = (itemStr2 == "" && ph > 0 && msg.substr(ph - 1, 1) == " ") ? ph - 1 : ph; msg = msg.substr(0, start) + itemStr2 + msg.substr(ph + 6); ph = msg.find("%item%"); }
                dlg_buffer(msg);
            }
            else if (outcome == -1)
            {
                stat_jack_losses++;
                pool.play_stationary("sounds/minigames/" + resolve_sound(jacksConfig.lose_sound), false);
                string msg = jacksConfig.lose_message;
                int ph = msg.find("%score%");
                while (ph != -1) { msg = msg.substr(0, ph) + string(p_points) + msg.substr(ph + 7); ph = msg.find("%score%"); }
                ph = msg.find("%dealer%");
                while (ph != -1) { msg = msg.substr(0, ph) + string(d_points) + msg.substr(ph + 8); ph = msg.find("%dealer%"); }
                dlg_buffer(msg);
            }
            else
            {
                stat_jack_pushes++;
                double returned = floor(safe_cap(betAmount * jacksConfig.push_multiplier));
                if (selectedBet == 0) { cookies += returned; cookies = floor(safe_cap(cookies)); }
                else if (selectedBet == 1) { coins += returned; coins = floor(safe_cap(coins)); }
                else if (selectedBet == 2) { autocookie += returned; autocookie = floor(safe_cap(autocookie)); }
                else if (selectedBet == 3) { cookiespeed += returned; clicktime -= returned; cookiespeed = floor(safe_cap(cookiespeed)); }
                else if (selectedBet == 4) { manulcookie += returned; manulcookie = floor(safe_cap(manulcookie)); }
                pool.play_stationary("sounds/minigames/" + resolve_sound(jacksConfig.push_sound), false);
                string msg = jacksConfig.push_message;
                int ph = msg.find("%score%");
                while (ph != -1) { msg = msg.substr(0, ph) + string(p_points) + msg.substr(ph + 7); ph = msg.find("%score%"); }
                dlg_buffer(msg);
            }
            in_round = false;
            betAmount = 0;
            p_points = 0; d_points = 0;
            p_aces = 0; d_aces = 0;
            form.focus(dealButton);
        }
    }
}

void lotterygame()
{
    form.reset();
    form.create_window("Cookie Lottery", false);
    int inventoryBtn = form.create_button("&Check tickets");
    int scratchBtn = form.create_button("&Scratch Tickets");
    form.focus(inventoryBtn);
    while (true)
    {
        wait(5);
        form.monitor();
        if (autocookie <= 0) { bakemode = 0; autocookie = 0; }
        if (coins <= 0) coins = 0;
        if (cookies <= 0) cookies = 0;
        if (cookiespeed <= 0) cookiespeed = 0;
        if (manulcookie <= 0) manulcookie = 0;
        if (clicktime <= 50) clicktime = 50;
        if (clicktime >= 1000) clicktime = 1000;
        lottery_game_input();
        if (key_pressed(KEY_ESCAPE))
        {
            pool.destroy_sound(gameslot);
            mingamsmenu();
            return;
        }
        check_rank();
        check_achievements(loadedAchievements, achievementsUnlocked);
        if (form.is_pressed(scratchBtn))
        {
            lottery_scratch_menu();
            form.reset();
            lotterygame();
            return;
        }
        if (form.is_pressed(inventoryBtn))
        {
            double total = 0;
            for (uint i = 0; i < loadedTickets.length(); i++)
                total += loadedTickets[i].owned;
            if (total == 0)
                dlg_buffer("You don't have any tickets. Buy some from the shop!");
            else
                dlg_buffer("You have a total of " + format_number(total) + " " + (total == 1 ? "ticket" : "tickets") + " across all tiers.");
            form.focus(inventoryBtn);
        }
    }
}

void lottery_game_input() { minigame_input("lottery"); }

void jack_game_input() { minigame_input("blackjack"); }

void dicegame()
{
    form.reset();
    form.create_window("Dice Roller", false);
    int betChoice = form.create_list("Choose an item to &bet:", 5, false, false);
    form.add_list_item(betChoice, "Cookies");
    form.add_list_item(betChoice, "Currency");
    form.add_list_item(betChoice, "Auto Cookies");
    form.add_list_item(betChoice, "Auto Cookie Speeds");
    form.add_list_item(betChoice, "Manual Cookies");
    uint typeCount = diceConfig.dice_types.length();
    int diceTypeList = form.create_list("Dice &Type:", typeCount, false, false);
    for (uint i = 0; i < typeCount; i++)
        form.add_list_item(diceTypeList, "D" + string(diceConfig.dice_types[typeCount - 1 - i]), "", -1, false);
    int defaultTypeIdx = 0;
    for (uint i = 0; i < typeCount; i++)
        if (diceConfig.dice_types[typeCount - 1 - i] == 6) { defaultTypeIdx = i; break; }
    form.set_list_position(diceTypeList, defaultTypeIdx);
    int diceCountList = form.create_list("Dice &Number:", diceConfig.max_dice_count, false, false);
    for (int i = diceConfig.max_dice_count; i >= 1; i--)
        form.add_list_item(diceCountList, string(i) + (i == 1 ? " die" : " dice"), "", -1, false);
    form.set_list_position(diceCountList, diceConfig.max_dice_count - 6);
    int modifierList = form.create_list("Dice &Modifier:", diceConfig.modifiers.length(), false, false);
    uint modCount = diceConfig.modifiers.length();
    for (uint i = 0; i < modCount; i++)
    {
        int m = diceConfig.modifiers[modCount - 1 - i];
        string label = (m > 0 ? "+" : "") + string(m);
        form.add_list_item(modifierList, label, "", -1, false);
    }
    int defaultModIdx = 0;
    for (uint i = 0; i < modCount; i++)
        if (diceConfig.modifiers[modCount - 1 - i] == 0) { defaultModIdx = i; break; }
    form.set_list_position(modifierList, defaultModIdx);
    int betInput = form.create_input_box("Enter your b&et amount:", "", "", 0, false, false, false);
    int targetInput = form.create_input_box("Enter your &target score:", "", "", 0, false, false, false);
    int rollButton = form.create_button("&Roll", true);
    form.set_disallowed_chars(betInput, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ !@#$%^&*()[]{};:'\"\\|,<>?/+-=`~_", false, "This character is not allowed.");
    form.set_disallowed_chars(targetInput, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ !@#$%^&*()[]{};:'\"\\|,<>?/+-=`~_.", false, "This character is not allowed.");
    form.focus(betChoice);
    int selectedBet = 0;
    double betAmount = 0;
    string betItemName = "";
    while (true)
    {
        wait(5);
        form.monitor();
        if (autocookie <= 0) { bakemode = 0; autocookie = 0; }
        if (coins <= 0) coins = 0;
        if (cookies <= 0) cookies = 0;
        if (cookiespeed <= 0) cookiespeed = 0;
        if (manulcookie <= 0) manulcookie = 0;
        if (clicktime <= 50) clicktime = 50;
        if (clicktime >= 1000) clicktime = 1000;
        if (form.get_current_focus() != betInput && form.get_current_focus() != targetInput)
            dice_game_input();
        if (key_pressed(KEY_ESCAPE))
        {
            pool.destroy_sound(gameslot);
            mingamsmenu();
        }
        check_rank();
        check_achievements(loadedAchievements, achievementsUnlocked);
        if (form.is_pressed(rollButton))
        {
            selectedBet = form.get_list_position(betChoice);
            string betStr = form.get_text(betInput);
            double betNum = floor(selectedBet == 1 ? string_to_number(betStr) * 100.0 : string_to_number(betStr));
            if (betNum <= 0)
            {
                pool.play_stationary("sounds/misc/gamefail.ogg", false);
                dlg_buffer("Error! Please enter a valid bet amount.");
                continue;
            }
            if (betNum < diceConfig.min_bet)
            {
                pool.play_stationary("sounds/misc/gamefail.ogg", false);
                dlg_buffer("Error! The minimum bet is " + (selectedBet == 1 ? convert_to_currency(diceConfig.min_bet) : format_number(diceConfig.min_bet)) + ".");
                continue;
            }
            if (diceConfig.max_bet > 0 && betNum > diceConfig.max_bet)
            {
                pool.play_stationary("sounds/misc/gamefail.ogg", false);
                dlg_buffer("Your bet has been capped at the maximum of " + (selectedBet == 1 ? convert_to_currency(diceConfig.max_bet) : format_number(diceConfig.max_bet)) + ".");
                betNum = diceConfig.max_bet;
            }
            if (selectedBet == 0) betNum = min(betNum, floor(cookies));
            else if (selectedBet == 1) betNum = min(betNum, floor(coins));
            else if (selectedBet == 2) betNum = min(betNum, floor(autocookie));
            else if (selectedBet == 3) betNum = min(betNum, floor(cookiespeed));
            else if (selectedBet == 4) betNum = min(betNum, floor(manulcookie));
            if (betNum <= 0)
            {
                pool.play_stationary("sounds/misc/gamefail.ogg", false);
                dlg_buffer("Error! You don't have enough of that item to bet!");
                continue;
            }
            string targetStr = form.get_text(targetInput);
            int target = string_to_int(targetStr);
            if (target < diceConfig.min_target)
            {
                pool.play_stationary("sounds/misc/gamefail.ogg", false);
                dlg_buffer("Error! Please enter a minimum target score of at least " + string(diceConfig.min_target) + " to roll the dice.");
                continue;
            }
            int diceTypeIdx = form.get_list_position(diceTypeList);
            if (diceTypeIdx < 0) diceTypeIdx = 0;
            int sides = diceConfig.dice_types[typeCount - 1 - diceTypeIdx];
            int diceCountIdx = form.get_list_position(diceCountList);
            if (diceCountIdx < 0) diceCountIdx = 0;
            int diceCount = diceConfig.max_dice_count - diceCountIdx;
            int modifierIdx = form.get_list_position(modifierList);
            if (modifierIdx < 0) modifierIdx = defaultModIdx;
            int modifier = diceConfig.modifiers[modCount - 1 - modifierIdx];
            int maxPossible = (sides * diceCount) + modifier;
            if (diceConfig.max_target > 0 && target > diceConfig.max_target)
            {
                pool.play_stationary("sounds/misc/gamefail.ogg", false);
                dlg_buffer("Error! The maximum target is " + string(diceConfig.max_target) + ".");
                continue;
            }
            if (target > maxPossible)
            {
                pool.play_stationary("sounds/misc/gamefail.ogg", false);
                dlg_buffer("Warning! Your target of " + string(target) + " is impossible to reach with " + string(diceCount) + " D" + string(sides) + " and a modifier of " + string(modifier) + ". The maximum possible roll is " + string(maxPossible) + ".");
                continue;
            }
            if (diceConfig.confirm_threshold > 0)
            {
                double statTotal = (selectedBet == 0 ? floor(cookies) : (selectedBet == 1 ? floor(coins) : (selectedBet == 2 ? floor(autocookie) : (selectedBet == 3 ? floor(cookiespeed) : floor(manulcookie)))));
                double effectiveThreshold = diceConfig.confirm_use_percent ? (statTotal * (diceConfig.confirm_threshold / 100.0)) : diceConfig.confirm_threshold;
                if (betNum >= effectiveThreshold)
                {
                    string betItemName2 = (selectedBet == 0 ? "cookies" : (selectedBet == 1 ? "currency" : (selectedBet == 2 ? "auto cookies" : (selectedBet == 3 ? "auto cookie speeds" : "manual cookies"))));
                    setupmenu(false);
                    m.add_item("Yes", "yes");
                    m.add_item("No", "no");
                    m.intro_text = "Are you sure you want to bet " + (selectedBet == 1 ? convert_to_currency(betNum) : format_number(betNum) + " " + betItemName2) + "?";
                    int cres = m.run(0, true);
                    string csel = m.get_item_id(cres);
                    if (cres == -1 || csel == "no")
                        continue;
                }
            }
            betAmount = betNum;
            betItemName = (selectedBet == 0 ? "cookies" : (selectedBet == 1 ? "" : (selectedBet == 2 ? "auto cookies" : (selectedBet == 3 ? "auto cookie speeds" : "manual cookies"))));
            if (selectedBet == 0) { cookies -= betAmount; cookies = floor(safe_cap(cookies)); }
            else if (selectedBet == 1) { coins -= betAmount; coins = floor(safe_cap(coins)); }
            else if (selectedBet == 2) { autocookie -= betAmount; autocookie = floor(safe_cap(autocookie)); }
            else if (selectedBet == 3) { cookiespeed -= betAmount; clicktime += betAmount; cookiespeed = floor(safe_cap(cookiespeed)); }
            else if (selectedBet == 4) { manulcookie -= betAmount; manulcookie = floor(safe_cap(manulcookie)); }
            pool.play_stationary("sounds/minigames/" + resolve_sound(diceConfig.shake_sound), false);
            if (dicemode)
                mini_wait_async(random(1000, 2000), "dice");
            else
                dlg_buffer("Rolling. Press enter or space to reveal.");
            pool.play_stationary("sounds/minigames/" + resolve_sound(diceConfig.land_sound), false);
            int total = 0;
            string rollDetails = "";
            for (int i = 0; i < diceCount; i++)
            {
                int roll = random(1, sides);
                total += roll;
                rollDetails += string(roll) + (i < diceCount - 1 ? ", " : "");
            }
            total += modifier;
            stat_dice_rolls++;
            int margin = total - target;
            dice_payout@ payout = pick_dice_payout(margin);
            if (payout is null)
            {
                dlg_buffer("Something went wrong reading the payout table.");
                continue;
            }
            string modStr = (modifier > 0 ? "+" : "") + string(modifier);
            string modifierText = "";
            if (modifier > 0) modifierText = "plus " + string(modifier);
            else if (modifier < 0) modifierText = "minus " + string(abs(modifier));
            string rollSummary = "The dice show: " + rollDetails + (modifier != 0 ? ", with a modifier of " + modifierText : "") + ", for a total score of " + string(total) + ", with a target score of " + string(target) + ".";
            pool.play_stationary("sounds/minigames/" + resolve_sound(payout.sound), false);
            if (payout.multiplier <= 0)
            {
                stat_dice_losses++;
                string msg = payout.message;
                int ph = msg.find("%roll%");
                while (ph != -1) { msg = msg.substr(0, ph) + string(total) + msg.substr(ph + 6); ph = msg.find("%roll%"); }
                ph = msg.find("%target%");
                while (ph != -1) { msg = msg.substr(0, ph) + string(target) + msg.substr(ph + 8); ph = msg.find("%target%"); }
                ph = msg.find("%margin%");
                while (ph != -1) { msg = msg.substr(0, ph) + string(abs(margin)) + msg.substr(ph + 8); ph = msg.find("%margin%"); }
                dlg_buffer(rollSummary + " " + msg);
            }
            else
            {
                stat_dice_wins++;
                double winAmount = floor(safe_cap(betAmount * payout.multiplier));
                string amtStr = (selectedBet == 1 ? convert_to_currency(winAmount) : format_number(winAmount));
                if (selectedBet == 0) { cookies += winAmount; cookies = floor(safe_cap(cookies)); }
                else if (selectedBet == 1) { coins += winAmount; coins = floor(safe_cap(coins)); stat_coins_earned += winAmount; }
                else if (selectedBet == 2) { autocookie += winAmount; autocookie = floor(safe_cap(autocookie)); }
                else if (selectedBet == 3) { cookiespeed += winAmount; clicktime -= winAmount; if (cookiespeed < 0) cookiespeed = 0; if (clicktime < 50) clicktime = 50; cookiespeed = floor(safe_cap(cookiespeed)); }
                else if (selectedBet == 4) { manulcookie += winAmount; manulcookie = floor(safe_cap(manulcookie)); }
                string msg = payout.message;
                int ph = msg.find("%roll%");
                while (ph != -1) { msg = msg.substr(0, ph) + string(total) + msg.substr(ph + 6); ph = msg.find("%roll%"); }
                ph = msg.find("%target%");
                while (ph != -1) { msg = msg.substr(0, ph) + string(target) + msg.substr(ph + 8); ph = msg.find("%target%"); }
                ph = msg.find("%margin%");
                while (ph != -1) { msg = msg.substr(0, ph) + string(margin) + msg.substr(ph + 8); ph = msg.find("%margin%"); }
                ph = msg.find("%amount%");
                while (ph != -1) { msg = msg.substr(0, ph) + amtStr + msg.substr(ph + 8); ph = msg.find("%amount%"); }
                ph = msg.find("%item%");
                while (ph != -1)
                {
                    string itemStr = betItemName;
                    int start = (itemStr == "" && ph > 0 && msg.substr(ph - 1, 1) == " ") ? ph - 1 : ph;
                    msg = msg.substr(0, start) + itemStr + msg.substr(ph + 6);
                    ph = msg.find("%item%");
                }
                dlg_buffer(rollSummary + " " + msg);
            }
        }
    }
}

void dice_game_input() { minigame_input("dice"); }

void highlow_draw(string &out cardName, int &out cardVal)
{
    int idx = random(0, highlowConfig.deck.length() - 1);
    cardName = highlowConfig.deck[idx].name;
    cardVal = highlowConfig.deck[idx].value;
    if (!highlowConfig.ace_high && cardName == "ace") cardVal = 1;
}

string highlow_fill(string msg, string token, string value)
{
    int ph = msg.find(token);
    while (ph != -1)
    {
        int start = (value == "" && ph > 0 && msg.substr(ph - 1, 1) == " ") ? ph - 1 : ph;
        msg = msg.substr(0, start) + value + msg.substr(ph + int(token.length()));
        ph = msg.find(token);
    }
    return msg;
}

void highlowgame()
{
    form.reset();
    form.create_window("Higher or Lower", false);
    int betChoice = form.create_list("Choose an &item to bet:", 5);
    form.add_list_item(betChoice, "Cookies");
    form.add_list_item(betChoice, "Currency");
    form.add_list_item(betChoice, "Auto Cookies");
    form.add_list_item(betChoice, "Auto Cookie Speeds");
    form.add_list_item(betChoice, "Manual Cookies");
    int betInput = form.create_input_box("Enter your &bet amount:", "", "", 0, false, false, false);
    int dealButton = form.create_button("&Deal", true);
    int higherButton = form.create_button("&Higher");
    int lowerButton = form.create_button("&Lower");
    int cashButton = form.create_button("&Cash out");
    form.set_disallowed_chars(betInput, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ !@#$%^&*()[]{};:'\"\\|,<>?/+-=`~_", false, "This character is not allowed.");
    form.focus(betChoice);
    int selectedBet = 0;
    double betAmount = 0;
    string betItemName = "";
    bool in_round = false;
    int streak = 0;
    double currentMultiplier = 0;
    string curName = "";
    int curVal = 0;
    while (true)
    {
        wait(5);
        form.monitor();
        if (autocookie <= 0) { bakemode = 0; autocookie = 0; }
        if (coins <= 0) coins = 0;
        if (cookies <= 0) cookies = 0;
        if (cookiespeed <= 0) cookiespeed = 0;
        if (manulcookie <= 0) manulcookie = 0;
        if (clicktime <= 50) clicktime = 50;
        if (clicktime >= 1000) clicktime = 1000;
        if (form.get_current_focus() != betInput)
            highlow_game_input();
        if (key_pressed(KEY_ESCAPE))
        {
            pool.destroy_sound(gameslot);
            mingamsmenu();
        }
        check_rank();
        check_achievements(loadedAchievements, achievementsUnlocked);
        if (key_pressed(KEY_B))
        {
            if (!in_round)
                speak_buffer("You are not in a round, so place a bet and deal to begin.");
            else
            {
                double potNow = floor(safe_cap(betAmount * currentMultiplier));
                string potStr = (streak < 1) ? "nothing yet" : ((selectedBet == 1) ? convert_to_currency(potNow) : (format_number(potNow) + (betItemName != "" ? " " + betItemName : "")));
                speak_buffer("Your streak is " + streak + ", your pot is " + potStr + ", and the last card was the " + curName + ".");
            }
        }
        if (form.is_pressed(dealButton))
        {
            if (in_round)
            {
                dlg_buffer("You are already in a round. Guess higher or lower, or cash out.");
                continue;
            }
            selectedBet = form.get_list_position(betChoice);
            string betStr = form.get_text(betInput);
            double betNum = floor(selectedBet == 1 ? string_to_number(betStr) * 100.0 : string_to_number(betStr));
            if (betNum <= 0)
            {
                pool.play_stationary("sounds/misc/gamefail.ogg", false);
                dlg_buffer("Error! Please enter a valid bet amount.");
                continue;
            }
            if (betNum < highlowConfig.min_bet)
            {
                pool.play_stationary("sounds/misc/gamefail.ogg", false);
                dlg_buffer("Error! The minimum bet is " + (selectedBet == 1 ? convert_to_currency(highlowConfig.min_bet) : format_number(highlowConfig.min_bet)) + ".");
                continue;
            }
            if (highlowConfig.max_bet > 0 && betNum > highlowConfig.max_bet)
            {
                pool.play_stationary("sounds/misc/gamefail.ogg", false);
                dlg_buffer("Your bet has been capped at the maximum of " + (selectedBet == 1 ? convert_to_currency(highlowConfig.max_bet) : format_number(highlowConfig.max_bet)) + ".");
                betNum = highlowConfig.max_bet;
            }
            if (selectedBet == 0) betNum = min(betNum, floor(cookies));
            else if (selectedBet == 1) betNum = min(betNum, floor(coins));
            else if (selectedBet == 2) betNum = min(betNum, floor(autocookie));
            else if (selectedBet == 3) betNum = min(betNum, floor(cookiespeed));
            else if (selectedBet == 4) betNum = min(betNum, floor(manulcookie));
            if (betNum <= 0)
            {
                pool.play_stationary("sounds/misc/gamefail.ogg", false);
                dlg_buffer("Error! You don't have enough of that item to bet!");
                continue;
            }
            if (highlowConfig.confirm_threshold > 0)
            {
                double statTotal = (selectedBet == 0 ? floor(cookies) : (selectedBet == 1 ? floor(coins) : (selectedBet == 2 ? floor(autocookie) : (selectedBet == 3 ? floor(cookiespeed) : floor(manulcookie)))));
                double effectiveThreshold = highlowConfig.confirm_use_percent ? (statTotal * (highlowConfig.confirm_threshold / 100.0)) : highlowConfig.confirm_threshold;
                if (betNum >= effectiveThreshold)
                {
                    string betItemName2 = (selectedBet == 0 ? "cookies" : (selectedBet == 1 ? "currency" : (selectedBet == 2 ? "auto cookies" : (selectedBet == 3 ? "auto cookie speeds" : "manual cookies"))));
                    setupmenu(false);
                    m.add_item("Yes", "yes");
                    m.add_item("No", "no");
                    m.intro_text = "Are you sure you want to bet " + (selectedBet == 1 ? convert_to_currency(betNum) : format_number(betNum) + " " + betItemName2) + "?";
                    int cres = m.run(0, true);
                    string csel = m.get_item_id(cres);
                    if (cres == -1 || csel == "no")
                        continue;
                }
            }
            betAmount = betNum;
            betItemName = (selectedBet == 0 ? "cookies" : (selectedBet == 1 ? "" : (selectedBet == 2 ? "auto cookies" : (selectedBet == 3 ? "auto cookie speeds" : "manual cookies"))));
            if (selectedBet == 0) { cookies -= betAmount; cookies = floor(safe_cap(cookies)); }
            else if (selectedBet == 1) { coins -= betAmount; coins = floor(safe_cap(coins)); }
            else if (selectedBet == 2) { autocookie -= betAmount; autocookie = floor(safe_cap(autocookie)); }
            else if (selectedBet == 3) { cookiespeed -= betAmount; clicktime += betAmount; cookiespeed = floor(safe_cap(cookiespeed)); }
            else if (selectedBet == 4) { manulcookie -= betAmount; manulcookie = floor(safe_cap(manulcookie)); }
            in_round = true;
            streak = 0;
            currentMultiplier = 0;
            stat_highlow_games++;
            highlow_draw(curName, curVal);
            pool.play_stationary("sounds/minigames/" + resolve_sound(highlowConfig.draw_sound), false);
            if (highlowmode) mini_wait_async(random(1000, 2000), "highlow");
            string smsg = highlow_fill(highlowConfig.start_message, "%card%", curName);
            if (highlowmode) speak_buffer(smsg);
            else dlg_buffer(smsg);
            form.focus(higherButton);
        }
        bool guessPressed = false;
        bool guessHigher = false;
        if (form.is_pressed(higherButton)) { guessPressed = true; guessHigher = true; }
        else if (form.is_pressed(lowerButton)) { guessPressed = true; guessHigher = false; }
        if (guessPressed)
        {
            if (!in_round)
            {
                dlg_buffer("Please place a bet and deal first.");
                continue;
            }
            pool.play_stationary("sounds/minigames/" + resolve_sound(highlowConfig.draw_sound), false);
            if (highlowmode) mini_wait_async(random(1000, 2000), "highlow");
            string nextName = "";
            int nextVal = 0;
            highlow_draw(nextName, nextVal);
            int outcome = 0;
            if (nextVal == curVal) outcome = 0;
            else if ((nextVal > curVal) == guessHigher) outcome = 1;
            else outcome = -1;
            if (outcome == 0 && highlowConfig.tie_rule == "win") outcome = 1;
            else if (outcome == 0 && highlowConfig.tie_rule == "lose") outcome = -1;
            if (outcome == 0)
            {
                curName = nextName;
                curVal = nextVal;
                string tmsg = highlow_fill(highlowConfig.tie_message, "%card%", nextName);
                tmsg = highlow_fill(tmsg, "%streak%", string(streak));
                if (highlowmode) speak_buffer(tmsg);
                else dlg_buffer(tmsg);
                form.focus(higherButton);
            }
            else if (outcome == 1)
            {
                streak++;
                currentMultiplier = highlowConfig.starting_multiplier + (streak - 1) * highlowConfig.streak_multiplier_growth;
                if (double(streak) > stat_highlow_highest_streak) stat_highlow_highest_streak = streak;
                curName = nextName;
                curVal = nextVal;
                pool.play_stationary("sounds/minigames/" + resolve_sound(highlowConfig.correct_sound), false);
                if (streak >= 3 && highlowConfig.streak_sound != "") pool.play_stationary("sounds/minigames/" + resolve_sound(highlowConfig.streak_sound), false);
                double pot = floor(safe_cap(betAmount * currentMultiplier));
                string potStr = (selectedBet == 1) ? convert_to_currency(pot) : format_number(pot);
                bool forced = (highlowConfig.max_streak > 0 && streak >= highlowConfig.max_streak);
                if (forced)
                {
                    if (highlowmode) speak_buffer("Correct, and you reached the maximum streak of " + streak + "!");
                    else dlg_buffer("Correct, and you reached the maximum streak of " + streak + "!");
                    if (selectedBet == 0) { cookies += pot; cookies = floor(safe_cap(cookies)); }
                    else if (selectedBet == 1) { coins += pot; coins = floor(safe_cap(coins)); stat_coins_earned += pot; }
                    else if (selectedBet == 2) { autocookie += pot; autocookie = floor(safe_cap(autocookie)); }
                    else if (selectedBet == 3) { cookiespeed += pot; clicktime -= pot; if (cookiespeed < 0) cookiespeed = 0; if (clicktime < 50) clicktime = 50; cookiespeed = floor(safe_cap(cookiespeed)); }
                    else if (selectedBet == 4) { manulcookie += pot; manulcookie = floor(safe_cap(manulcookie)); }
                    stat_highlow_wins++;
                    pool.play_stationary("sounds/minigames/" + resolve_sound(highlowConfig.win_sound), false);
                    string vmsg = highlow_fill(highlowConfig.win_message, "%streak%", string(streak));
                    vmsg = highlow_fill(vmsg, "%payout%", potStr);
                    vmsg = highlow_fill(vmsg, "%item%", betItemName);
                    dlg_buffer(vmsg);
                    in_round = false;
                    betAmount = 0;
                    streak = 0;
                    currentMultiplier = 0;
                    form.focus(dealButton);
                }
                else
                {
                    string cmsg = highlow_fill(highlowConfig.correct_message, "%card%", nextName);
                    cmsg = highlow_fill(cmsg, "%streak%", string(streak));
                    cmsg = highlow_fill(cmsg, "%payout%", potStr);
                    cmsg = highlow_fill(cmsg, "%item%", betItemName);
                    if (highlowmode) speak_buffer(cmsg);
                    else dlg_buffer(cmsg);
                    form.focus(higherButton);
                }
            }
            else
            {
                stat_highlow_losses++;
                int brokenStreak = streak;
                pool.play_stationary("sounds/minigames/" + resolve_sound(highlowConfig.wrong_sound), false);
                string wmsg = highlow_fill(highlowConfig.wrong_message, "%card%", nextName);
                wmsg = highlow_fill(wmsg, "%streak%", string(brokenStreak));
                string betStr2 = (selectedBet == 1) ? convert_to_currency(betAmount) : format_number(betAmount);
                wmsg = highlow_fill(wmsg, "%bet%", betStr2);
                wmsg = highlow_fill(wmsg, "%item%", betItemName);
                if (highlowmode) speak_buffer(wmsg);
                else dlg_buffer(wmsg);
                in_round = false;
                betAmount = 0;
                streak = 0;
                currentMultiplier = 0;
                form.focus(dealButton);
            }
        }
        if (form.is_pressed(cashButton))
        {
            if (!in_round)
            {
                dlg_buffer("Please place a bet and deal first.");
                continue;
            }
            if (streak < 1)
            {
                dlg_buffer("You need at least one correct guess before you can cash out.");
                continue;
            }
            double pot = floor(safe_cap(betAmount * currentMultiplier));
            if (selectedBet == 0) { cookies += pot; cookies = floor(safe_cap(cookies)); }
            else if (selectedBet == 1) { coins += pot; coins = floor(safe_cap(coins)); stat_coins_earned += pot; }
            else if (selectedBet == 2) { autocookie += pot; autocookie = floor(safe_cap(autocookie)); }
            else if (selectedBet == 3) { cookiespeed += pot; clicktime -= pot; if (cookiespeed < 0) cookiespeed = 0; if (clicktime < 50) clicktime = 50; cookiespeed = floor(safe_cap(cookiespeed)); }
            else if (selectedBet == 4) { manulcookie += pot; manulcookie = floor(safe_cap(manulcookie)); }
            stat_highlow_wins++;
            pool.play_stationary("sounds/minigames/" + resolve_sound(highlowConfig.win_sound), false);
            string potStr = (selectedBet == 1) ? convert_to_currency(pot) : format_number(pot);
            string vmsg = highlow_fill(highlowConfig.win_message, "%streak%", string(streak));
            vmsg = highlow_fill(vmsg, "%payout%", potStr);
            vmsg = highlow_fill(vmsg, "%item%", betItemName);
            dlg_buffer(vmsg);
            in_round = false;
            betAmount = 0;
            streak = 0;
            currentMultiplier = 0;
            form.focus(dealButton);
        }
    }
}

void highlow_game_input() { minigame_input("highlow"); }
