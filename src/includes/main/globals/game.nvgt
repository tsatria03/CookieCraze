void clickergame()
{
form.reset();
form.create_window("CookieCraze", false);
int manulbake=form.create_button("&Bake cookies");
int shop=form.create_button("Cookie &store");
int autobake=form.create_button("Enter baking m&ode");
int achievementsBtn = form.create_button("&Achievements");
int manageSlots = form.create_button("Baking slots &manager");
int boostSlots = form.create_button("Boost slot ma&nager");
int infoBtn=form.create_button("Baker &Info");
int minigames=form.create_button("Mini &games");
int questsBtn=form.create_button("&Quests");
int statsBtn=form.create_button("S&tatistics");
int preffs=form.create_button("P&references");
form.focus(manulbake);
while(true)
{
wait(5);
form.monitor();
update_boosts();
clicker_game_input();
autocookie = floor(safe_cap(autocookie));
if(autocookie<=0)
{
bakemode=0;
autocookie=0;
}
coins = floor(safe_cap(coins));
if(coins<=0)
{
coins=0;
}
cookies = floor(safe_cap(cookies));
if(cookies<=0)
{
cookies=0;
}
cookiespeed = floor(safe_cap(cookiespeed));
if(cookiespeed<=0)
{
cookiespeed=0;
}
if(cookiespeed>COOKIESPEED_MAX)
{
cookiespeed=COOKIESPEED_MAX;
}
manulcookie = floor(safe_cap(manulcookie));
if(manulcookie<=0)
{
manulcookie=0;
}
stat_cookies_baked = safe_cap(stat_cookies_baked);
cookieXP = safe_cap(cookieXP);
stat_coins_earned = safe_cap(stat_coins_earned);
stat_coins_spent = safe_cap(stat_coins_spent);
if(clicktime<=50)
{
clicktime=50;
}
if(clicktime>=1000)
{
clicktime=1000;
}
        if (form.is_pressed(manageSlots))
        {
manage_baking_slots();
        }
        // Always open, like the baking slots manager; its options say they are locked until rank boostUnlockRank.
        if (form.is_pressed(boostSlots))
            boost_slot_manager();
        if (form.is_pressed(achievementsBtn))
        {
            achievements_menu(loadedAchievements, achievementsUnlocked, loadedAchievementCategories);
            form.reset();
            clickergame();
        }
if (form.is_pressed(minigames))
{
mingamsmenu();
}
if (form.is_pressed(questsBtn))
{
questsmenu();
}
if (form.is_pressed(preffs))
{
preffsmenu();
}
if (form.is_pressed(infoBtn))
{
show_baker_info();
}
if (form.is_pressed(statsBtn))
{
infomenu();
}
if(form.is_pressed(autobake))
{
if(autocookie<1)
{
speak_buffer("You need at least 1 auto cookie to enable baking mode.", "general");
}
else if(autocookie>=1)
{
if(bakemode==0)
{
bakemode=1;
pool.play_stationary("sounds/misc/toggleon.ogg", false);
speak_buffer("Baking mode enabled.", "misc");
}
else if(bakemode==1)
{
bakemode=0;
pool.play_stationary("sounds/misc/toggleoff.ogg", false);
speak_buffer("Baking mode disabled.", "misc");
}
}
}
if(form.is_pressed(manulbake))
{
if(manulcookie<1)
{
speak_buffer("You need at least 1 manual cookie to start baking cookies.", "general");
}
else if(manulcookie>=1)
{
    double manualGain = 0;
    // Each manual slot adds your full manual cookies to every press.
    if (manualSlots > 0)
        manualGain = manulcookie * manualSlots;
    else
        manualGain = manulcookie;
    if (prestige_cookie_multiplier > 0) manualGain *= 1.0 + (prestige_cookie_multiplier / 100.0);
    if (combosConfig.enabled && rank >= combosConfig.enabled_rank)
    {
        if (comboCount == 0)
        {
            if (preComboTimer.elapsed >= comboWindow)
            {
                preComboCount = 0;
                preComboTarget = random(combosConfig.start_count_min, combosConfig.start_count_max);
            }
            if (preComboCount == 0) preComboTarget = random(combosConfig.start_count_min, combosConfig.start_count_max);
            preComboCount++;
            preComboTimer.restart();
            if (preComboCount >= preComboTarget)
            {
                preComboCount = 0;
                comboCount = preComboTarget;
                comboWindow = random(combosConfig.combo_window_min, combosConfig.combo_window_max);
                combotimer.restart();
                stat_combos_started++;
                if (combosConfig.start_sound != "" && !buffer_muted("combos")) pool.play_stationary("sounds/" + combosConfig.start_sound, false);
                speak_buffer(combosConfig.start_message, "combos");
            }
        }
        else
        {
            comboCount++;
            if (comboCount > stat_highest_combo_reached) stat_highest_combo_reached = comboCount;
            if (comboCount > sessionHighestCombo) sessionHighestCombo = comboCount;
            comboWindow = random(combosConfig.combo_window_min, combosConfig.combo_window_max);
            combotimer.restart();
            double comboMult = get_combo_multiplier(comboCount);
            manualGain *= comboMult;
            int tierIdx = get_combo_tier_index(comboCount);
            if (tierIdx > lastComboTierIndex && tierIdx >= 0)
            {
                lastComboTierIndex = tierIdx;
                combo_tier_item@ tier = combosConfig.tiers[tierIdx];
                if (tier.sound != "" && !buffer_muted("combos")) pool.play_stationary("sounds/" + tier.sound, false);
                if (tier.message != "") speak_buffer(format_combo_message(tier.message, comboCount, comboMult), "combos");
            }
            else if (comborepeats && tierIdx == int(combosConfig.tiers.length()) - 1 && combo_repeat_period() > 0)
            {
                // Past the last tier: replay the tier sounds in their cycle, with the table's optional repeat message.
                int repeatTier = -1;
                while (combo_repeat_count(comboRepeatsFired + 1) <= comboCount)
                {
                    comboRepeatsFired++;
                    repeatTier = (comboRepeatsFired - 1) % int(combosConfig.tiers.length());
                }
                if (repeatTier >= 0)
                {
                    combo_tier_item@ rtier = combosConfig.tiers[repeatTier];
                    if (rtier.sound != "" && !buffer_muted("combos")) pool.play_stationary("sounds/" + rtier.sound, false);
                    if (combosConfig.repeat_message != "") speak_buffer(format_combo_message(combosConfig.repeat_message, comboCount, comboMult), "combos");
                }
            }
        }
    }
    cookies += manualGain;
stat_cookies_baked += manualGain;
cookieXP += manualGain * cookieExpMod;
stat_manual_bakes_performed++;
pool.play_stationary("sounds/misc/manulbake.ogg", false);
// Events can no longer be switched off in the settings; main.table's manual_event_chance of 0 is the only off switch.
attempt_manebaker_event(evchanse2);
}
}
if(form.is_pressed(shop))
{
/* Selling cookies lives inside the store, so cookies alone are enough to get in; otherwise a player
who spent all their money had no way to sell their way back to any. Purchases inside check affordability themselves. */
if(coins<1 && cookies<1)
{
speak_buffer("You need at least 1 cent or 1 cookie to enter the cookie store.", "general");
}
else
{
ambpool.destroy_sound(ambslot);
muspool.destroy_sound(mustrackslot);
speak_buffer("You're now entering the cookie store.", "misc");
dlgplay("sounds/store/door_open.ogg");
alertslot=pool.play_stationary("sounds/store/welcome.ogg",false);
storambslot=storambpool.play_stationary_extended("sounds/store/amb.ogg",true,0,0,storambvolume,storambpitch,false);
stortrackslot=stormuspool.play_stationary_extended("sounds/store/music.ogg",true,0,0,stormusvolume,stormuspitch,false);
shopmenu();
}
}
if(bakemode==1 and autocookie>=1)
{
if(clicktimer.elapsed>=clicktime)
{
double autoGain = 0;
if (autobakeSlots > 0)
{
// Every automated slot bakes your full auto cookies.
double perSlot = autocookie;
        for (uint i = 0; i < autobakeSlotEnabled.length(); i++)
{
            if (autobakeSlotEnabled[i])
{
autoGain += perSlot;
}
}
}
else
{
autoGain = autocookie;
}
if (prestige_cookie_multiplier > 0) autoGain *= 1.0 + (prestige_cookie_multiplier / 100.0);
cookies += autoGain;
stat_cookies_baked += autoGain;
cookieXP += autoGain * cookieExpMod;
stat_auto_bakes_performed++;
if(bakesfx==true) pool.play_stationary("sounds/misc/autobake.ogg", false);
attempt_autobaker_event(evchanse);
clicktimer.restart();
}
else if(bakemode==1 and autocookie<=0)
{
bakemode=0;
pool.destroy_all();
}
}
if (combosConfig.enabled && rank >= combosConfig.enabled_rank && comboCount > 0 && combotimer.elapsed >= comboWindow)
{
    string breakMsg = format_combo_message(combosConfig.stop_message, comboCount, get_combo_multiplier(comboCount));
    comboCount = 0;
    lastComboTierIndex = -1;
    comboRepeatsFired = 0;
    stat_combos_broken++;
    if (combosConfig.stop_sound != "" && !buffer_muted("combos")) pool.play_stationary("sounds/" + combosConfig.stop_sound, false);
    speak_buffer(breakMsg, "combos");
}
// Rank ups share one function with the minigames (ranks_table.nvgt).
check_rank();
check_achievements(loadedAchievements, achievementsUnlocked);
}
}

void clicker_game_input()
{
if(key_repeating(KEY_COMMA))
{
if (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
{
top_buffer_item();
}
else
{
previous_buffer_item();
}
}
if(key_repeating(KEY_PERIOD))
{
if (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
{
bottom_buffer_item();
}
else
{
next_buffer_item();
}
}
if(key_repeating(KEY_LBRACKET))
{
if (shift_is_down())
{
top_buffer();
}
else
{
previous_buffer();
}
}
if(key_repeating(KEY_RBRACKET))
{
if (shift_is_down())
{
bottom_buffer();
}
else
{
next_buffer();
}
}
if (shift_is_down())
{
if (key_repeating(KEY_M))
{
toggle_buffer();
}
if (key_repeating(KEY_C))
{
copy_buffer_item();
}
if (key_repeating(KEY_BACKSLASH))
{
if (export_current_buffer())
{
clear_current_buffer();
}
}
}
if(control_is_down())
{
if(key_pressed(KEY_S))
{
writedata();
ambpool.pause_sound(ambslot);
muspool.pause_sound(mustrackslot);
speak_buffer("game saved", "misc");
if(savesfx==false) wait(500);
if(savesfx==true) dlgplay("sounds/misc/savegame.ogg");
ambpool.resume_sound(ambslot);
muspool.resume_sound(mustrackslot);
form.reset();
clickergame();
}
if(key_pressed(KEY_L))
{
/* A new game is not written to disk until its first save, so there may be no file to reload yet.
Loading a missing file used to run readdata's resets on nothing, clearing baking slots and achievements
and resetting experience. Without a save, only the config files are reloaded. */
bool hasSave = file_exists(currentSaveSlot);
if (hasSave) readdata();
reload_config(true);
ambpool.pause_sound(ambslot);
muspool.pause_sound(mustrackslot);
if (hasSave) speak_buffer("game reloaded", "misc");
else speak_buffer("This game has not been saved yet, so only the configuration files were reloaded.", "misc");
if(savesfx==false) wait(500);
if(savesfx==true) dlgplay("sounds/misc/savegame.ogg");
ambpool.resume_sound(ambslot);
muspool.resume_sound(mustrackslot);
form.reset();
clickergame();
}
}
// Plain M and C only, since Shift M mutes the buffer and Shift C copies the buffer item above.
if(!shift_is_down() && key_pressed(KEY_M)) announce_money();
// Same stat keys as inside the minigames. Plain S only, since Control S saves.
if(key_pressed(KEY_A)) announce_auto_cookies();
if(!control_is_down() && key_pressed(KEY_S)) announce_baking_speed();
if(key_pressed(KEY_N)) announce_manual_cookies();
if(key_pressed(KEY_R))
{
double xpNeeded = xprequired - cookieXP;
speak_buffer("You're currently rank " + format_number(rank) + " with " + format_number(cookieXP) + " experience. Your next rank requires " + format_number(ceil(xpNeeded)) + " experience.", "misc");
}
if(key_pressed(KEY_P))
{
string pointWord = (prestige_points == 1) ? "point" : "points";
speak_buffer("You have " + format_number(prestige_points) + " prestige " + pointWord + " to spend in the prestige store.", "misc");
}
if(!control_is_down() && key_pressed(KEY_L))
{
speak_buffer("You're currently on prestige level " + format_number(prestigeLevel) + ".", "misc");
}
if (key_pressed(KEY_F))
{
    int slotCount = 0;
    for (uint i = 0; i < autobakeSlotEnabled.length(); i++)
    {
        if (autobakeSlotEnabled[i])
            slotCount++;
    }
    /* Mirrors the auto bake in the main loop, prestige cookie bonus included, and names both numbers:
    what each automated slot makes and what you make in total. */
    double bonus = (prestige_cookie_multiplier > 0) ? 1.0 + (prestige_cookie_multiplier / 100.0) : 1.0;
    string period = "per second";
    if (clicktime != 1000) period = "every " + clicktime + " milliseconds";
    if (slotCount > 0)
    {
        double cookiesPerSlot = autocookie * bonus;
        double totalCookies = autocookie * slotCount * bonus;
        string slotWord = (slotCount == 1) ? "slot" : "slots";
        string perSlotWord = (cookiesPerSlot == 1) ? "cookie" : "cookies";
        string totalWord = (totalCookies == 1) ? "cookie" : "cookies";
        speak_buffer("Each automated slot produces " + format_number(cookiesPerSlot) + " " + perSlotWord + " " + period + ". With " + format_number(slotCount) + " automated " + slotWord + ", you produce " + format_number(totalCookies) + " " + totalWord + " " + period + " in total.", "misc");
    }
    else
    {
        double totalCookies = autocookie * bonus;
        string autoWord = (totalCookies == 1) ? "cookie" : "cookies";
        speak_buffer("You produce " + format_number(totalCookies) + " " + autoWord + " " + period + ".", "misc");
    }
}
if(!shift_is_down() && key_pressed(KEY_C))
{
string cookieCountWord = (cookies == 1) ? "cookie" : "cookies";
speak_buffer("You have " + format_number(cookies) + " " + cookieCountWord + ".", "misc");
}
if(key_pressed(KEY_J))
{
    /* Mirrors the manual bake, prestige cookie bonus included, and describes manual slots the same way
    F describes automated ones. Combo multipliers are left out, since they only last while a combo runs. */
    double bonus = (prestige_cookie_multiplier > 0) ? 1.0 + (prestige_cookie_multiplier / 100.0) : 1.0;
    if (manualSlots > 0)
    {
        double perSlot = manulcookie * bonus;
        double totalManual = manulcookie * manualSlots * bonus;
        string perSlotWord = (perSlot == 1) ? "cookie" : "cookies";
        string totalWord = (totalManual == 1) ? "cookie" : "cookies";
        string slotWord = (manualSlots == 1) ? "slot" : "slots";
        speak_buffer("Each manual slot produces " + format_number(perSlot) + " " + perSlotWord + " per press. With " + format_number(manualSlots) + " manual " + slotWord + ", you produce " + format_number(totalManual) + " " + totalWord + " per press in total.", "misc");
    }
    else
    {
        double totalManual = manulcookie * bonus;
        string cookieWord = (totalManual == 1) ? "cookie" : "cookies";
        speak_buffer("You produce " + format_number(totalManual) + " " + cookieWord + " per press.", "misc");
    }
}
// B speaks every running boost and its time left. Alt plus B bakes, so B only counts without Alt.
if(!alt_is_down() && key_pressed(KEY_B)) speak_buffer(boost_status_text(), "misc");
if(key_pressed(KEY_F1)) toggle_buffer_by_name("achievements");
if(key_pressed(KEY_F2)) toggle_buffer_by_name("combos");
if(key_pressed(KEY_F3)) toggle_buffer_by_name("events");
if(key_pressed(KEY_F5)) toggle_buffer_by_name("boosts");
if(key_pressed(KEY_F4))
{
if(alt_is_down())
{
ambpool.destroy_sound(ambslot);
muspool.destroy_sound(mustrackslot);
pool.destroy_all();
speak_buffer("Exiting the game without saving.");
if(exitsfx==false) wait(500);
if(exitsfx==true) dlgplay("sounds/misc/exitgame.ogg");
mainmenu();
}
else
{
toggle_buffer_by_name("ranks");
}
}
if(key_repeating(KEY_ESCAPE))
{
alertslot=pool.play_stationary("sounds/misc/alert_critical.ogg",false);
ambpool.pause_sound(ambslot);
muspool.pause_sound(mustrackslot);
    setupmenu(false);    
    m.add_item("Yes, quit the game without saving", "quit_no_save");
    m.add_item("Yes, save the game and then quit", "quit_save");
    m.add_item("No, continue playing", "continue");
    m.add_item("No, save the game, but continue playing", "save_continue");
m.intro_text = "Are you sure you want to quit the game?";
int mres = m.run();
    if(mres==-1)
    {
pool.destroy_sound(alertslot);
ambpool.resume_sound(ambslot);
muspool.resume_sound(mustrackslot);
        speak_buffer("Continuing the game.", "misc");
form.reset();
ingame=true;
clickergame();
    }
if (m.get_item_id(mres) == "quit_no_save")
    {
pool.destroy_sound(alertslot);
ambpool.destroy_sound(ambslot);
muspool.destroy_sound(mustrackslot);
pool.destroy_all();
show_session_results(false);
        speak_buffer("Exiting the game without saving.");
if(exitsfx==false) wait(500);
if(exitsfx==true) dlgplay("sounds/misc/exitgame.ogg");
ingame=false;
mainmenu();
    }
if (m.get_item_id(mres) == "quit_save")
    {
        writedata();
pool.destroy_sound(alertslot);
ambpool.destroy_sound(ambslot);
muspool.destroy_sound(mustrackslot);
pool.destroy_all();
show_session_results(true);
        speak_buffer("game saved, Exiting to main menu.");
if(savesfx==false) wait(500);
if(savesfx==true) dlgplay("sounds/misc/savegame.ogg");
ingame=false;
mainmenu();
    }
if (m.get_item_id(mres) == "continue")
    {
pool.destroy_sound(alertslot);
ambpool.resume_sound(ambslot);
muspool.resume_sound(mustrackslot);
        speak_buffer("Continuing the game.", "misc");
form.reset();
ingame=true;
clickergame();
    }
if (m.get_item_id(mres) == "save_continue")
    {
        writedata();
pool.destroy_sound(alertslot);
        speak_buffer("game saved, Continuing the game.", "misc");
if(savesfx==false) wait(500);
if(savesfx==true) dlgplay("sounds/misc/savegame.ogg");
ambpool.resume_sound(ambslot);
muspool.resume_sound(mustrackslot);
form.reset();
ingame=true;
clickergame();
    }
}
}

