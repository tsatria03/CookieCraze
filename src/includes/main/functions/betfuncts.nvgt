/* Shared bet handling for every minigame that takes a bet. Each game used to carry its own copy of this code, and the
copies drifted apart, so a fix in one game never reached the others. The item a bet is placed in is its position in the
bet list, named by the BET_ constants below. Money amounts are in cents. Baking speed is not a bet item: it caps out
after 95 purchases, so most of what you could win would be wasted. */
const int BET_COOKIES = 0;
const int BET_MONEY = 1;
const int BET_AUTO = 2;
const int BET_MANUAL = 3;

// Fills a bet list with the four items, in the order the BET_ constants use.
void bet_add_items(int list)
{
    form.add_list_item(list, "Cookies");
    form.add_list_item(list, "Currency");
    form.add_list_item(list, "Auto Cookies");
    form.add_list_item(list, "Manual Cookies");
}

// Keeps every balance a bet can touch inside its limits; each minigame calls this every frame.
void bet_clamp_balances()
{
    if (autocookie <= 0) { bakemode = 0; autocookie = 0; }
    if (coins <= 0) coins = 0;
    if (cookies <= 0) cookies = 0;
    if (cookiespeed <= 0) cookiespeed = 0;
    if (cookiespeed > COOKIESPEED_MAX) cookiespeed = COOKIESPEED_MAX;
    if (manulcookie <= 0) manulcookie = 0;
    if (clicktime <= 50) clicktime = 50;
    if (clicktime >= 1000) clicktime = 1000;
}

// How much of an item you have to bet with, in whole units.
double bet_balance(int item)
{
    if (item == BET_COOKIES) return floor(cookies);
    if (item == BET_MONEY) return floor(coins);
    if (item == BET_AUTO) return floor(autocookie);
    return floor(manulcookie);
}

// The item's name after an amount, such as 10 cookies. Money has none, since its amount already reads as dollars and cents.
string bet_item_name(int item)
{
    if (item == BET_COOKIES) return "cookies";
    if (item == BET_MONEY) return "";
    if (item == BET_AUTO) return "auto cookies";
    return "manual cookies";
}

// An amount as it is spoken: dollars and cents for money, a plain number otherwise.
string bet_amount_text(int item, double amount)
{
    return (item == BET_MONEY) ? convert_to_currency(amount) : format_number(amount);
}

// An amount with its item, such as 10 cookies or $1.50.
string bet_amount_with_item(int item, double amount)
{
    return (item == BET_MONEY) ? convert_to_currency(amount) : format_number(amount) + " " + bet_item_name(item);
}

// Every bet error plays the same fail sound and shows the same kind of dialog.
void bet_fail(string message)
{
    pool.play_stationary("sounds/misc/gamefail.ogg", false);
    dlg_buffer(message);
}

/* Reads a bet amount typed into a game's bet box and checks it against the game's limits. Money is typed in dollars and
kept in cents. Returns the amount to bet, or 0 after explaining the problem. A bet over the maximum is lowered to it
rather than refused. clampToBalance lowers the bet to what you have; roulette turns it off, because it checks the total
it stakes across all its bet types instead. */
double read_bet(int item, string text, double minBet, double maxBet, bool clampToBalance = true)
{
    double amount = floor(item == BET_MONEY ? string_to_number(text) * 100.0 : string_to_number(text));
    if (amount <= 0)
    {
        bet_fail("Error! Please enter a valid bet amount.");
        return 0;
    }
    if (amount < minBet)
    {
        bet_fail("Error! The minimum bet is " + bet_amount_text(item, minBet) + ".");
        return 0;
    }
    if (maxBet > 0 && amount > maxBet)
    {
        bet_fail("Your bet has been capped at the maximum of " + bet_amount_text(item, maxBet) + ".");
        amount = maxBet;
    }
    if (clampToBalance)
    {
        amount = min(amount, bet_balance(item));
        if (amount <= 0)
        {
            bet_fail("Error! You don't have enough of that item to bet!");
            return 0;
        }
    }
    return amount;
}

/* Asks before a large bet. The threshold is an amount, or with usePercent a percentage of what you hold of that item;
0 never asks. Returns true to go ahead. question replaces the usual wording, which roulette uses for its total stake. */
bool confirm_bet(int item, double amount, double threshold, bool usePercent, string question = "")
{
    if (threshold <= 0) return true;
    double effectiveThreshold = usePercent ? bet_balance(item) * (threshold / 100.0) : threshold;
    if (amount < effectiveThreshold) return true;
    if (question == "") question = "Are you sure you want to bet " + bet_amount_with_item(item, amount) + "?";
    return yes_no(question, true);
}

// Takes a bet out of the item it was placed in.
void take_bet(int item, double amount)
{
    if (item == BET_COOKIES) { cookies -= amount; cookies = floor(safe_cap(cookies)); }
    else if (item == BET_MONEY) { coins -= amount; coins = floor(safe_cap(coins)); }
    else if (item == BET_AUTO) { autocookie -= amount; autocookie = floor(safe_cap(autocookie)); }
    else if (item == BET_MANUAL) { manulcookie -= amount; manulcookie = floor(safe_cap(manulcookie)); }
}

/* Pays an amount back into the item that was bet. Each game still counts its own money earned, since each works out its
profit differently. */
void pay_bet(int item, double amount)
{
    if (item == BET_COOKIES) { cookies += amount; cookies = floor(safe_cap(cookies)); }
    else if (item == BET_MONEY) { coins += amount; coins = floor(safe_cap(coins)); }
    else if (item == BET_AUTO) { autocookie += amount; autocookie = floor(safe_cap(autocookie)); }
    else if (item == BET_MANUAL) { manulcookie += amount; manulcookie = floor(safe_cap(manulcookie)); }
}

/* What the B key says in a betting minigame. Each of them keeps this current every frame, and again as soon as a bet is
taken, so minigame_input can answer B between actions and during the timed waits alike. */
string betStatus = "";

void set_bet_status(string text)
{
    betStatus = text;
}

// The B key wording for games that only report the last bet placed.
string last_bet_status(int item, double amount)
{
    if (amount <= 0) return "You have not placed a bet yet.";
    return "Your current bet is " + bet_amount_with_item(item, amount) + ".";
}
