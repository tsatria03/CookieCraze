/* Boost state: the boosts you hold (loadedBoosts[i].owned), the boost slots you own, and what each slot is running.
Running boosts count down in real time the whole time the game is open, on every screen and even when the window is
out of focus, and pause only while the game is closed: each slot's time left is saved and resumes on load. */
// The rank that unlocks boosts: the cookie store's buy boosts and the boost slot manager.
int boostUnlockRank = 100;
int boostSlotCount = 0;
// Boost slots bought this run. Prices follow this, so free head start slots never make the next slot dearer.
int boostSlotsBought = 0;
// Per slot: the id of the boost it is running, or "" when empty, and how many milliseconds it has left.
string[] boostSlotIds;
double[] boostSlotLeft;
// Activations this run; each one raises the next activation's price, like automating a slot.
double boostActivations = 0;
// Cash jar money earned but not yet paid, in fractions of a cent; paid out a whole cent at a time.
double boostCashCarry = 0;
timer boostClock;
double boostClockMark = 0;

// The index of a boost in loadedBoosts by id, or -1.
int find_boost(string id)
{
    for (uint i = 0; i < loadedBoosts.length(); i++)
        if (loadedBoosts[i].id == id) return int(i);
    return -1;
}

// Keeps the slot lists the same length as the number of slots owned.
void size_boost_slots()
{
    boostSlotIds.resize(boostSlotCount);
    boostSlotLeft.resize(boostSlotCount);
}

// Everything boost-related back to a fresh run: no slots, nothing running, nothing held. Prestige and new games use this.
void reset_boosts()
{
    boostSlotCount = 0;
    boostSlotsBought = 0;
    boostSlotIds.resize(0);
    boostSlotLeft.resize(0);
    boostActivations = 0;
    boostCashCarry = 0;
    for (uint i = 0; i < loadedBoosts.length(); i++) loadedBoosts[i].owned = 0;
    boostClockMark = boostClock.elapsed;
}

/* Counts every running boost down by the real time since the last call, and ends any that run out. Called every frame
on the main screen, from every minigame's input, and before anything reads a boost, so time is never missed. */
void update_boosts()
{
    double now = boostClock.elapsed;
    double passed = now - boostClockMark;
    boostClockMark = now;
    if (passed <= 0) return;
    // The boosts that run out during this call, announced together once the countdown is done.
    string[] endedIds;
    int[] endedSlots;
    for (int i = 0; i < boostSlotCount; i++)
    {
        if (boostSlotIds[i] == "") continue;
        // The cash jar pays a flat amount every second, baking or not, for exactly the time it ran, never past its end.
        int cidx = find_boost(boostSlotIds[i]);
        if (cidx >= 0 && loadedBoosts[cidx].effect == "cash_per_second")
            boostCashCarry += boost_cash_per_second(loadedBoosts[cidx]) * (min(passed, boostSlotLeft[i]) / 1000.0);
        // Boost time used counts every running boost, in minutes, for the time it really ran.
        stat_boost_minutes = safe_cap(stat_boost_minutes + min(passed, boostSlotLeft[i]) / 60000.0);
        boostSlotLeft[i] -= passed;
        if (boostSlotLeft[i] > 0) continue;
        endedIds.insert_last(boostSlotIds[i]);
        endedSlots.insert_last(i);
        boostSlotIds[i] = "";
        boostSlotLeft[i] = 0;
        stat_boosts_completed++;
    }
    announce_ended_boosts(endedIds, endedSlots);
    if (boostCashCarry >= 1)
    {
        double pay = floor(boostCashCarry);
        boostCashCarry -= pay;
        coins = floor(safe_cap(coins + pay));
        stat_coins_earned = safe_cap(stat_coins_earned + pay);
    }
}

/* Announces the boosts that ended at the same moment. Boosts started together with activate all also end together, so
several copies of one boost get one expire_summary_message line instead of a line each, the way a big gain of ranks
gets one rank summary. A boost that ends alone, or every boost when the summary is left out of boosts.store, gets its
own expire_message with its slot number. expire_sound plays once for the whole moment, however many ended, and stays
quiet while the boosts buffer is muted, like the messages. */
void announce_ended_boosts(string[]@ ids, int[]@ slots)
{
    if (ids.length() == 0) return;
    int bufferIndex = get_buffer_index("boosts");
    bool muted = bufferIndex >= 0 && buffers[bufferIndex].muted;
    if (boostExpireSound != "" && !muted) pool.play_stationary("sounds/misc/" + resolve_sound(boostExpireSound), false);
    bool[] done(ids.length());
    for (uint i = 0; i < ids.length(); i++)
    {
        if (done[i]) continue;
        string boostName = ids[i];
        int idx = find_boost(ids[i]);
        if (idx >= 0) boostName = loadedBoosts[idx].name.lower();
        int count = 0;
        for (uint j = i; j < ids.length(); j++)
            if (ids[j] == ids[i]) count++;
        if (count > 1 && boostExpireSummaryMessage != "")
        {
            for (uint j = i; j < ids.length(); j++)
                if (ids[j] == ids[i]) done[j] = true;
            string summary = string_replace(boostExpireSummaryMessage, "%boost%", boostName, true);
            summary = string_replace(summary, "%count%", format_number(count), true);
            speak_buffer(summary, "boosts");
            continue;
        }
        done[i] = true;
        string msg = string_replace(boostExpireMessage, "%boost%", boostName, true);
        msg = string_replace(msg, "%slot%", string(slots[i] + 1), true);
        speak_buffer(msg, "boosts");
    }
}

/* A boost's strength after the prestige boost power upgrades: 20 percent power turns a 10 percent boost into 12.
Discount boosts stop at 90 percent off, so no price ever drops to nothing. */
double boosted_amount(boost_item@ b)
{
    double amt = b.amount * (1.0 + max(0.0, prestige_boost_power) / 100.0);
    if (b.effect.find("discount") != -1) amt = min(90.0, amt);
    return amt;
}

// How many seconds a boost runs after the prestige boost duration upgrades, to the nearest second.
double boosted_duration(boost_item@ b)
{
    return floor(double(b.duration) * (1.0 + max(0.0, prestige_boost_duration) / 100.0) + 0.5);
}

/* Every running boost with this effect multiplies its strength in: two 10 percent boosts make 1.21 times, since
each copy multiplies on top of the last. The _now version skips the countdown so update_boosts can use it without calling itself. */
double boost_multiplier_now(string effect)
{
    double mult = 1.0;
    for (int i = 0; i < boostSlotCount; i++)
    {
        if (boostSlotIds[i] == "") continue;
        int idx = find_boost(boostSlotIds[i]);
        if (idx >= 0 && loadedBoosts[idx].effect == effect) mult *= 1.0 + boosted_amount(loadedBoosts[idx]) / 100.0;
    }
    return mult;
}

double boost_multiplier(string effect)
{
    update_boosts();
    return boost_multiplier_now(effect);
}

// What a price is multiplied by under every running discount boost of this kind: two 10 percent discounts leave 81 percent.
double boost_cost_factor(string effect)
{
    update_boosts();
    double factor = 1.0;
    for (int i = 0; i < boostSlotCount; i++)
    {
        if (boostSlotIds[i] == "") continue;
        int idx = find_boost(boostSlotIds[i]);
        if (idx >= 0 && loadedBoosts[idx].effect == effect) factor *= max(0.0, 1.0 - boosted_amount(loadedBoosts[idx]) / 100.0);
    }
    return factor;
}

// Production boosts for one kind of baking: its own boost and cookie frenzy, which boosts both.
double boost_auto_production() { return boost_multiplier("auto_production") * boost_multiplier("all_production"); }
double boost_manual_production() { return boost_multiplier("manual_production") * boost_multiplier("all_production"); }

// The time between automatic bakes under bake speed boosts, never below the game's 50 millisecond floor.
double boosted_clicktime()
{
    return max(50.0, double(clicktime) / boost_multiplier("bake_speed"));
}

// The price one cookie sells for under sell price boosts.
double boosted_sell_price()
{
    return cookieSellPrice * boost_multiplier("sell_price");
}

// The current price of one more copy of a boost; each copy you hold raises it, like tickets.
double get_boost_current_cost(boost_item@ b)
{
    return floor(safe_cap(b.base_cost * pow(b.cost_multiplier, b.owned)));
}

// qty copies cost the sum of their rising prices, the same as buying them one at a time.
double get_boost_bulk_cost(boost_item@ b, double qty)
{
    return floor(calc_total_upgrade_cost(b.owned, qty, b.base_cost, b.cost_multiplier));
}

// What a boost's category is paid for with right now: cookies, or money in cents.
double boost_balance(boost_item@ b)
{
    for (uint i = 0; i < loadedBoostCategories.length(); i++)
        if (loadedBoostCategories[i].id == b.category_id) return (loadedBoostCategories[i].currency == "coins") ? floor(coins) : floor(cookies);
    return floor(cookies);
}

bool boost_costs_money(boost_item@ b)
{
    for (uint i = 0; i < loadedBoostCategories.length(); i++)
        if (loadedBoostCategories[i].id == b.category_id) return loadedBoostCategories[i].currency == "coins";
    return false;
}

// A price spoken in the boost's own currency.
string boost_price_text(boost_item@ b, double amount)
{
    if (boost_costs_money(b)) return convert_to_currency(amount);
    return format_number(amount) + (amount == 1 ? " cookie" : " cookies");
}

// How many copies of a boost you can afford at the rising price, within max_boosts.
double get_boost_max_buyable(boost_item@ b)
{
    double balance = boost_balance(b);
    double n = calc_max_buyable(balance, b.owned, b.base_cost, b.cost_multiplier);
    if (boostMaxHold > 0) n = min(n, double(boostMaxHold) - b.owned);
    // The formula can round one copy too high; step down until the batch is really affordable.
    while (n > 0 && get_boost_bulk_cost(b, n) > balance) n--;
    return max(0.0, n);
}

void write_boosts()
{
    update_boosts();
    sd.add("boostSlotCount", boostSlotCount);
    sd.add("boostSlotsBought", boostSlotsBought);
    sd.add("boostActivations", boostActivations);
    for (int i = 0; i < boostSlotCount; i++)
    {
        sd.add("boostSlot_id_" + string(i), boostSlotIds[i]);
        sd.add("boostSlot_left_" + string(i), boostSlotLeft[i]);
    }
    sd.add("boostOwnedCount", int(loadedBoosts.length()));
    for (uint i = 0; i < loadedBoosts.length(); i++)
    {
        sd.add("boostOwned_id_" + string(i), loadedBoosts[i].id);
        sd.add("boostOwned_count_" + string(i), loadedBoosts[i].owned);
    }
}

// Runs after readdata has reset everything to a new game, so a save without boosts simply starts with none.
void read_boosts()
{
    if (sd.d.exists("boostSlotCount")) boostSlotCount = max(0, sd.read_int("boostSlotCount"));
    // Saves from before head start slots bought every slot they own.
    boostSlotsBought = boostSlotCount;
    if (sd.d.exists("boostSlotsBought")) boostSlotsBought = int(max(0.0, double(sd.read_int("boostSlotsBought"))));
    if (sd.d.exists("boostActivations")) boostActivations = max(0.0, sd.read_double("boostActivations"));
    size_boost_slots();
    for (int i = 0; i < boostSlotCount; i++)
    {
        string id = sd.d.exists("boostSlot_id_" + string(i)) ? sd.read_string("boostSlot_id_" + string(i)) : "";
        double left = sd.d.exists("boostSlot_left_" + string(i)) ? sd.read_double("boostSlot_left_" + string(i)) : 0;
        // A running boost that boosts.store no longer has, or with no time left, comes back as an empty slot.
        if (id == "" || find_boost(id) < 0 || left <= 0) { id = ""; left = 0; }
        boostSlotIds[i] = id;
        boostSlotLeft[i] = left;
    }
    if (sd.d.exists("boostOwnedCount"))
    {
        int count = sd.read_int("boostOwnedCount");
        for (int i = 0; i < count; i++)
        {
            string id = sd.read_string("boostOwned_id_" + string(i));
            int idx = find_boost(id);
            if (idx >= 0) loadedBoosts[idx].owned = max(0.0, sd.read_double("boostOwned_count_" + string(i)));
        }
    }
    // Time spent closed does not count: the countdown resumes from the moment the save is loaded.
    boostClockMark = boostClock.elapsed;
}
