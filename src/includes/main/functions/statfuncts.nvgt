    txt += "Tickets bought: " + format_number(stat_for_view(STAT_LOTTERY_TICKETS_BOUGHT, session)) + "\r\n";
    txt += "Tickets scratched: " + format_number(stat_for_view(STAT_LOTTERY_TICKETS_SCRATCHED, session)) + "\r\n";
    txt += "Wins: " + format_number(stat_for_view(STAT_LOTTERY_WINS, session)) + "\r\n";
