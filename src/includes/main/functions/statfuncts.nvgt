/* Lifetime and session statistics.
Eleven stats count only the current run: prestige zeroes them in reset_game_state, which is what achievements and
quests expect. So their lifetime totals are kept as a bank: just before each reset the run's value is added to it,
and a lifetime total is the bank plus the current run. A new game empties the bank like everything else. */
const array<string> RUN_STATS = {"cookies_baked", "manual_bakes_performed", "auto_bakes_performed", "coins_earned", "coins_spent", "singles_purchased", "bundles_purchased", "baker_events_fired", "auto_slots_purchased", "manual_slots_purchased", "auto_slots_enabled"};
dictionary lifetimeBank;

double lifetime_stat_value(string stat)
{
    double banked = 0;
    lifetimeBank.get(stat, banked);
    return get_stat_value(stat) + banked;
}

void bank_run_stats()
{
    for (uint i = 0; i < RUN_STATS.length(); i++)
        lifetimeBank.set(RUN_STATS[i], lifetime_stat_value(RUN_STATS[i]));
}

/* Session statistics count from the moment a save is loaded or a new game starts: each counted stat's lifetime value
is noted then, and the session value is how far it has risen since. Lifetime values never drop during a session, so a
prestige mid-session cannot make a session value go negative. Bests (highest combo, longest higher or lower streak)
are not counts, so the session keeps its own best for each instead. */
const array<string> SESSION_STATS = {"cookies_baked", "manual_bakes_performed", "auto_bakes_performed", "coins_earned", "coins_spent", "singles_purchased", "bundles_purchased", "baker_events_fired", "auto_slots_purchased", "manual_slots_purchased", "auto_slots_enabled", "combos_started", "combos_broken", "flipper_events_fired", "flipper_flips", "cookie_flips", "penny_flips", "dice_rolls", "dice_wins", "dice_losses", "don_games", "don_wins", "don_losses", "don_correct_calls", "don_suit_hits", "don_jokers", "boosts_bought", "boosts_activated", "boost_slots_purchased", "boosts_completed", "boost_minutes", "boosts_ended", "slot_spins", "slot_wins", "slot_losses", "blackjack_hands", "blackjack_wins", "blackjack_losses", "blackjack_pushes", "lottery_tickets_bought", "lottery_tickets_scratched", "lottery_wins", "lottery_losses", "highlow_games", "highlow_wins", "highlow_losses", "roulette_games", "roulette_wins", "roulette_losses", "roulette_straight_hits", "roulette_breaks", "quests_completed", "rerolls_performed"};
dictionary sessionBaseline;
double sessionHighestCombo = 0;
double sessionHighestStreak = 0;
double sessionHighestRide = 0;
timer sessionClock;

void start_session_stats()
{
    sessionBaseline.delete_all();
    for (uint i = 0; i < SESSION_STATS.length(); i++)
        sessionBaseline.set(SESSION_STATS[i], lifetime_stat_value(SESSION_STATS[i]));
    sessionHighestCombo = 0;
    sessionHighestStreak = 0;
    sessionHighestRide = 0;
    sessionClock.restart();
}

double session_stat_value(string stat)
{
    if (stat == STAT_HIGHEST_COMBO_REACHED) return sessionHighestCombo;
    if (stat == STAT_HIGHLOW_HIGHEST_STREAK) return sessionHighestStreak;
    if (stat == STAT_DON_HIGHEST_RIDE) return sessionHighestRide;
    double base = 0;
    sessionBaseline.get(stat, base);
    return max(0.0, lifetime_stat_value(stat) - base);
}

/* Time played, in milliseconds. playClock runs for the whole time the game is open; update_time_played adds what has
passed since the last mark. Loading a save resets the mark, so only time spent in a loaded game counts, and like every
other stat, time since the last save is lost if you quit without saving or reload with Control L. */
timer playClock;
double playClockMark = 0;

void update_time_played()
{
    double now = playClock.elapsed;
    stat_time_played = safe_cap(stat_time_played + (now - playClockMark));
    playClockMark = now;
}

// A play time such as 1 hour, 4 minutes, 9 seconds; hours only appear once there is at least one.
string format_play_time(double ms)
{
    double totalSeconds = floor(max(0.0, ms) / 1000.0);
    double hours = floor(totalSeconds / 3600.0);
    double minutes = floor((totalSeconds - hours * 3600.0) / 60.0);
    double seconds = totalSeconds - hours * 3600.0 - minutes * 60.0;
    string result = "";
    if (hours > 0) result += format_number(hours) + (hours == 1 ? " hour, " : " hours, ");
    result += format_number(minutes) + (minutes == 1 ? " minute, " : " minutes, ");
    result += format_number(seconds) + (seconds == 1 ? " second" : " seconds");
    return result;
}

double stat_for_view(string stat, bool session)
{
    return session ? session_stat_value(stat) : lifetime_stat_value(stat);
}

/* The text of the session or lifetime statistics screen. Both list the same stats in the same sections; the session
one counts only since this save was loaded, and leaves out auto slots idle, which is how many slots sit idle right
now rather than something you did. */
string build_statistics_text(bool session)
{
    string txt = "";
    if (session)
        txt += "Time played this session: " + format_play_time(sessionClock.elapsed) + "\r\n";
    else
    {
        update_time_played();
        txt += "Time played: " + format_play_time(stat_time_played) + "\r\n";
    }
    txt += "\r\n";
    txt += "Baking\r\n";
    txt += "Cookies baked: " + format_number(stat_for_view(STAT_COOKIES_BAKED, session)) + "\r\n";
    txt += "Auto bakes performed: " + format_number(stat_for_view(STAT_AUTO_BAKES_PERFORMED, session)) + "\r\n";
    txt += "Manual bakes performed: " + format_number(stat_for_view(STAT_MANUAL_BAKES_PERFORMED, session)) + "\r\n";
    txt += "\r\n";
    txt += "Baking slots manager\r\n";
    txt += "Auto slots purchased: " + format_number(stat_for_view(STAT_AUTO_SLOTS_PURCHASED, session)) + "\r\n";
    txt += "Auto slots enabled: " + format_number(stat_for_view(STAT_AUTO_SLOTS_ENABLED, session)) + "\r\n";
    if (!session)
        txt += "Auto slots idle: " + format_number(double(baking_slots.length()) - double(autobakeSlots)) + "\r\n";
    txt += "Manual slots purchased: " + format_number(stat_for_view(STAT_MANUAL_SLOTS_PURCHASED, session)) + "\r\n";
    txt += "\r\n";
    txt += "Boosts\r\n";
    txt += "Boosts bought: " + format_number(stat_for_view(STAT_BOOSTS_BOUGHT, session)) + "\r\n";
    txt += "Boosts activated: " + format_number(stat_for_view(STAT_BOOSTS_ACTIVATED, session)) + "\r\n";
    txt += "Boost slots purchased: " + format_number(stat_for_view(STAT_BOOST_SLOTS_PURCHASED, session)) + "\r\n";
    txt += "Boosts completed: " + format_number(stat_for_view(STAT_BOOSTS_COMPLETED, session)) + "\r\n";
    txt += "Boosts ended early: " + format_number(stat_for_view(STAT_BOOSTS_ENDED, session)) + "\r\n";
    txt += "Boost time used: " + format_play_time(stat_for_view(STAT_BOOST_MINUTES, session) * 60000.0) + "\r\n";
    txt += "\r\n";
