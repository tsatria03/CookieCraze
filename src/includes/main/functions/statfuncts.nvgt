/* Lifetime and session statistics.
Eleven stats count only the current run: prestige zeroes them in reset_game_state, which is what achievements and
quests expect. So their lifetime totals are kept as a bank: just before each reset the run's value is added to it,
and a lifetime total is the bank plus the current run. A new game empties the bank like everything else. */
const array<string> RUN_STATS = {"cookies_baked", "manual_bakes_performed", "auto_bakes_performed", "coins_earned", "coins_spent", "singles_purchased", "bundles_purchased", "baker_events_fired", "auto_slots_purchased", "manual_slots_purchased", "auto_slots_enabled"};
dictionary lifetimeBank;

double lifetime_stat_value(string stat)
{
    double banked = 0;
    lifetimeBank.get(stat, banked);
    return get_stat_value(stat) + banked;
}

void bank_run_stats()
{
    for (uint i = 0; i < RUN_STATS.length(); i++)
        lifetimeBank.set(RUN_STATS[i], lifetime_stat_value(RUN_STATS[i]));
}

/* Session statistics count from the moment a save is loaded or a new game starts: each counted stat's lifetime value
is noted then, and the session value is how far it has risen since. Lifetime values never drop during a session, so a
prestige mid-session cannot make a session value go negative. Bests (highest combo, longest higher or lower streak)
are not counts, so the session keeps its own best for each instead. */
const array<string> SESSION_STATS = {"cookies_baked", "manual_bakes_performed", "auto_bakes_performed", "coins_earned", "coins_spent", "singles_purchased", "bundles_purchased", "baker_events_fired", "auto_slots_purchased", "manual_slots_purchased", "auto_slots_enabled", "combos_started", "combos_broken", "flipper_events_fired", "flipper_flips", "cookie_flips", "penny_flips", "dice_rolls", "dice_wins", "dice_losses", "slot_spins", "slot_wins", "slot_losses", "blackjack_hands", "blackjack_wins", "blackjack_losses", "blackjack_pushes", "lottery_tickets_bought", "lottery_tickets_scratched", "lottery_wins", "lottery_losses", "highlow_games", "highlow_wins", "highlow_losses", "roulette_games", "roulette_wins", "roulette_losses", "roulette_straight_hits", "roulette_breaks", "quests_completed", "rerolls_performed"};
dictionary sessionBaseline;
double sessionHighestCombo = 0;
double sessionHighestStreak = 0;
timer sessionClock;

void start_session_stats()
{
    sessionBaseline.delete_all();
    for (uint i = 0; i < SESSION_STATS.length(); i++)
        sessionBaseline.set(SESSION_STATS[i], lifetime_stat_value(SESSION_STATS[i]));
    sessionHighestCombo = 0;
    sessionHighestStreak = 0;
    sessionClock.restart();
}

double session_stat_value(string stat)
{
    if (stat == STAT_HIGHEST_COMBO_REACHED) return sessionHighestCombo;
    if (stat == STAT_HIGHLOW_HIGHEST_STREAK) return sessionHighestStreak;
    double base = 0;
    sessionBaseline.get(stat, base);
    return max(0.0, lifetime_stat_value(stat) - base);
}

/* Time played, in milliseconds. playClock runs for the whole time the game is open; update_time_played adds what has
passed since the last mark. Loading a save resets the mark, so only time spent in a loaded game counts, and like every
other stat, time since the last save is lost if you quit without saving or reload with Control L. */
timer playClock;
double playClockMark = 0;

void update_time_played()
{
    double now = playClock.elapsed;
    stat_time_played = safe_cap(stat_time_played + (now - playClockMark));
    playClockMark = now;
}
