    return txt;
}

// Writes a statistics screen to its own file in the stats folder in AppData, replacing the last export.
bool export_statistics(string fileName, string title, string txt)
{
    string statsdir = APPDATA_DIR + "stats";
    if (!directory_exists(statsdir)) directory_create(statsdir);
    file f;
    if (!f.open(statsdir + "/" + fileName, "wb")) return false;
    f.write(title + "\r\nExported on " + DATE_MONTH + "/" + DATE_DAY + "/" + DATE_YEAR + "\r\n\r\n" + txt);
    f.close();
    return true;
}

/* The screen every statistics view shares: the text in a read-only box, then Copy, Export, and Close. It returns
when closed, so each caller decides where to go next. */
void show_statistics_screen(string title, string txt, string exportFile)
{
    form.reset();
    form.create_window(title, false);
    int statsbox = form.create_input_box(title, txt, read_only:true, multiline:true);
    int statscopy = form.create_button("Co&py");
    int statsexport = form.create_button("&Export");
    int statsclose = form.create_button("&Close", false, true);
    form.focus(statsbox);
    while (true)
    {
        wait(5);
        form.monitor();
        if (form.is_pressed(statscopy))
        {
            clipboard_copy_text(title + "\r\n\r\n" + txt);
            speak(title + " copied to clipboard.");
        }
        if (form.is_pressed(statsexport))
        {
            if (export_statistics(exportFile, title, txt))
                speak(title + " have been exported to stats/" + exportFile + ".");
            else
                speak("Error! " + title + " could not be exported.");
        }
        if (form.is_pressed(statsclose) || key_pressed(KEY_ESCAPE))
        {
            form.reset();
            return;
        }
    }
}

void show_session_statistics()
{
    show_statistics_screen("Session statistics", build_statistics_text(true), "session_statistics.txt");
    infomenu();
}

void show_lifetime_statistics()
{
    show_statistics_screen("Lifetime statistics", build_statistics_text(false), "lifetime_statistics.txt");
    infomenu();
}

/* The session results screen shown when you quit to the main menu, unless the setting is off: an opening line, the
session statistics, and a sign-off, on the same screen as the other statistics so Copy and Export work the same way.
saved is false when quitting without saving, so the player knows anything since their last save was not kept. */
void show_session_results(bool saved)
{
    if (!sessionresults) return;
    string txt = "Here are your results for this session, " + playername + ".\r\n";
    if (!saved) txt += "You quit without saving, so anything since your last save was not kept.\r\n";
    txt += "\r\n" + build_statistics_text(true) + "\r\n";
    txt += "Thanks for baking! See you next time.\r\n";
    show_statistics_screen("Session results", txt, "session_statistics.txt");
}
