    txt += "Combos broken: " + format_number(stat_for_view(STAT_COMBOS_BROKEN, session)) + "\r\n";
    txt += "Highest combo reached: " + format_number(stat_for_view(STAT_HIGHEST_COMBO_REACHED, session)) + "\r\n";
    txt += "\r\n";
    txt += "Economy\r\n";
    txt += "Money earned: " + convert_to_currency(stat_for_view(STAT_COINS_EARNED, session)) + "\r\n";
    txt += "Money spent: " + convert_to_currency(stat_for_view(STAT_COINS_SPENT, session)) + "\r\n";
    txt += "Bundle upgrades purchased: " + format_number(stat_for_view(STAT_BUNDLES_PURCHASED, session)) + "\r\n";
    txt += "Single upgrades purchased: " + format_number(stat_for_view(STAT_SINGLES_PURCHASED, session)) + "\r\n";
    txt += "\r\n";
    txt += "Baker events\r\n";
    txt += "Baker events fired: " + format_number(stat_for_view(STAT_BAKER_EVENTS_FIRED, session)) + "\r\n";
    txt += "\r\n";
    txt += "Flipper events\r\n";
