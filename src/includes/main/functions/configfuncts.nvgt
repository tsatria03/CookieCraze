/* Config files live in two places: loose under data/decompiled/config, and packed in data/compiled/config.crz.
A loose file always wins, so edits show up on the next Control L; the pack is only read when the loose file is missing.
Paths passed in are relative to both, such as tables/ranks.table. */
const string CONFIG_LOOSE_DIR = "data/decompiled/config/";
const string CONFIG_PACK_PATH = "data/compiled/config.crz";
pack_file configPack;
bool configPackOpen = false;

bool open_config_pack()
{
    if (configPackOpen)
        return true;
    if (!file_exists(CONFIG_PACK_PATH))
        return false;
    configPackOpen = configPack.open(CONFIG_PACK_PATH, PACK_OPEN_MODE_READ);
    return configPackOpen;
}

void close_config_pack()
{
    if (configPackOpen)
        configPack.close();
    configPackOpen = false;
}

bool read_config_text(const string&in relativePath, string &out text)
{
    text = "";
    string loosePath = CONFIG_LOOSE_DIR + relativePath;
    if (file_exists(loosePath))
    {
        file f;
        if (!f.open(loosePath, "rb"))
            return false;
        text = f.read();
        f.close();
        return true;
    }
    if (!open_config_pack() || !configPack.file_exists(relativePath))
        return false;
    text = configPack.read_file(relativePath, 0, configPack.get_file_size(relativePath));
    return true;
}

// Stands in for file in the config parsers, with the same open, eof, read_line and close they already use.
class config_file
{
    string[] lines;
    uint position = 0;
    bool eof = true;

    bool open(const string&in relativePath)
    {
        string text;
        lines.resize(0);
        position = 0;
        eof = true;
        if (!read_config_text(relativePath, text))
            return false;
        lines = text.split("\n");
        eof = lines.length() == 0;
        return true;
    }

    string read_line()
    {
        if (position >= lines.length())
        {
            eof = true;
            return "";
        }
        string line = lines[position];
        position++;
        eof = position >= lines.length();
        return line;
    }

    void close()
    {
        lines.resize(0);
        position = 0;
        eof = true;
    }
}

// Every loose config file by its pack name, such as events/baker.event, from each folder inside data/decompiled/config.
string[] list_loose_config_files()
{
    string[] names;
    string[]@ folders = find_directories(CONFIG_LOOSE_DIR + "*");
    for (uint i = 0; i < folders.length(); i++)
    {
        string[]@ folderFiles = find_files(CONFIG_LOOSE_DIR + folders[i] + "/*");
        for (uint j = 0; j < folderFiles.length(); j++)
            names.insert_last(folders[i] + "/" + folderFiles[j]);
    }
    return names;
}

/* Rebuilds config.crz from scratch out of the given loose files and returns how many went in, or -1 if the pack
could not be created. The read pack is closed first so its file can be rewritten; the next config read reopens it. */
int compile_config_pack(string[]@ names)
{
    close_config_pack();
    directory_create("data/compiled");
    pack_file p;
    if (!p.open(CONFIG_PACK_PATH, PACK_OPEN_MODE_CREATE))
        return -1;
    int added = 0;
    for (uint i = 0; i < names.length(); i++)
    {
        if (p.add_file(CONFIG_LOOSE_DIR + names[i], names[i], true))
            added++;
    }
    p.close();
    return added;
}

// Writes every file in config.crz out to data/decompiled/config and returns how many were written, or -1 if there is no pack.
int decompile_config_pack()
{
    if (!open_config_pack())
        return -1;
    string[]@ names = configPack.list_files();
    int written = 0;
    for (uint i = 0; i < names.length(); i++)
    {
        string outPath = CONFIG_LOOSE_DIR + names[i];
        int slash = outPath.rfind("/");
        if (slash > 0)
            directory_create(outPath.substr(0, slash));
        if (configPack.extract_file(names[i], outPath))
            written++;
    }
    return written;
}
