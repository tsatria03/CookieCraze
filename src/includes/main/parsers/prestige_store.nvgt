class prestige_menu_def
{
    string alias;
    string name;
    int min_level;
    bool hidden;
    string description;
}

class prestige_store_item
{
    string item_id;
    int cost;
    double cost_multiplier;
    int min_level;
    bool hidden;
    bool infinite;
    bool purchased;
    double amount;
    string menu;
    string description;
}

/* A prestige upgrade's name as players hear it, built from its id, which never changes since purchases are saved by
it: underscores become spaces, the internal words autocookie, manualcookie, and coins read as auto cookies, manual
cookies, and money, and the first letter is capitalized, so starting_autocookie_3 reads Starting auto cookies 3. */
string prestige_item_name(string id)
{
    string[] words = id.split("_");
    string name = "";
    for (uint i = 0; i < words.length(); i++)
    {
        string w = words[i];
        if (w == "") continue;
        if (w == "autocookie") w = "auto cookies";
        else if (w == "manualcookie" || w == "manulcookie") w = "manual cookies";
        else if (w == "coin" || w == "coins") w = "money";
        name += (name == "" ? "" : " ") + w;
    }
    if (name.length() == 0) return id;
    return name.substr(0, 1).upper() + name.substr(1);
}

void parse_prestige_store(string filepath, prestige_store_item[]@ items_out, prestige_menu_def[]@ menus_out)
{
    config_file f;
    if (!f.open(filepath))
        return;
    prestige_menu_def[] menuDefs;
    dictionary menuAliases;
    while (!f.eof)
    {
        string line = f.read_line();
        while (line.length() > 0 && (line.substr(line.length() - 1) == "\n" || line.substr(line.length() - 1) == "\r"))
            line = line.substr(0, line.length() - 1);
        if (line.length() == 0 || line.substr(0, 2) == "//" || line.substr(0, 1) == "#" || line.substr(0, 1) == ";")
            continue;
        int eq = line.find("=");
        if (eq != -1)
        {
            string alias = line.substr(0, eq);
            string rest = line.substr(eq + 1);
            prestige_menu_def sm;
            sm.alias = alias;
            int pipe1 = rest.find("|");
            if (pipe1 != -1)
            {
                sm.name = rest.substr(0, pipe1);
                string rest2 = rest.substr(pipe1 + 1);
                int pipe2 = rest2.find("|");
                if (pipe2 != -1)
                {
                    sm.min_level = string_to_int(rest2.substr(0, pipe2));
                    string rest3 = rest2.substr(pipe2 + 1);
                    int pipe3 = rest3.find("|");
                    if (pipe3 != -1)
                    {
                        sm.hidden = (rest3.substr(0, pipe3) == "true");
                        sm.description = rest3.substr(pipe3 + 1);
                    }
                    else
                    {
                        sm.hidden = (rest3 == "true");
                        sm.description = "";
                    }
                }
                else
                {
                    sm.min_level = string_to_int(rest2);
                    sm.hidden = false;
                    sm.description = "";
                }
            }
            else
            {
                sm.name = rest;
                sm.min_level = 0;
                sm.hidden = false;
                sm.description = "";
            }
            menuAliases.set(alias, sm.name);
            menuDefs.insert_last(sm);
            continue;
        }
        string[] parts;
        int lastPos = 0;
        int colonCount = 0;
        for (uint i = 0; i < line.length(); i++)
        {
            if (line.substr(i, 1) == ":" && colonCount < 8)
            {
                parts.insert_last(line.substr(lastPos, i - lastPos));
                lastPos = i + 1;
                colonCount++;
            }
        }
        parts.insert_last(line.substr(lastPos));
        if (parts.length() < 7)
            continue;
        prestige_store_item item;
        string menuAlias = parts[0];
        if (menuAliases.exists(menuAlias))
        {
            string resolvedMenu;
            menuAliases.get(menuAlias, resolvedMenu);
            item.menu = resolvedMenu;
        }
        else
            item.menu = menuAlias;
        item.item_id = parts[1];
        item.cost = string_to_int(parts[2]);
        item.purchased = false;
        /* Two formats are supported, distinguished by field count so pre-endless prestige.store files
        still parse. New (9 fields, infinite-aware):
        menu:id:base_cost:cost_multiplier:min_level:hidden:infinite:amount:description
        Old (7 fields, one-time only): menu:id:cost:min_level:hidden:amount:description */
        if (parts.length() >= 9)
        {
            item.cost_multiplier = string_to_number(parts[3]);
            item.min_level = string_to_int(parts[4]);
            item.hidden = (parts[5] == "true");
            item.infinite = (parts[6] == "true");
            item.amount = string_to_number(parts[7]);
            item.description = parts[8];
        }
        else
        {
            item.cost_multiplier = 1.0;
            item.min_level = string_to_int(parts[3]);
            item.hidden = (parts[4] == "true");
            item.infinite = false;
            item.amount = string_to_number(parts[5]);
            item.description = parts[6];
        }
        items_out.insert_last(item);
    }
    for (uint i = 0; i < menuDefs.length(); i++)
        menus_out.insert_last(menuDefs[i]);
    f.close();
}
