class lottery_prize_item
{
    string id;
    string target;
    double min_amount;
    double max_amount;
    bool use_percent;
    // True when the 5th field is "value": min/max are a money value in cents, converted to items at current prices when scratched.
    bool value_mode;
    int weight;
    string sound;
    string message;
}

class lottery_ticket_category
{
    string id;
    string name;
    int min_rank;
    bool hidden;
    string description;
}

class lottery_ticket_item
{
    string category_id;
    string id;
    string name;
    double base_cost;
    double cost_multiplier;
    int min_rank;
    bool hidden;
    string prize_id;
    string description;
    double owned;
}

int lotteryMaxTickets = 0;
lottery_ticket_category[] loadedTicketCategories;
lottery_ticket_item[] loadedTickets;
dictionary lotteryPrizePools;

void parse_lottery_table(string filepath)
{
    lotteryPrizePools.delete_all();
    file f;
    if (!f.open(filepath, "r")) return;
    string currentPool = "";
    lottery_prize_item[] currentPrizes;
    while (!f.eof)
    {
        string line = f.read_line();
        while (line.length() > 0 && (line.substr(line.length() - 1) == "\n" || line.substr(line.length() - 1) == "\r"))
            line = line.substr(0, line.length() - 1);
        if (line.length() == 0 || line.substr(0, 1) == ";") continue;
        if (line == "[settings]") { currentPool = ""; continue; }
        if (line.substr(0, 7) == "[prize:")
        {
            if (currentPool != "" && currentPrizes.length() > 0)
                lotteryPrizePools.set(currentPool, currentPrizes);
            currentPool = line.substr(7, line.length() - 8);
            currentPrizes.resize(0);
            continue;
        }
        if (currentPool == "") continue;
        string[] parts = parse_delimited_line(line, 7);
        if (parts.length() < 8) continue;
        lottery_prize_item prize;
        prize.id = parts[0];
        prize.target = parts[1];
        prize.min_amount = string_to_number(parts[2]);
        prize.max_amount = string_to_number(parts[3]);
        prize.use_percent = (parts[4] == "true");
        prize.value_mode = (parts[4] == "value");
        prize.weight = string_to_int(parts[5]);
        prize.sound = parts[6];
        prize.message = parts[7];
        currentPrizes.insert_last(prize);
    }
    if (currentPool != "" && currentPrizes.length() > 0)
        lotteryPrizePools.set(currentPool, currentPrizes);
    f.close();
}

lottery_prize_item@ pick_lottery_prize(string prize_id)
{
    lottery_prize_item[] prizes;
    if (!lotteryPrizePools.get(prize_id, prizes)) return null;
    if (prizes.length() == 0) return null;
    int totalWeight = 0;
    for (uint i = 0; i < prizes.length(); i++)
        totalWeight += prizes[i].weight;
    if (totalWeight <= 0) return null;
    int roll = random(0, totalWeight - 1);
    int cumulative = 0;
    for (uint i = 0; i < prizes.length(); i++)
    {
        cumulative += prizes[i].weight;
        if (roll < cumulative)
            return prizes[i];
    }
    return prizes[prizes.length() - 1];
}

double lottery_unit_price(string target)
{
    /* Money value in cents of one unit of target right now, used to turn a value prize into items.
    cookies: what one cookie sells for. autocookie / manulcookie: the current price of the basic auto_cookie /
    manual_cookie single, divided by how many it gives, using the same level and formula as the store. In the shipped
    store the basic item is also the cheapest per unit. If its menu is priced in cookies, the price is converted to
    money through the sell price. Returns 0 when no price is known, so the caller pays the value as money instead. */
    if (target == "cookies") return cookieSellPrice;
    string itemType = "";
    if (target == "autocookie") itemType = "auto_cookie";
    else if (target == "manulcookie") itemType = "manual_cookie";
    if (itemType == "") return 0;
    store_item[] items;
    store_menu[] menus;
    parse_store("data/config/stores/singles.store", items, menus);
    for (uint i = 0; i < items.length(); i++)
    {
        if (items[i].item_type != itemType || items[i].use_percent || items[i].amount <= 0) continue;
        double level = (items[i].target == 2) ? manulcookie_purchases : autocookie_purchases;
        double price = buy_item(level, items[i].base_cost, items[i].cost_multiplier) / items[i].amount;
        for (uint j = 0; j < menus.length(); j++)
        {
            if (menus[j].alias == items[i].menu && menus[j].currency == "cookies")
            {
                price *= cookieSellPrice;
                break;
            }
        }
        return price;
    }
    return 0;
}

double get_ticket_current_cost(lottery_ticket_item@ ticket)
{
    return floor(safe_cap(ticket.base_cost * pow(ticket.cost_multiplier, ticket.owned)));
}

string apply_lottery_prize(lottery_prize_item@ prize)
{
    if (prize.target == "none") return "";
    double amount = 0;
    // The target actually paid; a value prize that can't buy even one item falls back to money.
    string target = prize.target;
    if (prize.value_mode)
    {
        /* A value prize rolls a money amount in cents and converts it to items at what one item is worth right now,
        so it is worth the same money at any stage of the game. */
        double cents = floor(double(random(int(prize.min_amount), int(prize.max_amount))));
        if (target == "coins")
            amount = cents;
        else
        {
            double unit = lottery_unit_price(target);
            double count = (unit > 0) ? floor(cents / unit) : 0;
            if (count >= 1)
                amount = count;
            else
            {
                target = "coins";
                amount = cents;
            }
        }
    }
    else if (prize.use_percent)
    {
        double base = 0;
        if (prize.target == "coins") base = coins;
        else if (prize.target == "cookies") base = cookies;
        else if (prize.target == "autocookie") base = autocookie;
        else if (prize.target == "manulcookie") base = manulcookie;
        else if (prize.target == "cookiespeed") base = cookiespeed;
        double pct = double(random(int(prize.min_amount * 100), int(prize.max_amount * 100))) / 100.0;
        amount = floor(base * (pct / 100.0));
    }
    else
        amount = floor(double(random(int(prize.min_amount), int(prize.max_amount))));
    if (amount <= 0) return "";
    if (target == "cookiespeed")
    {
        amount = gain_cookiespeed(amount);
        if (amount <= 0) return "Your baking speed is already at its maximum.";
    }
    else
        apply_amount_effect(target, amount, 1, false);
    string amtStr = "";
    if (target == "coins") amtStr = convert_to_currency(amount);
    else amtStr = format_number(amount);
    string itemStr = "";
    if (target == "cookies") itemStr = (amount == 1 ? "cookie" : "cookies");
    else if (target == "autocookie") itemStr = (amount == 1 ? "auto cookie" : "auto cookies");
    else if (target == "manulcookie") itemStr = (amount == 1 ? "manual cookie" : "manual cookies");
    else if (target == "cookiespeed") itemStr = "ms";
    // With no item word, as for money, drop the space before %item% so the message doesn't end in a stray space.
    string msg = prize.message;
    if (itemStr == "") msg = string_replace(msg, " %item%", "", true);
    dictionary@ tokens = dictionary();
    tokens.set("amount", amtStr);
    tokens.set("item", itemStr);
    return format_template(msg, tokens);
}

void lottery_scratch_one(lottery_ticket_item@ ticket, int ticketIdx)
{
    loadedTickets[ticketIdx].owned--;
    stat_lottery_tickets_scratched++;
    pool.play_stationary("sounds/minigames/cooky_lottery/scratch.ogg", false);
    if (lotterymode)
        mini_wait_async(random(1000, 2000), "lottery");
    else
        dlg_buffer("Scratching. Press enter or space to reveal.");
    lottery_prize_item@ prize = pick_lottery_prize(ticket.prize_id);
    if (prize is null)
    {
        dlg_buffer("Something went wrong reading the prize pool for this ticket.");
        return;
    }
    if (prize.target == "none")
    {
        stat_lottery_losses++;
        if (prize.sound != "" && prize.sound != "none")
            pool.play_stationary("sounds/minigames/" + resolve_sound(prize.sound), false);
        dlg_buffer(prize.message);
    }
    else
    {
        stat_lottery_wins++;
        if (prize.sound != "" && prize.sound != "none")
            pool.play_stationary("sounds/minigames/" + resolve_sound(prize.sound), false);
        string result = apply_lottery_prize(@prize);
        dlg_buffer(result);
    }
}

void lottery_scratch_all(lottery_ticket_item@ ticket, int ticketIdx)
{
    double count = loadedTickets[ticketIdx].owned;
    loadedTickets[ticketIdx].owned = 0;
    stat_lottery_tickets_scratched += count;

    lottery_prize_item[] prizes;
    if (!lotteryPrizePools.get(ticket.prize_id, prizes) || prizes.length() == 0)
    {
        dlg_buffer("Something went wrong reading the prize pool for this ticket.");
        return;
    }

    int totalWeight = 0;
    for (uint i = 0; i < prizes.length(); i++)
        totalWeight += prizes[i].weight;

    double totalCoins = 0;
    double totalCookies = 0;
    double totalAutocookie = 0;
    double totalManulcookie = 0;
    double totalCookiespeed = 0;
    double wins = 0;
    double losses = 0;

    // Snapshot bases for percent prizes before applying anything
    double baseCoins = coins;
    double baseCookies = cookies;
    double baseAutocookie = autocookie;
    double baseManulcookie = manulcookie;
    double baseCookiespeed = cookiespeed;

    pool.play_stationary("sounds/minigames/cooky_lottery/scratch.ogg", false);
    wait(random(1000, 2000));

    for (uint i = 0; i < prizes.length(); i++)
    {
        if (totalWeight <= 0) continue;
        double share = floor(count * prizes[i].weight / totalWeight);
        if (prizes[i].target == "none") { losses += share; continue; }
        if (share <= 0) continue;
        wins += share;
        double amount = 0;
        // The target actually paid; a value prize too small to buy one item pays money instead, as in a single scratch.
        string paidTarget = prizes[i].target;
        if (prizes[i].value_mode)
        {
            double midValue = floor((prizes[i].min_amount + prizes[i].max_amount) / 2.0);
            if (paidTarget == "coins")
                amount = midValue * share;
            else
            {
                double unit = lottery_unit_price(paidTarget);
                double perTicket = (unit > 0) ? floor(midValue / unit) : 0;
                if (perTicket >= 1)
                    amount = perTicket * share;
                else
                {
                    paidTarget = "coins";
                    amount = midValue * share;
                }
            }
        }
        else if (prizes[i].use_percent)
        {
            double base = 0;
            if (prizes[i].target == "coins") base = baseCoins;
            else if (prizes[i].target == "cookies") base = baseCookies;
            else if (prizes[i].target == "autocookie") base = baseAutocookie;
            else if (prizes[i].target == "manulcookie") base = baseManulcookie;
            else if (prizes[i].target == "cookiespeed") base = baseCookiespeed;
            double midPct = (prizes[i].min_amount + prizes[i].max_amount) / 2.0;
            amount = floor(base * (midPct / 100.0)) * share;
        }
        else
        {
            double midAmount = floor((prizes[i].min_amount + prizes[i].max_amount) / 2.0);
            amount = midAmount * share;
        }
        if (paidTarget == "coins") totalCoins += amount;
        else if (paidTarget == "cookies") totalCookies += amount;
        else if (paidTarget == "autocookie") totalAutocookie += amount;
        else if (paidTarget == "manulcookie") totalManulcookie += amount;
        else if (paidTarget == "cookiespeed") totalCookiespeed += amount;
    }

    // Remaining tickets lost to rounding go to losses
    losses += count - wins - losses;

    if (totalCoins > 0)       apply_amount_effect("coins", totalCoins, 1, false);
    if (totalCookies > 0)     apply_amount_effect("cookies", totalCookies, 1, false);
    if (totalAutocookie > 0)  apply_amount_effect("autocookie", totalAutocookie, 1, false);
    if (totalManulcookie > 0) apply_amount_effect("manulcookie", totalManulcookie, 1, false);
    if (totalCookiespeed > 0) totalCookiespeed = gain_cookiespeed(totalCookiespeed);
    stat_lottery_wins += wins;
    stat_lottery_losses += losses;
    string endSound = (wins > 0) ? "sounds/minigames/cooky_lottery/win.ogg" : "sounds/minigames/cooky_lottery/lose" + string(random(1, 3)) + ".ogg";
    pool.play_stationary(endSound, false);

    string summary = "You scratched " + format_number(count) + " " + ticket.name + (count == 1 ? "" : "s") + ". ";
    summary += format_number(wins) + " win" + (wins == 1 ? "" : "s") + ", " + format_number(losses) + " loss" + (losses == 1 ? "" : "es") + ". ";
    bool anygain = false;
    if (totalCoins > 0) { summary += "Money: +" + convert_to_currency(totalCoins) + ". "; anygain = true; }
    if (totalCookies > 0) { summary += "Cookies: +" + format_number(totalCookies) + ". "; anygain = true; }
    if (totalAutocookie > 0) { summary += "Auto cookies: +" + format_number(totalAutocookie) + ". "; anygain = true; }
    if (totalManulcookie > 0) { summary += "Manual cookies: +" + format_number(totalManulcookie) + ". "; anygain = true; }
    if (totalCookiespeed > 0) { summary += "Baking speed: +" + format_number(totalCookiespeed) + " ms. "; anygain = true; }
    if (!anygain) summary += "Nothing won this time.";
    dlg_buffer(summary);
}
