class rank_sound_item
{
    double min_amount;
    string sound;
}

class rank_reward_item
{
    int rank;
    string target;
    string min_amount;
    string max_amount;
    string unlock;
    string message;
}

void parse_ranks_table(string filepath, rank_sound_item[]@ sounds_out, rank_reward_item[]@ default_out, rank_reward_item[]@ rewards_out)
{
    rankSummaryMessage = "";
    rankSummaryLossMessage = "";
    config_file f;
    if (!f.open(filepath))
        return;
    string section = "";
    while (!f.eof)
    {
        string line = f.read_line();
        while (line.length() > 0 && (line.substr(line.length() - 1) == "\n" || line.substr(line.length() - 1) == "\r"))
            line = line.substr(0, line.length() - 1);
        if (line.length() == 0 || line.substr(0, 2) == "//" || line.substr(0, 1) == "#" || line.substr(0, 1) == ";")
            continue;
        if (line == "[sounds]") { section = "sounds"; continue; }
        if (line == "[default]") { section = "default"; continue; }
        if (line == "[rewards]") { section = "rewards"; continue; }
        if (line == "[summary]") { section = "summary"; continue; }
        /* Optional: the first line under [summary] is the message spoken when one gain earns several ranks at once,
        and an optional second line replaces it when the rewards add up to a loss, so penalties are not read as earnings. */
        if (section == "summary")
        {
            if (rankSummaryMessage == "") rankSummaryMessage = line;
            else if (rankSummaryLossMessage == "") rankSummaryLossMessage = line;
            continue;
        }
        if (section == "sounds")
        {
            int colon = line.find(":");
            if (colon == -1) continue;
            rank_sound_item item;
            item.min_amount = string_to_number(line.substr(0, colon));
            item.sound = line.substr(colon + 1);
            sounds_out.insert_last(item);
        }
        else if (section == "default")
        {
            string[] parts = parse_delimited_line(line, 4);
            if (parts.length() < 5) continue;
            rank_reward_item item;
            item.rank       = 0;
            item.target     = parts[0];
            item.min_amount = parts[1];
            item.max_amount = parts[2];
            item.unlock     = parts[3];
            item.message    = parts[4];
            default_out.insert_last(item);
        }
        else if (section == "rewards")
        {
            string[] parts = parse_delimited_line(line, 5);
            if (parts.length() < 6) continue;
            rank_reward_item item;
            item.rank       = string_to_int(parts[0]);
            item.target     = parts[1];
            item.min_amount = parts[2];
            item.max_amount = parts[3];
            item.unlock     = parts[4];
            item.message    = parts[5];
            if (item.unlock == "slotmanager")
                slotManagerUnlockRank = item.rank;
            rewards_out.insert_last(item);
        }
    }
    f.close();
}

string apply_rank_reward(rank_reward_item@ item, double current_rank, bool buildMessage = true)
{
    double minVal = eval_event_amount(item.min_amount, current_rank);
    double maxVal = eval_event_amount(item.max_amount, current_rank);
    if (minVal > maxVal) { double tmp = minVal; minVal = maxVal; maxVal = tmp; }
    double amount = random_amount(minVal, maxVal);
    if (minVal >= 0 && maxVal >= 0 && amount < 1.0) amount = 1.0;
    amount = floor(amount);
    lastRewardRolled = amount;
    amount = apply_rank_amount(item, amount);
    // What was really given or taken, so summaries match a penalty capped by what the player had, or speed capped at its limit.
    lastRewardAmount = amount;
    // A big multi-rank gain applies thousands of rewards that are never spoken; skip building their messages.
    if (!buildMessage) return "";
    return format_rank_message(item, amount, current_rank);
}
// Gives an already decided reward amount to its target. Returns the amount applied, which is less for baking speed at its cap.
double apply_rank_amount(rank_reward_item@ item, double amount)
{
    if (item.target == "cookiespeed")
    {
        if (amount >= 0)
            amount = gain_cookiespeed(amount);
        else
        {
            cookiespeed += amount;
            clicktime -= int(amount);
            if (cookiespeed < 0) cookiespeed = 0;
            if (clicktime > 1000) clicktime = 1000;
            cookiespeed = floor(cookiespeed);
        }
    }
    /* A negative amount is a penalty. It goes through the same loss path as events, so it never takes more than the
    player has and lowers auto and manual cookie store prices; passing it as a gain turned every penalty into a gain of 1. */
    else if (amount < 0)
        amount = -apply_amount_effect(item.target, -amount, 2, false);
    else
        apply_amount_effect(item.target, amount, 1, false);
    return amount;
}
string format_rank_message(rank_reward_item@ item, double amount, double current_rank)
{
    dictionary@ tokens = dictionary();
    // A penalty reads as its size, so a message such as You lost %amount% does not say minus.
    double shown = abs(amount);
    tokens.set("amount", (item.target == "coins") ? convert_to_currency(shown) : format_number(shown));
    tokens.set("rank", format_number(current_rank));
    tokens.set("name", playername);
    return format_template(item.message, tokens);
}
// Experience needed to leave rank r: the same formula used everywhere ranks are set up, with the prestige rank discount.
double rank_threshold(double r)
{
    double t = cookiemod * (r * (r * 4));
    if (prestige_rank_discount > 0) t *= max(0.01, 1.0 - (prestige_rank_discount / 100.0));
    return t;
}
/* The rank the current experience reaches, starting above startRank: the first rank whose threshold it has not met.
Found straight from the threshold formula instead of stepping rank by rank, then nudged by a few steps for rounding.
The nudges are capped, since past about 9 quadrillion adding 1 to a double no longer changes it. */
double rank_for_current_xp(double startRank)
{
    double d = (prestige_rank_discount > 0) ? max(0.01, 1.0 - (prestige_rank_discount / 100.0)) : 1.0;
    double target = floor(sqrt(cookieXP / (cookiemod * 4 * d)));
    if (target <= startRank) target = startRank + 1;
    for (int i = 0; i < 8 && rank_threshold(target) <= cookieXP; i++) target += 1;
    for (int i = 0; i < 8 && target > startRank + 1 && rank_threshold(target - 1) > cookieXP; i++) target -= 1;
    return target;
}
/* The average default reward per rank across ranks first to last, from evenly spaced samples. Exact for rewards that
grow in a straight line, like the shipped 100 times rank, and for random ranges it uses the middle of the range. */
double average_rank_reward(rank_reward_item@ item, double first, double last)
{
    int samples = 200;
    double sum = 0;
    for (int k = 0; k < samples; k++)
    {
        double r = first + (last - first) * double(k) / double(samples - 1);
        sum += (eval_event_amount(item.min_amount, r) + eval_event_amount(item.max_amount, r)) / 2.0;
    }
    return sum / samples;
}

void play_rank_sound(double amount)
{
    if (buffer_muted("ranks")) return;
    string soundfile = "";
    for (int i = rankSounds.length() - 1; i >= 0; i--)
    {
        if (amount >= rankSounds[i].min_amount)
        {
            soundfile = rankSounds[i].sound;
            break;
        }
    }
    if (soundfile != "")
        pool.play_stationary(resolve_sound_path(soundfile, "misc"), false);
}

void handle_rank_unlock(string unlock)
{
    if (unlock == "none" || unlock == "") return;
    if (unlock == "blackjack")
        pool.play_stationary("sounds/misc/alert_big.ogg", false);
    else if (unlock == "flipper")
        pool.play_stationary("sounds/misc/alert_big.ogg", false);
    else if (unlock == "slots")
        pool.play_stationary("sounds/misc/alert_big.ogg", false);
    else if (unlock == "lottery")
        pool.play_stationary("sounds/misc/alert_big.ogg", false);
    else if (unlock == "dice")
        pool.play_stationary("sounds/misc/alert_big.ogg", false);
    else if (unlock == "highlow")
        pool.play_stationary("sounds/misc/alert_big.ogg", false);
    else if (unlock == "roulette")
        pool.play_stationary("sounds/misc/alert_big.ogg", false);
    else if (unlock == "slotmanager")
        pool.play_stationary("sounds/misc/alert_big.ogg", false);
    else if (unlock == "combos")
        pool.play_stationary("sounds/misc/alert_big.ogg", false);
}
/* The only rank-up code: the main game loop and every minigame call this, so ranks behave the same everywhere.
Rank is compared as a double throughout, since int(rank) overflows past about rank 2.1 billion.
Every rank the current experience has earned lands in this one call, instead of one rank per frame, which let a
huge gain trickle in for minutes. Each rank still pays its reward as it is crossed; the rank announcement and then
each milestone's sounds and message follow once the loop is done.
A gain of more than RANK_EXACT_LIMIT ranks takes a fast path instead. Late in the game one bake can earn hundreds of
millions of ranks, and stepping through them froze the game, so the final rank comes straight from the threshold
formula, the default reward is paid as one calculated total, and only the milestone ranks crossed are visited. */
const double RANK_EXACT_LIMIT = 1000;
void check_rank()
{
if (cookieXP < xprequired) return;
double fromRank = rank;
double totalReward = 0;
// What the default rewards rolled before applying, so a penalty that found nothing left to take still reads as a loss.
double rolledReward = 0;
bool anyAnnounced = false;
string announceMsg = "";
double announceAmount = 0;
string[] milestoneMsgs;
double[] milestoneAmounts;
string[] milestoneUnlocks;
double targetRank = rank_for_current_xp(fromRank);
if (targetRank - fromRank > RANK_EXACT_LIMIT)
{
    rank = targetRank;
    xprequired = rank_threshold(rank);
    if (rankDefault.length() > 0)
    {
        rank_reward_item@ def = rankDefault[0];
        double total = floor(average_rank_reward(def, fromRank + 1, targetRank) * (targetRank - fromRank));
        lastRewardAmount = total;
        rolledReward = total;
        // Signed, so a default penalty totals as a loss instead of being clamped to zero.
        totalReward = clamp(apply_rank_amount(def, total), -1e308, 1e308);
        handle_rank_unlock(def.unlock);
        // The highest thinned rank at or below the new rank; it was crossed if it is above where the gain started.
        double rankstep = 1;
        while (rankstep * 10 <= targetRank) rankstep *= 10;
        double highestAnnounced = rankstep * floor(targetRank / rankstep);
        if (highestAnnounced > fromRank)
        {
            anyAnnounced = true;
            announceAmount = floor((eval_event_amount(def.min_amount, highestAnnounced) + eval_event_amount(def.max_amount, highestAnnounced)) / 2.0);
            announceMsg = format_rank_message(def, announceAmount, highestAnnounced);
        }
    }
    // Every milestone rank inside the gain, lowest first, each paying one of its rewards like the exact path does.
    double[] milestoneRanks;
    for (uint i = 0; i < rankRewards.length(); i++)
    {
        double mr = double(rankRewards[i].rank);
        if (mr <= fromRank || mr > targetRank || milestoneRanks.find(mr) >= 0) continue;
        uint pos = 0;
        while (pos < milestoneRanks.length() && milestoneRanks[pos] < mr) pos++;
        milestoneRanks.insert_at(pos, mr);
    }
    for (uint m = 0; m < milestoneRanks.length(); m++)
    {
        rank_reward_item[] matching;
        for (uint i = 0; i < rankRewards.length(); i++)
        {
            if (double(rankRewards[i].rank) == milestoneRanks[m])
                matching.insert_last(rankRewards[i]);
        }
        rank_reward_item@ milestone = matching[random(0, matching.length() - 1)];
        milestoneMsgs.insert_last(apply_rank_reward(milestone, milestoneRanks[m]));
        milestoneAmounts.insert_last(lastRewardAmount);
        milestoneUnlocks.insert_last(milestone.unlock);
    }
}
else
{
while (cookieXP >= xprequired)
{
    rank += 1;
    xprequired = rank_threshold(rank);
    if (rankDefault.length() > 0)
    {
        /* Thin out the rank-up announcement and sounds as you climb: every rank up to 9, then every 10th up to 90,
        every 100th up to 900, and so on, always on a multiple of the largest power of ten at or below the rank.
        Only the highest such rank crossed in this call is announced, once, after the loop. */
        double rankstep = 1;
        while (rankstep * 10 <= rank) rankstep *= 10;
        bool announced = (rank - rankstep * floor(rank / rankstep) == 0);
        string defaultMsg = apply_rank_reward(rankDefault[0], rank, announced);
        totalReward = clamp(totalReward + lastRewardAmount, -1e308, 1e308);
        rolledReward = clamp(rolledReward + lastRewardRolled, -1e308, 1e308);
        handle_rank_unlock(rankDefault[0].unlock);
        if (announced)
        {
            anyAnnounced = true;
            announceMsg = defaultMsg;
            announceAmount = lastRewardAmount;
        }
    }
    rank_reward_item[] matching;
    for (uint i = 0; i < rankRewards.length(); i++)
    {
        if (double(rankRewards[i].rank) == rank)
            matching.insert_last(rankRewards[i]);
    }
    if (matching.length() > 0)
    {
        // The reward is paid now; its sounds and message wait until after the rank announcement, as before.
        rank_reward_item@ milestone = matching[random(0, matching.length() - 1)];
        milestoneMsgs.insert_last(apply_rank_reward(milestone, rank));
        milestoneAmounts.insert_last(lastRewardAmount);
        milestoneUnlocks.insert_last(milestone.unlock);
    }
}
}
if (anyAnnounced)
{
    double ranksGained = rank - fromRank;
    /* Several ranks at once speak the [summary] message from ranks.table with the total reward, when the table
    has one; otherwise, and for a single rank up, the highest announced rank's own default message is spoken. */
    if (ranksGained > 1 && rankSummaryMessage != "")
    {
        dictionary@ tokens = dictionary();
        tokens.set("name", playername);
        tokens.set("from", format_number(fromRank));
        tokens.set("rank", format_number(rank));
        tokens.set("ranks", format_number(ranksGained));
        // Read as a size like the single-rank message, so a penalty summary does not say minus.
        double shownTotal = abs(totalReward);
        tokens.set("amount", (rankDefault[0].target == "coins") ? convert_to_currency(shownTotal) : format_number(shownTotal));
        bool summaryLoss = totalReward < 0 || (totalReward == 0 && rolledReward < 0);
        string summaryTemplate = (summaryLoss && rankSummaryLossMessage != "") ? rankSummaryLossMessage : rankSummaryMessage;
        announceMsg = format_template(summaryTemplate, tokens);
        announceAmount = totalReward;
    }
    play_rank_sound(announceAmount);
    if (!buffer_muted("ranks")) pool.play_stationary("sounds/misc/rankach" + random(1, 2) + ".ogg", false);
    speak_buffer(announceMsg, "ranks");
}
// Every milestone crossed fires in order. They follow the main screen's rule everywhere, minigames included: spoken while baking mode is on, a dialog otherwise.
for (uint i = 0; i < milestoneMsgs.length(); i++)
{
    play_rank_sound(milestoneAmounts[i]);
    if (!buffer_muted("ranks")) pool.play_stationary("sounds/misc/rankach" + random(1, 2) + ".ogg", false);
    handle_rank_unlock(milestoneUnlocks[i]);
    if (bakemode == 1)
        speak_buffer(milestoneMsgs[i], "critical");
    else
        dlg_buffer(milestoneMsgs[i], "critical");
}
}
