class payout_item
{
    int matches;
    double multiplier;
    string sound;
    string message;
}

void parse_slots_table(string filepath, string[]@ symbols_out, payout_item[]@ payouts_out, int &out reels_out, double &out min_bet_out, double &out max_bet_out, double &out confirm_threshold_out, bool &out confirm_use_percent_out)
{
    min_bet_out = 1.0;
    max_bet_out = 0.0;
    confirm_threshold_out = 0.0;
    confirm_use_percent_out = false;
    slotHouseEdge = 5.0;
    slotMinSymbols = 10;
    slotBetSound1 = "slot_machine/bet1.ogg";
    slotBetSound2 = "slot_machine/bet2.ogg";
    slotBetSound3 = "slot_machine/bet3.ogg";
    slotLeverSound = "slot_machine/lever.ogg";
    slotSpinSound = "slot_machine/spin.ogg";
    slotStopSound1 = "slot_machine/stop1.ogg";
    slotStopSound2 = "slot_machine/stop2.ogg";
    slotStopSound3 = "slot_machine/stop3.ogg";
    file f;
    if (!f.open(filepath, "r"))
        return;
    bool in_payouts = false;
    while (!f.eof)
    {
        string line = f.read_line();
        while (line.length() > 0 && (line.substr(line.length() - 1) == "\n" || line.substr(line.length() - 1) == "\r"))
            line = line.substr(0, line.length() - 1);
        if (line.length() == 0 || line.substr(0, 2) == "//" || line.substr(0, 1) == "#" || line.substr(0, 1) == ";")
            continue;
        if (line == "[payouts]")
        {
            in_payouts = true;
            continue;
        }
        if (!in_payouts)
        {
            int eq = line.find("=");
            if (eq == -1) continue;
            string key = line.substr(0, eq);
            string val = line.substr(eq + 1);
            if (key == "reels")
            {
                reels_out = max(2, string_to_int(val));
            }
            else if (key == "min_bet")
            {
                min_bet_out = max(1.0, string_to_number(val));
            }
            else if (key == "max_bet")
            {
                max_bet_out = max(0.0, string_to_number(val));
            }
            else if (key == "house_edge")
            {
                // Percent the house keeps on average at every symbol count; payouts are scaled per spin to hit it.
                slotHouseEdge = max(0.0, min(99.0, string_to_number(val)));
            }
            else if (key == "min_symbols")
            {
                slotMinSymbols = int(max(2.0, double(string_to_int(val))));
            }
            else if (key == "confirm_threshold")
            {
                int colon = val.find(":");
                if (colon != -1)
                {
                    confirm_threshold_out = max(0.0, string_to_number(val.substr(0, colon)));
                    confirm_use_percent_out = (val.substr(colon + 1) == "true");
                }
                else
                    confirm_threshold_out = max(0.0, string_to_number(val));
            }
            else if (key == "symbols")
            {
                string sortMode = "none";
                string listPart = val;
                int colon = val.find(":");
                if (colon != -1)
                {
                    string prefix = val.substr(0, colon);
                    while (prefix.length() > 0 && prefix.substr(0, 1) == " ")
                        prefix = prefix.substr(1);
                    while (prefix.length() > 0 && prefix.substr(prefix.length() - 1) == " ")
                        prefix = prefix.substr(0, prefix.length() - 1);
                    if (prefix == "asc" || prefix == "dsc" || prefix == "none")
                    {
                        sortMode = prefix;
                        listPart = val.substr(colon + 1);
                    }
                }
                string[] parts = listPart.split(",");
                for (uint i = 0; i < parts.length(); i++)
                {
                    string s = parts[i];
                    while (s.length() > 0 && s.substr(0, 1) == " ")
                        s = s.substr(1);
                    while (s.length() > 0 && s.substr(s.length() - 1) == " ")
                        s = s.substr(0, s.length() - 1);
                    if (s.length() > 0)
                        symbols_out.insert_last(s);
                }
                if (sortMode == "asc") symbols_out.sort_ascending();
                else if (sortMode == "dsc") symbols_out.sort_descending();
            }
            else if (key == "bet_sound1") slotBetSound1 = val;
            else if (key == "bet_sound2") slotBetSound2 = val;
            else if (key == "bet_sound3") slotBetSound3 = val;
            else if (key == "lever_sound") slotLeverSound = val;
            else if (key == "spin_sound") slotSpinSound = val;
            else if (key == "stop_sound1") slotStopSound1 = val;
            else if (key == "stop_sound2") slotStopSound2 = val;
            else if (key == "stop_sound3") slotStopSound3 = val;
        }
        else
        {
            string[] parts = parse_delimited_line(line, 3);
            if (parts.length() < 4) continue;
            payout_item item;
            item.matches    = string_to_int(parts[0]);
            item.multiplier = string_to_number(parts[1]);
            item.sound      = parts[2];
            item.message    = parts[3];
            payouts_out.insert_last(item);
        }
    }
    f.close();
}

double[] slot_match_distribution(int symbolCount, int reels)
{
    /* Chance that the largest group of matching symbols is exactly k, for k = 0..reels, when every checked
    symbol is equally likely on each reel. Uses P(largest <= m) = reels! * [x^reels] (sum over j = 0..m of
    (x / symbolCount)^j / j!) ^ symbolCount, built by repeated polynomial multiplication cut off at degree
    reels, then takes differences. Index 0 is always 0. */
    double[] dist(reels + 1, 0.0);
    if (symbolCount < 1 || reels < 1) return dist;
    double reelsFact = 1;
    for (int i = 2; i <= reels; i++) reelsFact *= i;
    double prevCum = 0;
    for (int m = 1; m <= reels; m++)
    {
        double[] base(reels + 1, 0.0);
        double term = 1;
        for (int j = 0; j <= m; j++)
        {
            if (j > 0) term = term / (double(symbolCount) * j);
            base[j] = term;
        }
        double[] poly(reels + 1, 0.0);
        poly[0] = 1;
        for (int n = 0; n < symbolCount; n++)
        {
            double[] product(reels + 1, 0.0);
            for (int a = 0; a <= reels; a++)
            {
                if (poly[a] == 0) continue;
                for (int b = 0; a + b <= reels && b <= m; b++)
                    product[a + b] += poly[a] * base[b];
            }
            poly = product;
        }
        // The largest match can never exceed the reel count, so the last step is exactly 1; this removes rounding drift.
        double cum = (m == reels) ? 1.0 : poly[reels] * reelsFact;
        dist[m] = max(0.0, cum - prevCum);
        prevCum = cum;
    }
    return dist;
}

payout_item@ slot_payout_for_match(int maxMatch)
{
    // The same lookup slotsgame uses: the first row whose matches equals the largest match, with the 0 row as the loss when nothing matches.
    for (uint i = 0; i < slotPayouts.length(); i++)
    {
        if (slotPayouts[i].matches == maxMatch || (maxMatch < 2 && slotPayouts[i].matches == 0))
            return @slotPayouts[i];
    }
    return null;
}

double slot_payout_scale(int symbolCount)
{
    /* Factor every paying multiplier is multiplied by so the average result per bet is exactly minus house_edge
    at this symbol count: scale = (chance of losing - house edge) / (sum of chance times multiplier over paying rows).
    A match size with no payout row refunds the bet and counts as neither. Returns -1 when the chance of losing is
    not above the house edge, since no positive payout could then reach it (too few symbols for the reel count),
    and 1 when no row pays anything, since there is nothing to scale. */
    double[] dist = slot_match_distribution(symbolCount, slotReels);
    double loseChance = 0;
    double weightedPay = 0;
    for (int k = 1; k <= slotReels; k++)
    {
        payout_item@ row = slot_payout_for_match(k);
        if (row is null) continue;
        if (row.multiplier <= 0) loseChance += dist[k];
        else weightedPay += dist[k] * row.multiplier;
    }
    if (weightedPay <= 0) return 1.0;
    double edge = slotHouseEdge / 100.0;
    if (loseChance - edge <= 0) return -1;
    return (loseChance - edge) / weightedPay;
}

string slot_match_name(int k)
{
    if (k == 2) return "a pair";
    if (k == 3) return "three of a kind";
    if (k == 4) return "four of a kind";
    if (k == 5) return "five of a kind";
    return string(k) + " of a kind";
}

string slot_payouts_summary(int checkedCount)
{
    /* One sentence for the check payouts button: the chance of losing and what each paying match size pays
    at the current number of checked symbols, using the same scale the next spin would use. */
    if (checkedCount < slotMinSymbols)
        return "Check at least " + slotMinSymbols + " symbols to see the payouts.";
    double scale = slot_payout_scale(checkedCount);
    if (scale < 0)
        return "With " + slotReels + " reels, please check more symbols so the payouts can be balanced.";
    double[] dist = slot_match_distribution(checkedCount, slotReels);
    double loseChance = 0;
    string[] parts;
    for (int k = 1; k <= slotReels; k++)
    {
        payout_item@ row = slot_payout_for_match(k);
        if (row is null) continue;
        if (row.multiplier <= 0) loseChance += dist[k];
        else parts.insert_last(slot_match_name(k) + " pays " + round(row.multiplier * scale, 2) + " times your bet");
    }
    string msg = "With " + checkedCount + " symbols checked, you lose about " + round(loseChance * 100, 0) + " percent of spins";
    if (parts.length() > 0) msg += ", " + join_spoken_list(parts);
    return msg + ".";
}
