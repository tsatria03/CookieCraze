class quests_config
{
    int max_active;
    int require_all;
    string reroll_target;
    double reroll_base_cost;
    double reroll_multiplier;
    string reroll_sound;
    string reroll_message;
    int reroll_warning = 3;
}

class quest_item
{
    string id;
    string name;
    string stat;
    double threshold;
    bool use_percent;
    bool required;
    bool advance;
    int difficulty;
    double growth = 1;
    bool infinite = false;
    int difficulty_step = 0;
    string description;
}

class reroll_history_entry
{
    string old_name;
    string new_name;
    double cost;
    string target;
}

quests_config questsConfig;
/* Quest rewards. Each quest pays its difficulty's default reward the moment it is finished, unless the [rewards]
section of quests.table gives it its own. Index is the difficulty, 1 to 10; an empty target pays nothing. */
string[] questDefaultRewardTarget;
string[] questDefaultRewardAmount;
string questCompleteMessage = "Quest complete! %quest%. You received %reward%.";
string questCompleteSound = "";
class quest_reward_override
{
    string id;
    string target;
    string amount;
    string message;
}
quest_reward_override[] questRewardOverrides;
// The active quests that have already paid their reward this run, so each one pays once. Saved with the game.
dictionary questsRewarded;
quest_item[] loadedQuests;
quest_item[] activeQuests;
dictionary completedQuestIds;
// Completed quest ids from the save that quests.table does not have right now; saved back unchanged.
string[] unknownCompletedQuestIds;
dictionary questEndlessCounts;
int questRerollCount = 0;
/* Each stat's value at the start of the current run. Prestige keeps minigame and other lifetime stats, so a quest
counts only what was done this run: its progress is the stat minus this baseline. Saved with the game. */
dictionary questStatBaseline;

/* Count stats a quest measures from the run's start. Left out: rank, which a quest compares directly; the two
personal bests, highest combo and highest higher or lower streak, where subtracting makes no sense; and idle auto
slots, which is worked out from the slots you own rather than counted. */
string[] quest_baseline_stats()
{
    string[] stats = {STAT_COOKIES_BAKED, STAT_MANUAL_BAKES_PERFORMED, STAT_AUTO_BAKES_PERFORMED, STAT_COINS_EARNED, STAT_COINS_SPENT,
        STAT_SINGLES_PURCHASED, STAT_BUNDLES_PURCHASED, STAT_BAKER_EVENTS_FIRED, STAT_FLIPPER_EVENTS_FIRED, STAT_FLIPPER_FLIPS,
        STAT_COOKY_FLIPS, STAT_PENNY_FLIPS, STAT_DICE_ROLLS, STAT_DICE_WINS, STAT_DICE_LOSSES, STAT_DON_GAMES, STAT_DON_WINS, STAT_DON_LOSSES,
        STAT_DON_CORRECT_CALLS, STAT_DON_SUIT_HITS, STAT_DON_JOKERS,
        STAT_BOOSTS_BOUGHT, STAT_BOOSTS_ACTIVATED, STAT_BOOST_SLOTS_PURCHASED, STAT_BOOSTS_COMPLETED, STAT_BOOST_MINUTES, STAT_BOOSTS_ENDED, STAT_SLOT_SPINS, STAT_SLOT_WINS,
        STAT_SLOT_LOSSES, STAT_BLACKJACK_HANDS, STAT_BLACKJACK_WINS, STAT_BLACKJACK_LOSSES, STAT_BLACKJACK_PUSHES,
        STAT_AUTO_SLOTS_PURCHASED, STAT_MANUAL_SLOTS_PURCHASED, STAT_AUTO_SLOTS_ENABLED, STAT_LOTTERY_TICKETS_BOUGHT,
        STAT_LOTTERY_TICKETS_SCRATCHED, STAT_LOTTERY_WINS, STAT_LOTTERY_LOSSES, STAT_HIGHLOW_GAMES, STAT_HIGHLOW_WINS,
        STAT_HIGHLOW_LOSSES, STAT_ROULETTE_GAMES, STAT_ROULETTE_WINS, STAT_ROULETTE_LOSSES, STAT_ROULETTE_STRAIGHT_HITS,
        STAT_ROULETTE_BREAKS, STAT_QUESTS_COMPLETED, STAT_REROLLS_PERFORMED, STAT_COMBOS_STARTED, STAT_COMBOS_BROKEN};
    return stats;
}

// Records every count stat's value now, as the start of a run. Called when a run starts (prestige or new game).
void snapshot_quest_baselines()
{
    questStatBaseline.delete_all();
    string[] stats = quest_baseline_stats();
    for (uint i = 0; i < stats.length(); i++)
        questStatBaseline.set(stats[i], get_stat_value(stats[i]));
}

/* For saves from before baselines existed. Stats that prestige already kept (blackjack, slots, lottery, combos,
quests completed, rerolls) start from their value at load, so quests on them can't be instantly complete. Every
other stat starts from 0, since it was reset at the last prestige and its value is already this run's progress. */
void migrate_quest_baselines()
{
    questStatBaseline.delete_all();
    string[] kept = {STAT_BLACKJACK_HANDS, STAT_BLACKJACK_WINS, STAT_BLACKJACK_LOSSES, STAT_BLACKJACK_PUSHES,
        STAT_SLOT_SPINS, STAT_SLOT_WINS, STAT_SLOT_LOSSES, STAT_LOTTERY_TICKETS_BOUGHT, STAT_LOTTERY_TICKETS_SCRATCHED,
        STAT_LOTTERY_WINS, STAT_LOTTERY_LOSSES, STAT_COMBOS_STARTED, STAT_COMBOS_BROKEN, STAT_QUESTS_COMPLETED,
        STAT_REROLLS_PERFORMED};
    for (uint i = 0; i < kept.length(); i++)
        questStatBaseline.set(kept[i], get_stat_value(kept[i]));
}

// A quest stat's progress this run: the stat minus its baseline, or the stat itself when it has no baseline.
double quest_stat_progress(string stat)
{
    double value = get_stat_value(stat);
    double baseline = 0;
    if (questStatBaseline.exists(stat)) questStatBaseline.get(stat, baseline);
    double progress = value - baseline;
    return (progress < 0) ? 0 : progress;
}

void parse_quests_table(string filepath, quest_item[]@ quests_out)
{
    quests_out.resize(0);
    // Rewards return to their defaults on every load, so Control L picks up a removed line.
    questDefaultRewardTarget.resize(0);
    questDefaultRewardTarget.resize(11);
    questDefaultRewardAmount.resize(0);
    questDefaultRewardAmount.resize(11);
    questCompleteMessage = "Quest complete! %quest%. You received %reward%.";
    questCompleteSound = "";
    questRewardOverrides.resize(0);
    config_file f;
    if (!f.open(filepath))
        return;
    string section = "";
    while (!f.eof)
    {
        string line = f.read_line();
        while (line.length() > 0 && (line.substr(line.length() - 1) == "\n" || line.substr(line.length() - 1) == "\r"))
            line = line.substr(0, line.length() - 1);
        if (line.length() == 0 || line.substr(0, 2) == "//" || line.substr(0, 1) == "#" || line.substr(0, 1) == ";")
            continue;
        if (line == "[settings]") { section = "settings"; continue; }
        if (line == "[quests]") { section = "quests"; continue; }
        if (line == "[rewards]") { section = "rewards"; continue; }
        if (section == "settings")
        {
            int eq = line.find("=");
            if (eq == -1) continue;
            string key = line.substr(0, eq);
            string val = line.substr(eq + 1);
            if (key == "max_active")
            {
                questsConfig.max_active = string_to_int(val);
                if (questsConfig.max_active > 10) questsConfig.max_active = 10;
                if (questsConfig.max_active < 1)  questsConfig.max_active = 1;
            }
            else if (key == "require_all")       { questsConfig.require_all = string_to_int(val); if (questsConfig.require_all < 1) questsConfig.require_all = 1; if (questsConfig.require_all > 3) questsConfig.require_all = 3; }
            else if (key == "reroll_target")     questsConfig.reroll_target = val;
            else if (key == "reroll_base_cost")  questsConfig.reroll_base_cost = string_to_number(val);
            else if (key == "reroll_multiplier") questsConfig.reroll_multiplier = string_to_number(val);
            else if (key == "reroll_sound")           questsConfig.reroll_sound = val;
            else if (key == "reroll_message")         questsConfig.reroll_message = val;
            else if (key == "quest_complete_message") questCompleteMessage = val;
            else if (key == "quest_complete_sound") questCompleteSound = val;
            else if (key.length() > 7 && key.substr(0, 7) == "reward_")
            {
                // reward_3=coins:400*rank is the default reward for difficulty 3 quests.
                int diff = string_to_int(key.substr(7));
                int sep = val.find(":");
                if (diff >= 1 && diff <= 10 && sep > 0 && quest_reward_target_ok(val.substr(0, sep)))
                {
                    questDefaultRewardTarget[diff] = val.substr(0, sep);
                    questDefaultRewardAmount[diff] = val.substr(sep + 1);
                }
            }
            else if (key == "reroll_warning") { questsConfig.reroll_warning = string_to_int(val); if (questsConfig.reroll_warning < 1) questsConfig.reroll_warning = 1; if (questsConfig.reroll_warning > 5) questsConfig.reroll_warning = 5; }
        }
        else if (section == "quests")
        {
            string[] parts = parse_delimited_line(line, 11);
            if (parts.length() < 9) continue;
            quest_item item;
            item.id          = parts[0];
            item.name        = parts[1];
            item.stat        = parts[2];
            item.threshold   = string_to_number(parts[3]);
            item.use_percent = (parts[4] == "true");
            item.required    = (parts[5] == "true");
            item.advance     = (parts[6] == "true");
            item.difficulty  = string_to_int(parts[7]);
            if (item.difficulty < 1)  item.difficulty = 1;
            if (item.difficulty > 10) item.difficulty = 10;
            /* Two formats are supported, distinguished by field count so pre-endless quests.table files
            still parse. New (12 fields, endless-aware):
            id:name:stat:threshold:use_percent:required:advance:difficulty:growth:infinite:difficulty_step:description
            Old (9 fields): id:name:stat:threshold:use_percent:required:advance:difficulty:description */
            if (parts.length() >= 12)
            {
                item.growth = string_to_number(parts[8]);
                if (item.growth <= 0) item.growth = 1;
                item.infinite = (parts[9] == "true");
                item.difficulty_step = string_to_int(parts[10]);
                if (item.difficulty_step < 0) item.difficulty_step = 0;
                item.description = parts[11];
            }
            else
            {
                item.growth = 1;
                item.infinite = false;
                item.difficulty_step = 0;
                string desc = parts[8];
                for (uint p = 9; p < parts.length(); p++) desc += ":" + parts[p];
                item.description = desc;
            }
            quests_out.insert_last(item);
        }
        else if (section == "rewards")
        {
            // quest_id:target:amount:message, the message optional and free to contain colons.
            string[] parts = parse_delimited_line(line, 3);
            if (parts.length() < 3 || !quest_reward_target_ok(parts[1]) || parts[2] == "") continue;
            quest_reward_override o;
            o.id = parts[0];
            o.target = parts[1];
            o.amount = parts[2];
            o.message = (parts.length() >= 4) ? parts[3] : "";
            questRewardOverrides.insert_last(o);
        }
    }
    f.close();
}

// Quest rewards give money, cookies, auto cookies, or manual cookies. Baking speed is left out on purpose.
bool quest_reward_target_ok(string target)
{
    return target == "coins" || target == "cookies" || target == "autocookie" || target == "manulcookie";
}

bool quest_is_complete(quest_item@ q)
{
    return quest_stat_progress(q.stat) >= q.threshold;
}

/* Marks every active quest that is already finished as paid, without paying it. A quest only pays when you finish it
after it was handed to you, so a run's new quests, a rerolled quest, or quests finished before this update loaded
never pay for nothing. Quests on a personal best, such as your highest combo, can start a run already finished. */
void mark_finished_quests_rewarded()
{
    for (uint i = 0; i < activeQuests.length(); i++)
        if (quest_is_complete(activeQuests[i])) questsRewarded.set(activeQuests[i].id, true);
}

// Pays and announces every active quest finished since the last check. Runs wherever achievements are checked.
void check_quest_rewards()
{
    for (uint i = 0; i < activeQuests.length(); i++)
    {
        if (questsRewarded.exists(activeQuests[i].id)) continue;
        if (!quest_is_complete(activeQuests[i])) continue;
        questsRewarded.set(activeQuests[i].id, true);
        grant_quest_reward(activeQuests[i]);
    }
}

/* Pays a finished quest: its own reward from the [rewards] section, or else the default for its difficulty, using the
highest difficulty with a default at or below it. Amounts can use rank, such as 400*rank. An endless quest is paid by the
difficulty it starts at in quests.table, not the one it has climbed to: it returns every run, and its reward already grows
with your rank, so paying the top default each time would make it worth more than every other quest. */
void grant_quest_reward(quest_item@ q)
{
    string target = "";
    string amountText = "";
    string message = questCompleteMessage;
    bool found = false;
    for (uint i = 0; i < questRewardOverrides.length(); i++)
    {
        if (questRewardOverrides[i].id != q.id) continue;
        target = questRewardOverrides[i].target;
        amountText = questRewardOverrides[i].amount;
        if (questRewardOverrides[i].message != "") message = questRewardOverrides[i].message;
        found = true;
        break;
    }
    if (!found && questDefaultRewardTarget.length() == 11)
    {
        int startDifficulty = q.difficulty;
        if (q.infinite)
        {
            for (uint i = 0; i < loadedQuests.length(); i++)
                if (loadedQuests[i].id == q.id) { startDifficulty = loadedQuests[i].difficulty; break; }
        }
        for (int d = startDifficulty; d >= 1; d--)
        {
            if (questDefaultRewardTarget[d] == "") continue;
            target = questDefaultRewardTarget[d];
            amountText = questDefaultRewardAmount[d];
            break;
        }
    }
    double amount = (target == "") ? 0 : floor(eval_event_amount(amountText, rank));
    string rewardText = "";
    if (amount > 0)
    {
        apply_amount_effect(target, amount, 1, false);
        if (target == "coins") rewardText = convert_to_currency(amount);
        else if (target == "cookies") rewardText = count_text(amount, "cookie", "cookies");
        else if (target == "autocookie") rewardText = count_text(amount, "auto cookie", "auto cookies");
        else rewardText = count_text(amount, "manual cookie", "manual cookies");
    }
    // A quest with no reward still announces itself, just without the reward sentence.
    if (rewardText == "") message = "Quest complete! %quest%.";
    message = string_replace(message, "%quest%", q.name, true);
    message = string_replace(message, "%reward%", rewardText, true);
    message = string_replace(message, "%amount%", rewardText, true);
    // The sound goes quiet with the quests buffer, the same as its message.
    if (questCompleteSound != "" && !buffer_muted("quests")) pool.play_stationary("sounds/misc/" + resolve_sound(questCompleteSound), false);
    speak_buffer(message, "quests");
}

double get_quest_endless_count(string id)
{
    double c = 0;
    if (questEndlessCounts.exists(id)) questEndlessCounts.get(id, c);
    return c;
}
double endless_threshold(quest_item@ q)
{
    /* An infinite quest's active threshold escalates by its growth multiplier for each past completion. */
    if (!q.infinite) return q.threshold;
    return floor(q.threshold * pow(q.growth, get_quest_endless_count(q.id)));
}
int endless_difficulty(quest_item@ q)
{
    /* With difficulty_step > 0 the quest climbs one difficulty tier every difficulty_step completions, capped at 10. */
    if (!q.infinite || q.difficulty_step <= 0) return q.difficulty;
    int d = q.difficulty + int(get_quest_endless_count(q.id) / double(q.difficulty_step));
    if (d < 1) d = 1;
    if (d > 10) d = 10;
    return d;
}
void escalate_active_quests()
{
    /* Rewrites each active infinite quest to its current escalated tier (threshold + effective difficulty)
    and fills %threshold% in every active quest's name. NOT idempotent (it reads the threshold as the base),
    so call exactly once after activeQuests is (re)built — from assign_quests, and again after a save-load. */
    for (uint i = 0; i < activeQuests.length(); i++)
        escalate_quest(activeQuests[i]);
}
void escalate_quest(quest_item@ q)
{
    /* Escalates one freshly copied quest: an infinite quest moves to its current tier (threshold + effective
    difficulty), and %threshold% in its name is filled. Same NOT-idempotent rule: call once per fresh copy. */
    if (q.infinite)
    {
        q.threshold  = endless_threshold(q);
        q.difficulty = endless_difficulty(q);
    }
    q.name = string_replace(q.name, "%threshold%", format_quest_value(q.stat, q.threshold), true);
}
void assign_quests()
{
    activeQuests.resize(0);
    if (loadedQuests.length() == 0 || questsConfig.max_active < 1) return;
    int maxDiff = 0;
    for (uint i = 0; i < loadedQuests.length(); i++)
    {
        if (loadedQuests[i].difficulty > maxDiff)
            maxDiff = loadedQuests[i].difficulty;
    }
    if (maxDiff > 10) maxDiff = 10;
    if (maxDiff < 1)  maxDiff = 1;

    int slots = questsConfig.max_active;
    int[] slotDifficulties;
    for (int s = 0; s < slots; s++)
    {
        int diff = 1 + int(floor(double(s) * double(maxDiff - 1) / double(slots > 1 ? slots - 1 : 1)));
        slotDifficulties.insert_last(diff);
    }

    bool[] slotFilled;
    string[] assignedRequiredStats;
    for (int s = 0; s < slots; s++) slotFilled.insert_last(false);
    for (uint i = 0; i < loadedQuests.length(); i++)
    {
        if (!loadedQuests[i].required) continue;
        bool statAlreadyAssigned = false;
        for (uint a = 0; a < assignedRequiredStats.length(); a++)
        {
            if (assignedRequiredStats[a] == loadedQuests[i].stat) { statAlreadyAssigned = true; break; }
        }
        if (statAlreadyAssigned) continue;
        bool completed = completedQuestIds.exists(loadedQuests[i].id);
        if (completed && loadedQuests[i].advance)
        {
            quest_item@ next = find_next_tier(loadedQuests[i].stat, loadedQuests[i].difficulty, true);
            if (next !is null)
            {
                int bestSlot = -1;
                int bestDiff = -1;
                for (int s = 0; s < slots; s++)
                {
                    if (slotFilled[s]) continue;
                    int d = slotDifficulties[s];
                    if (bestSlot == -1 || abs(d - next.difficulty) < abs(bestDiff - next.difficulty))
                    {
                        bestSlot = s;
                        bestDiff = d;
                    }
                }
                if (bestSlot != -1)
                {
                    activeQuests.insert_last(next);
                    slotFilled[bestSlot] = true;
                    assignedRequiredStats.insert_last(next.stat);
                }
            }
        }
        else if (!completed)
        {
            int eff = endless_difficulty(loadedQuests[i]);
            int chosenSlot = -1;
            for (int s = 0; s < slots; s++)
            {
                if (!slotFilled[s] && slotDifficulties[s] == eff) { chosenSlot = s; break; }
            }
            /* Fallback so a required quest is never dropped: if no open slot matches its difficulty tag
            exactly (e.g. an endless quest whose tag has climbed past every slot), take the nearest open slot. */
            if (chosenSlot == -1)
            {
                for (int s = 0; s < slots; s++)
                {
                    if (slotFilled[s]) continue;
                    if (chosenSlot == -1 || abs(slotDifficulties[s] - eff) < abs(slotDifficulties[chosenSlot] - eff))
                        chosenSlot = s;
                }
            }
            if (chosenSlot != -1)
            {
                activeQuests.insert_last(loadedQuests[i]);
                slotFilled[chosenSlot] = true;
                assignedRequiredStats.insert_last(loadedQuests[i].stat);
            }
        }
    }

    for (int s = 0; s < slots; s++)
    {
        if (slotFilled[s]) continue;
        int targetDiff = slotDifficulties[s];
        quest_item[] candidates;
        for (uint i = 0; i < loadedQuests.length(); i++)
        {
            if (loadedQuests[i].required) continue;
            bool completed = completedQuestIds.exists(loadedQuests[i].id);
            if (completed && loadedQuests[i].advance) continue;
            bool alreadyActive = false;
            for (uint a = 0; a < activeQuests.length(); a++)
            {
                if (activeQuests[a].id == loadedQuests[i].id) { alreadyActive = true; break; }
            }
            if (alreadyActive) continue;
            bool statAlreadyActive = false;
            for (uint a = 0; a < activeQuests.length(); a++)
            {
                if (activeQuests[a].stat == loadedQuests[i].stat) { statAlreadyActive = true; break; }
            }
            if (statAlreadyActive) continue;
            candidates.insert_last(loadedQuests[i]);
        }
        quest_item[] preferred;
        for (uint c = 0; c < candidates.length(); c++)
        {
            if (endless_difficulty(candidates[c]) == targetDiff) preferred.insert_last(candidates[c]);
        }
        quest_item[]@ pool = preferred.length() > 0 ? preferred : candidates;
        if (pool.length() > 0)
        {
            int idx = random(0, pool.length() - 1);
            activeQuests.insert_last(pool[idx]);
            slotFilled[s] = true;
        }
    }

    escalate_active_quests();
    for (uint i = 0; i < activeQuests.length(); i++)
    {
        for (uint j = i + 1; j < activeQuests.length(); j++)
        {
            if (activeQuests[j].difficulty < activeQuests[i].difficulty)
            {
                quest_item tmp = activeQuests[i];
                activeQuests[i] = activeQuests[j];
                activeQuests[j] = tmp;
            }
        }
    }
}

bool restore_active_quests(string[]@ ids)
{
    /* Rebuilds activeQuests from the given ids using fresh copies from loadedQuests, then escalates them once.
    Returns false when fewer than max_active ids still exist, so the caller can fall back to assign_quests().
    Used by readdata and reload_config so reloading keeps your quests instead of rolling a new set. */
    activeQuests.resize(0);
    for (uint i = 0; i < ids.length(); i++)
    {
        for (uint j = 0; j < loadedQuests.length(); j++)
        {
            if (loadedQuests[j].id == ids[i])
            {
                activeQuests.insert_last(loadedQuests[j]);
                break;
            }
        }
    }
    if (int(activeQuests.length()) < questsConfig.max_active) return false;
    escalate_active_quests();
    return true;
}

quest_item@ find_next_tier(string stat, int currentDiff, bool required)
{
    quest_item@ best = null;
    for (uint i = 0; i < loadedQuests.length(); i++)
    {
        if (loadedQuests[i].stat != stat) continue;
        if (loadedQuests[i].required != required) continue;
        if (loadedQuests[i].difficulty <= currentDiff) continue;
        if (completedQuestIds.exists(loadedQuests[i].id) && loadedQuests[i].advance) continue;
        if (best is null || loadedQuests[i].difficulty < best.difficulty)
            @best = loadedQuests[i];
    }
    return best;
}

quest_item@ find_next_tier_any(int currentDiff, bool required)
{
    quest_item@ best = null;
    for (uint i = 0; i < loadedQuests.length(); i++)
    {
        if (loadedQuests[i].required != required) continue;
        if (loadedQuests[i].difficulty <= currentDiff) continue;
        if (completedQuestIds.exists(loadedQuests[i].id) && loadedQuests[i].advance) continue;
        if (best is null || loadedQuests[i].difficulty < best.difficulty)
            @best = loadedQuests[i];
    }
    return best;
}

void mark_completed_quests()
{
    for (uint i = 0; i < activeQuests.length(); i++)
    {
        if (activeQuests[i].infinite) continue;
        if (!activeQuests[i].advance) continue;
        if (quest_stat_progress(activeQuests[i].stat) < activeQuests[i].threshold) continue;
        if (!completedQuestIds.exists(activeQuests[i].id)) { completedQuestIds.set(activeQuests[i].id, true); stat_quests_completed++; }
    }
}
void advance_endless_quests()
{
    /* Bumps each completed infinite quest's completion count so it returns harder next cycle. Call on
    prestige, before the prestige-points calc, so this run's completion counts toward this payout. */
    for (uint i = 0; i < activeQuests.length(); i++)
    {
        if (!activeQuests[i].infinite) continue;
        if (quest_stat_progress(activeQuests[i].stat) < activeQuests[i].threshold) continue;
        double c = 0;
        if (questEndlessCounts.exists(activeQuests[i].id)) questEndlessCounts.get(activeQuests[i].id, c);
        questEndlessCounts.set(activeQuests[i].id, c + 1);
        stat_quests_completed++;
    }
}
double total_endless_completions()
{
    /* Sum of every infinite quest's completion count. Each completion adds +1 to the prestige-points multiplier. */
    double total = 0;
    string[] keys = questEndlessCounts.get_keys();
    for (uint i = 0; i < keys.length(); i++)
    {
        double c = 0;
        questEndlessCounts.get(keys[i], c);
        total += c;
    }
    return total;
}

/* Quests the active quest at questIndex could be rerolled into, using the same rules assign_quests uses to fill a
slot: not required, the same escalated difficulty, not a tier you already finished, not already active, and not on a
stat another active quest already tracks. The quest being replaced doesn't count, so its own stat is allowed. */
quest_item[] reroll_candidates(int questIndex)
{
    quest_item[] candidates;
    if (questIndex < 0 || questIndex >= int(activeQuests.length())) return candidates;
    int targetDiff = activeQuests[questIndex].difficulty;
    for (uint i = 0; i < loadedQuests.length(); i++)
    {
        if (loadedQuests[i].required) continue;
        // Match on the escalated difficulty, the same way assign_quests picks quests for a slot.
        if (endless_difficulty(loadedQuests[i]) != targetDiff) continue;
        if (completedQuestIds.exists(loadedQuests[i].id) && loadedQuests[i].advance) continue;
        bool blocked = false;
        for (uint a = 0; a < activeQuests.length(); a++)
        {
            if (activeQuests[a].id == loadedQuests[i].id) { blocked = true; break; }
            if (int(a) != questIndex && activeQuests[a].stat == loadedQuests[i].stat) { blocked = true; break; }
        }
        if (!blocked) candidates.insert_last(loadedQuests[i]);
    }
    return candidates;
}
// True when the active quest with this id has at least one quest it could be rerolled into.
bool quest_can_reroll(string questId)
{
    for (uint i = 0; i < activeQuests.length(); i++)
    {
        if (activeQuests[i].id == questId) return reroll_candidates(int(i)).length() > 0;
    }
    return false;
}
void reroll_quest(int questIndex)
{
    if (questIndex < 0 || questIndex >= int(activeQuests.length())) return;
    if (activeQuests[questIndex].required) return;
    // Find the replacement before charging anything, so a reroll with nothing to swap in costs nothing.
    quest_item[] candidates = reroll_candidates(questIndex);
    if (candidates.length() == 0)
    {
        dlgmessage_return("There are no other quests of this difficulty to reroll into right now.");
        return;
    }

    double cost = floor(questsConfig.reroll_base_cost * pow(questsConfig.reroll_multiplier, questRerollCount));
    if (questsConfig.reroll_target == "coins")           { coins -= cost; stat_coins_spent += cost; }
    else if (questsConfig.reroll_target == "cookies")    cookies -= cost;
    else if (questsConfig.reroll_target == "autocookie")
    {
        double before = autocookie;
        autocookie -= cost;
        scale_purchases_after_loss(1, before, autocookie);
    }
    else if (questsConfig.reroll_target == "manulcookie")
    {
        double before = manulcookie;
        manulcookie -= cost;
        scale_purchases_after_loss(2, before, manulcookie);
    }
    else if (questsConfig.reroll_target == "cookiespeed") { cookiespeed -= cost; clicktime += cost; }
    questRerollCount++;
    stat_rerolls_performed++;

    string oldQuestName = activeQuests[questIndex].name;
    int idx = random(0, candidates.length() - 1);
    activeQuests[questIndex] = candidates[idx];
    /* The new quest is a fresh copy from the table, so fill its %threshold% and move an endless quest to its
    current goal. Only this one is escalated, since the others already were and escalating is not repeatable. */
    escalate_quest(activeQuests[questIndex]);
    // A quest rerolled in already finished does not pay, or rerolling could buy rewards.
    if (quest_is_complete(activeQuests[questIndex])) questsRewarded.set(activeQuests[questIndex].id, true);
    reroll_history_entry rentry;
    rentry.old_name = oldQuestName;
    rentry.new_name = activeQuests[questIndex].name;
    rentry.cost = cost;
    rentry.target = questsConfig.reroll_target;
    rerollHistory.insert_last(rentry);
    if (int(rerollHistory.length()) > rerollHistoryMax)
        rerollHistory.remove_at(0);

    string costStr = (questsConfig.reroll_target == "coins") ? convert_to_currency(cost) : format_number(cost);
    dictionary@ tokens = dictionary();
    tokens.set("cost", costStr);
    string msg = format_template(questsConfig.reroll_message, tokens);
    if (questsConfig.reroll_sound != "")
        spool.play_stationary("sounds/misc/" + questsConfig.reroll_sound, false);
    dlgmessage_return(msg);
}

bool any_quest_complete()
{
    for (uint i = 0; i < activeQuests.length(); i++)
    {
        if (quest_stat_progress(activeQuests[i].stat) >= activeQuests[i].threshold) return true;
    }
    return false;
}

bool all_quests_complete()
{
    for (uint i = 0; i < activeQuests.length(); i++)
    {
        if (quest_stat_progress(activeQuests[i].stat) < activeQuests[i].threshold) return false;
    }
    return true;
}

bool quests_reward_earned()
{
    if (questsConfig.require_all == 1) return false;
    if (questsConfig.require_all == 2) return any_quest_complete();
    if (questsConfig.require_all == 3) return all_quests_complete();
    return false;
}

bool is_coin_stat(string stat)
{
    return stat == STAT_COINS_EARNED || stat == STAT_COINS_SPENT;
}

string format_quest_value(string stat, double val)
{
    if (is_coin_stat(stat)) return convert_to_currency(val);
    return format_number(val);
}

string get_quest_progress(quest_item@ item)
{
    double current = quest_stat_progress(item.stat);
    if (item.use_percent)
    {
        double pct = (item.threshold > 0) ? (current / item.threshold) * 100.0 : 100.0;
        if (pct > 100.0) pct = 100.0;
        return format_number(pct) + "%";
    }
    if (current > item.threshold) current = item.threshold;
    return format_quest_value(item.stat, current) + " of " + format_quest_value(item.stat, item.threshold);
}

string get_stat_display_name(string stat)
{
    if (stat == STAT_COOKIES_BAKED)          return "cookies baked";
    else if (stat == STAT_COINS_EARNED)      return "money earned";
    else if (stat == STAT_SINGLES_PURCHASED) return "upgrades purchased";
    else if (stat == STAT_BUNDLES_PURCHASED) return "bundles purchased";
    else if (stat == STAT_BAKER_EVENTS_FIRED)   return "baker events fired";
    else if (stat == STAT_FLIPPER_EVENTS_FIRED) return "flipper events fired";
    else if (stat == STAT_FLIPPER_FLIPS)     return "cookie flipper flips";
    else if (stat == STAT_COOKY_FLIPS)       return "cookie flips";
    else if (stat == STAT_PENNY_FLIPS)       return "penny flips";
    else if (stat == STAT_DICE_ROLLS)        return "dice rolls";
    else if (stat == STAT_DICE_WINS)         return "dice wins";
    else if (stat == STAT_SLOT_SPINS)        return "slot machine spins";
    else if (stat == STAT_SLOT_WINS)         return "slot machine wins";
    else if (stat == STAT_BLACKJACK_HANDS)   return "blackjack hands played";
    else if (stat == STAT_BLACKJACK_WINS)    return "blackjack wins";
    else if (stat == STAT_LOTTERY_TICKETS_BOUGHT)    return "lottery tickets bought";
    else if (stat == STAT_LOTTERY_TICKETS_SCRATCHED) return "lottery tickets scratched";
    else if (stat == STAT_LOTTERY_WINS)              return "lottery wins";
    else if (stat == STAT_DON_GAMES)                 return "double or nothing games";
    else if (stat == STAT_DON_WINS)                  return "double or nothing wins";
    else if (stat == STAT_DON_CORRECT_CALLS)         return "double or nothing correct calls";
    else if (stat == STAT_DON_SUIT_HITS)             return "double or nothing suit hits";
    else if (stat == STAT_DON_HIGHEST_RIDE)          return "double or nothing highest ride";
    else if (stat == STAT_HIGHLOW_GAMES)             return "higher or lower games";
    else if (stat == STAT_HIGHLOW_WINS)              return "higher or lower wins";
    else if (stat == STAT_HIGHLOW_HIGHEST_STREAK)    return "higher or lower highest streak";
    else if (stat == STAT_ROULETTE_GAMES)            return "roulette spins";
    else if (stat == STAT_ROULETTE_WINS)             return "roulette wins";
    else if (stat == STAT_ROULETTE_LOSSES)           return "roulette losses";
    else if (stat == STAT_ROULETTE_STRAIGHT_HITS)    return "roulette straight hits";
    else if (stat == STAT_ROULETTE_BREAKS)           return "roulette break-evens";
    else if (stat == STAT_AUTO_SLOTS_PURCHASED) return "auto slots purchased";
    else if (stat == STAT_BOOSTS_BOUGHT) return "boosts bought";
    else if (stat == STAT_BOOSTS_ACTIVATED) return "boosts activated";
    else if (stat == STAT_BOOST_SLOTS_PURCHASED) return "boost slots purchased";
    else if (stat == STAT_BOOSTS_COMPLETED) return "boosts completed";
    else if (stat == STAT_BOOST_MINUTES) return "minutes of boosts used";
    else if (stat == STAT_AUTO_SLOTS_ENABLED)   return "auto slots enabled";
    else if (stat == STAT_RANK)                    return "rank";
    else if (stat == STAT_HIGHEST_COMBO_REACHED)   return "highest combo reached";
    else if (stat == STAT_COMBOS_STARTED)          return "combos started";
    else if (stat == STAT_COMBOS_BROKEN)           return "combos broken";
    return stat;
}

string get_quest_detail(quest_item@ item)
{
    double current = quest_stat_progress(item.stat);
    bool complete = current >= item.threshold;
    double pct = (item.threshold > 0) ? (current / item.threshold) * 100.0 : 100.0;
    if (pct > 100.0) pct = 100.0;
    double capped = current > item.threshold ? item.threshold : current;
    dictionary@ tokens = dictionary();
    tokens.set("threshold", format_quest_value(item.stat, item.threshold));
    tokens.set("stat", get_stat_display_name(item.stat));
    tokens.set("progress", format_quest_value(item.stat, capped));
    tokens.set("percent", format_number(pct) + "%");
    string desc = format_template(item.description, tokens);
    desc += "\r\nCurrent progress: " + (complete ? "Complete. " : "") + get_quest_progress(item);
    return desc;
}
